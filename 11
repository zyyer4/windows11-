-- Attach Tab methods after the Window class is built.
local TabMeta = {}
TabMeta.__index = TabMeta

function TabMeta:AddSection(title)
    return Win11UI._newSection(self.Window, self, title)
end

function TabMeta:SetDescription(description)
    self.Description = description
    if self.Window.ActiveTab == self then
        self.Window.PageSubtitle.Text = description or ""
    end
end

function TabMeta:Select()
    self.Window:SelectTab(self)
end

-- Wrap the original AddTab so returned tabs expose the Tab API.
local originalAddTab = Win11UI.AddTab
Win11UI.AddTab = function(self, config)
    local tab = originalAddTab(self, config)
    return setmetatable(tab, TabMeta)
end

-- Fix section constructor to use the Window implementation cleanly.
local originalNewSection = Win11UI._newSection
Win11UI._newSection = function(window, tab, title)
    return originalNewSection(window, tab, title)
end

-- Search behavior.
local oldCreateWindow = Win11UI.CreateWindow
Win11UI.CreateWindow = function(self, config)
    local window = oldCreateWindow(self, config)

    window.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        window:_filterTabs(window.SearchBox.Text)
    end)

    -- Small entrance animation: the window starts compact and grows into place.
    local finalSize = window.Root.Size
    window.Root.Size = UDim2.fromOffset(
        math.max(420, finalSize.X.Offset - 55),
        math.max(340, finalSize.Y.Offset - 40)
    )
    tween(window.Root, 0.28, {Size = finalSize})

    return window
end

return Win11UI
