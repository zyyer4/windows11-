end

function Win11UI:Notify(title, message, duration)
    self:_notify(title, message, duration)
end

function Win11UI:AddTab(config)
    config = config or {}

    local tab = {
        Window = self,
        Title = config.Title or ("Tab " .. tostring(#self.Tabs + 1)),
        Icon = config.Icon or "•",
        Sections = {},
    }

    local button = Instance.new("TextButton")
    button.Name = "Tab_" .. tab.Title
    button.BackgroundColor3 = Theme.Surface
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Size = UDim2.new(1, 0, 0, 44)
    button.Text = ""
    button.Parent = self.TabList
    corner(button, 10)

    local icon = textLabel(button, tab.Icon, 17, Theme.SubText, Enum.Font.GothamBold)
    icon.Position = UDim2.fromOffset(12, 7)
    icon.Size = UDim2.fromOffset(30, 30)
    icon.TextXAlignment = Enum.TextXAlignment.Center

    local label = textLabel(button, tab.Title, 13, Theme.SubText, Enum.Font.GothamMedium)
    label.Position = UDim2.fromOffset(48, 0)
    label.Size = UDim2.new(1, -58, 1, 0)

    local selectedBar = Instance.new("Frame")
    selectedBar.BackgroundColor3 = Theme.Accent
    selectedBar.BorderSizePixel = 0
    selectedBar.Position = UDim2.fromOffset(3, 8)
    selectedBar.Size = UDim2.fromOffset(3, 28)
    selectedBar.Visible = false
    selectedBar.Parent = button
    corner(selectedBar, 2)

    local page = Instance.new("ScrollingFrame")
    page.Name = "Page_" .. tab.Title
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Size = UDim2.new(1, 0, 1, 0)
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Theme.Border
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = self.Pages

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 12)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    padding(page, 18, 5, 18, 20)

    tab.Button = button
    tab.Page = page
    tab.Layout = layout
    tab.Label = label
    tab.IconLabel = icon
    tab.SelectedBar = selectedBar

    local function select()
        self:SelectTab(tab)
    end

    button.MouseButton1Click:Connect(select)
    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {BackgroundTransparency = 0.55})
        end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {BackgroundTransparency = 1})
        end
    end)

    table.insert(self.Tabs, tab)

    if #self.Tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function Win11UI:SelectTab(tab)
    if not tab then return end

    for _, other in ipairs(self.Tabs) do
        local selected = other == tab
        other.Page.Visible = selected
        other.SelectedBar.Visible = selected

        if selected then
            tween(other.Button, 0.16, {
                BackgroundTransparency = 0.15,
                BackgroundColor3 = Theme.SurfaceSelected
            })
            tween(other.Label, 0.16, {TextColor3 = Theme.Text})
            tween(other.IconLabel, 0.16, {TextColor3 = Theme.Text})
        else
            tween(other.Button, 0.16, {
                BackgroundTransparency = 1,
                BackgroundColor3 = Theme.Surface
            })
            tween(other.Label, 0.16, {TextColor3 = Theme.SubText})
            tween(other.IconLabel, 0.16, {TextColor3 = Theme.SubText})
        end
    end

    self.ActiveTab = tab
    self.PageTitle.Text = tab.Title

    if tab.Description then
        self.PageSubtitle.Text = tab.Description
    else
        self.PageSubtitle.Text = "Configure your settings below."
    end
end

function Win11UI:AddSeparator()
    local separator = Instance.new("Frame")
    separator.BackgroundColor3 = Theme.Border
    separator.BackgroundTransparency = 0.55
    separator.BorderSizePixel = 0
    separator.Size = UDim2.new(1, 0, 0, 1)
    separator.Parent = self.TabList
    return separator
end

function Win11UI:_filterTabs(query)
    query = string.lower(query or "")

    for _, tab in ipairs(self.Tabs) do
        local match = query == "" or string.find(string.lower(tab.Title), query, 1, true)
        tab.Button.Visible = match
    end
end

function Win11UI:Destroy()
    if self.Gui then
        self.Gui:Destroy()
    end
end

