    button.MouseLeave:Connect(function()
        tween(button, 0.12, {BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = 0.35})
    end)
    button.MouseButton1Click:Connect(function()
        if callback then
            task.spawn(callback)
        end
    end)

    return {
        Row = row,
        Button = button,
        SetText = function(_, value) button.Text = tostring(value) end,
