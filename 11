    self.OpenButton = openButton

    local root = Instance.new("Frame")
    root.Name = "Window"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = self._normalPosition
    root.Size = self._normalSize
    root.BackgroundColor3 = Theme.Window
