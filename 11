    local function trafficButton(x, color, glyph)
        local b = Instance.new("TextButton")
        b.BackgroundColor3 = color
        b.Position = UDim2.fromOffset(x, 0)
        b.Size = UDim2.fromOffset(30, 30)
        b.Text = glyph
        b.TextSize = 13
        b.TextColor3 = Color3.fromRGB(25, 25, 25)
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        b.Parent = traffic
        corner(b, 15)
        return b
    end

    local close = trafficButton(0, Theme.Red, "×")
    local minimize = trafficButton(34, Theme.Yellow, "−")
    local maximize = trafficButton(68, Theme.Green, "□")

    close.MouseButton1Click:Connect(function()
        gui.Enabled = false
    end)

    minimize.MouseButton1Click:Connect(function()
        if self.Minimized then return end
        self.Minimized = true
        tween(root, 0.22, {Size = UDim2.fromOffset(self._normalSize.X.Offset, 76)})
        task.delay(0.22, function()
            if self.Minimized then
                root.Visible = false
                openButton.Visible = true
            end
        end)
    end)

    maximize.MouseButton1Click:Connect(function()
        if self.Maximized then
            self.Maximized = false
            tween(root, 0.25, {
                Size = self._normalSize,
                Position = self._normalPosition
            })
        else
            self.Maximized = true
            tween(root, 0.25, {
                Size = UDim2.new(1, -40, 1, -40),
                Position = UDim2.fromScale(0.5, 0.5)
            })
        end
    end)

    openButton.MouseButton1Click:Connect(function()
        openButton.Visible = false
        root.Visible = true
        self.Minimized = false
        root.Size = UDim2.fromOffset(self._normalSize.X.Offset, 76)
        tween(root, 0.25, {Size = self._normalSize})
