function Win11UI._SectionMethods:AddDropdown(text, options, default, callback)
    options = options or {}
    local value = default
    local open = false

    local row = self:_baseRow(56)

    local name = textLabel(row, text, 13, Theme.Text, Enum.Font.GothamMedium)
    name.Position = UDim2.fromOffset(14, 0)
    name.Size = UDim2.new(0.42, -10, 1, 0)

    local drop = Instance.new("TextButton")
    drop.BackgroundColor3 = Theme.Window
    drop.BackgroundTransparency = 0.12
    drop.BorderSizePixel = 0
    drop.Position = UDim2.new(0.42, 0, 0, 9)
    drop.Size = UDim2.new(0.58, -10, 0, 38)
    drop.Text = tostring(value or "Select")
    drop.TextColor3 = Theme.Text
    drop.TextSize = 12
    drop.Font = Enum.Font.Gotham
    drop.TextXAlignment = Enum.TextXAlignment.Left
    drop.AutoButtonColor = false
    drop.Parent = row
    corner(drop, 8)
    stroke(drop, Theme.Border, 0.5)
    padding(drop, 10, 0, 28, 0)

    local arrow = textLabel(drop, "⌄", 16, Theme.SubText, Enum.Font.GothamBold)
    arrow.Position = UDim2.new(1, -28, 0, 0)
    arrow.Size = UDim2.fromOffset(22, 38)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local list = Instance.new("Frame")
    list.BackgroundColor3 = Theme.Surface
    list.BorderSizePixel = 0
    list.Visible = false
    list.ZIndex = 20
    list.Position = UDim2.new(0, 0, 1, 5)
    list.Size = UDim2.new(1, 0, 0, math.min(#options * 34 + 8, 180))
    list.Parent = drop
    corner(list, 9)
    stroke(list, Theme.Border, 0.25)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.Parent = list
    padding(list, 5, 5, 5, 5)

    local function close()
        open = false
        list.Visible = false
        arrow.Text = "⌄"
    end

    local function selectOption(option)
        value = option
        drop.Text = tostring(option)
        arrow.Parent = drop
        if callback then
            task.spawn(callback, option)
        end
        close()
    end

    for _, option in ipairs(options) do
        local opt = Instance.new("TextButton")
        opt.BackgroundColor3 = Theme.Surface
        opt.BackgroundTransparency = 1
        opt.BorderSizePixel = 0
        opt.Size = UDim2.new(1, 0, 0, 30)
        opt.Text = tostring(option)
        opt.TextColor3 = Theme.SubText
        opt.TextSize = 12
        opt.Font = Enum.Font.Gotham
        opt.TextXAlignment = Enum.TextXAlignment.Left
        opt.AutoButtonColor = false
        opt.ZIndex = 21
        opt.Parent = list
        corner(opt, 6)
        padding(opt, 8, 0, 5, 0)

        opt.MouseEnter:Connect(function()
            tween(opt, 0.1, {BackgroundTransparency = 0.25, BackgroundColor3 = Theme.SurfaceHover})
        end)
        opt.MouseLeave:Connect(function()
            tween(opt, 0.1, {BackgroundTransparency = 1})
        end)
        opt.MouseButton1Click:Connect(function()
            selectOption(option)
        end)
    end

    drop.MouseButton1Click:Connect(function()
        open = not open
        list.Visible = open
        arrow.Text = open and "⌃" or "⌄"
    end)

    return {
        Row = row,
        SetValue = function(_, newValue, fire)
            for _, option in ipairs(options) do
                if option == newValue then
                    value = option
                    drop.Text = tostring(option)
                    if fire ~= false and callback then
                        task.spawn(callback, option)
                    end
                    break
                end
            end
        end,
        GetValue = function() return value end,
    }
end

function Win11UI._SectionMethods:AddKeybind(text, defaultKey, callback)
    local current = defaultKey or Enum.KeyCode.RightShift
    local listening = false

    local row = self:_baseRow(54)

    local name = textLabel(row, text, 13, Theme.Text, Enum.Font.GothamMedium)
    name.Position = UDim2.fromOffset(14, 0)
    name.Size = UDim2.new(1, -130, 1, 0)

    local bind = Instance.new("TextButton")
    bind.BackgroundColor3 = Theme.Window
    bind.BackgroundTransparency = 0.1
    bind.BorderSizePixel = 0
    bind.Position = UDim2.new(1, -112, 0, 9)
    bind.Size = UDim2.fromOffset(98, 36)
    bind.Text = current.Name
    bind.TextColor3 = Theme.Text
    bind.TextSize = 11
    bind.Font = Enum.Font.GothamMedium
    bind.AutoButtonColor = false
    bind.Parent = row
    corner(bind, 8)
    stroke(bind, Theme.Border, 0.5)

    bind.MouseButton1Click:Connect(function()
        listening = true
        bind.Text = "Press key..."
    end)

    local connection
    connection = UserInputService.InputBegan:Connect(function(input, processed)
        if not listening or processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            current = input.KeyCode
            listening = false
            bind.Text = current.Name
            if callback then
                task.spawn(callback, current)
            end
        end
    end)

    return {
        Row = row,
        GetValue = function() return current end,
        SetValue = function(_, key)
            current = key
            bind.Text = key.Name
        end,
        Destroy = function()
            if connection then connection:Disconnect() end
            row:Destroy()
        end,
    }
end

function Win11UI._SectionMethods:AddColorPicker(text, default, callback)
    local color = default or Theme.Accent
    local row = self:_baseRow(54)

    local name = textLabel(row, text, 13, Theme.Text, Enum.Font.GothamMedium)
    name.Position = UDim2.fromOffset(14, 0)
    name.Size = UDim2.new(1, -90, 1, 0)

    local preview = Instance.new("TextButton")
    preview.BackgroundColor3 = color
    preview.BorderSizePixel = 0
    preview.Position = UDim2.new(1, -58, 0, 13)
    preview.Size = UDim2.fromOffset(44, 28)
    preview.Text = ""
    preview.AutoButtonColor = false
    preview.Parent = row
    corner(preview, 8)

    -- Compact RGB editor; deliberately simple and executor-friendly.
    local popup = Instance.new("Frame")
    popup.BackgroundColor3 = Theme.Surface
    popup.BorderSizePixel = 0
    popup.Visible = false
    popup.ZIndex = 30
    popup.Position = UDim2.new(1, -230, 1, 6)
    popup.Size = UDim2.fromOffset(220, 92)
    popup.Parent = row
    corner(popup, 10)
    stroke(popup, Theme.Border, 0.2)

    local r = Instance.new("TextBox")
    local g = Instance.new("TextBox")
    local b = Instance.new("TextBox")

    local boxes = {r, g, b}
    for i, box in ipairs(boxes) do
        box.BackgroundColor3 = Theme.Window
        box.BorderSizePixel = 0
        box.Position = UDim2.fromOffset(10 + (i - 1) * 68, 12)
        box.Size = UDim2.fromOffset(60, 32)
        box.TextColor3 = Theme.Text
        box.TextSize = 11
        box.Font = Enum.Font.Gotham
        box.Text = tostring(math.floor(color[i] * 255))
        box.ClearTextOnFocus = false
        box.ZIndex = 31
        box.Parent = popup
        corner(box, 7)
        stroke(box, Theme.Border, 0.55)
    end

    local apply = Instance.new("TextButton")
    apply.BackgroundColor3 = Theme.Accent
    apply.BorderSizePixel = 0
    apply.Position = UDim2.fromOffset(10, 52)
    apply.Size = UDim2.new(1, -20, 0, 28)
    apply.Text = "Apply"
    apply.TextColor3 = Theme.Text
    apply.TextSize = 11
    apply.Font = Enum.Font.GothamBold
    apply.ZIndex = 31
    apply.Parent = popup
    corner(apply, 7)

    preview.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
    end)

    apply.MouseButton1Click:Connect(function()
        color = Color3.fromRGB(
            math.clamp(tonumber(r.Text) or 0, 0, 255),
            math.clamp(tonumber(g.Text) or 0, 0, 255),
            math.clamp(tonumber(b.Text) or 0, 0, 255)
        )
        preview.BackgroundColor3 = color
        popup.Visible = false
        if callback then
            task.spawn(callback, color)
        end
    end)

    return {
        Row = row,
        SetValue = function(_, newColor, fire)
            color = newColor
            preview.BackgroundColor3 = color
            if fire ~= false and callback then
                task.spawn(callback, color)
            end
        end,
        GetValue = function() return color end,
    }
end

