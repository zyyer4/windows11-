    Win11UI v2
    Fluent-inspired Windows 11 Roblox UI library.

    Visual direction:
    - dark Windows 11 / Fluent-style shell
    - centered rounded window
    - title + subtitle header
    - traffic-light window controls
    - left navigation rail with search
    - translucent/glass-like cards
    - animated hover/selection states
    - collapsible sections
    - responsive scrolling content

    API:
        local Win11UI = loadstring(game:HttpGet("YOUR_URL"))()

        local Window = Win11UI:CreateWindow({
            Title = "Muscle Legends",
            Subtitle = "AstrarServices",
            Size = UDim2.fromOffset(980, 650),
        })

        local Farming = Window:AddTab({
            Title = "Farming",
            Icon = "⚒",
        })

        local Section = Farming:AddSection("Automation")

        Section:AddToggle("Auto Farm", false, function(value) end)
        Section:AddButton("Test", function() end)
        Section:AddSlider("Speed", 0, 100, 50, function(value) end)
        Section:AddDropdown("Mode", {"Normal", "Fast"}, "Normal", function(value) end)
        Section:AddInput("Player", "", function(value) end)
]]

