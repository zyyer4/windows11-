function Win11UI._SectionMethods:AddToggle(text, default, callback)
    local value = default == true
    local row = self:_baseRow(54)

    local name = textLabel(row, text, 13, Theme.Text, Enum.Font.GothamMedium)
    name.Position = UDim2.fromOffset(14, 0)
    name.Size = UDim2.new(1, -90, 1, 0)

    local track = Instance.new("TextButton")
    track.BackgroundColor3 = value and Theme.Accent or Theme.Muted
    track.BackgroundTransparency = value and 0 or 0.35
    track.BorderSizePixel = 0
    track.Position = UDim2.new(1, -64, 0, 13)
    track.Size = UDim2.fromOffset(46, 28)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row
    corner(track, 14)

    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    knob.BorderSizePixel = 0
    knob.Size = UDim2.fromOffset(22, 22)
    knob.Position = value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
    knob.Parent = track
    corner(knob, 11)

    local api = {}

    local function set(newValue, fire)
        value = newValue == true
        tween(track, 0.16, {
            BackgroundColor3 = value and Theme.Accent or Theme.Muted,
            BackgroundTransparency = value and 0 or 0.35
        })
        tween(knob, 0.16, {
            Position = value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
        })
        if fire and callback then
            task.spawn(callback, value)
        end
    end

    track.MouseButton1Click:Connect(function()
        set(not value, true)
    end)

    api.SetValue = function(_, newValue, fire)
        set(newValue, fire ~= false)
    end
    api.GetValue = function()
        return value
    end

    return api
end

function Win11UI._SectionMethods:AddSlider(text, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    default = math.clamp(tonumber(default) or min, min, max)

    local row = self:_baseRow(68)

    local name = textLabel(row, text, 13, Theme.Text, Enum.Font.GothamMedium)
    name.Position = UDim2.fromOffset(14, 7)
    name.Size = UDim2.new(1, -90, 0, 22)

    local valueLabel = textLabel(row, tostring(default), 12, Theme.SubText)
    valueLabel.Position = UDim2.new(1, -75, 0, 7)
    valueLabel.Size = UDim2.fromOffset(60, 22)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = Theme.Muted
    bar.BackgroundTransparency = 0.45
    bar.BorderSizePixel = 0
    bar.Position = UDim2.fromOffset(14, 43)
    bar.Size = UDim2.new(1, -28, 0, 6)
    bar.Parent = row
    corner(bar, 3)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new((default - min) / math.max(max - min, 1), 0, 1, 0)
    fill.Parent = bar
    corner(fill, 3)

    local dragging = false
    local value = default

    local function setFromX(x, fire)
        local ratio = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * ratio
        value = math.floor(value * 100 + 0.5) / 100
        valueLabel.Text = tostring(value)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        if fire and callback then
            task.spawn(callback, value)
        end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X, true)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X, true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Row = row,
        SetValue = function(_, newValue)
            newValue = math.clamp(tonumber(newValue) or min, min, max)
            setFromX(bar.AbsolutePosition.X + ((newValue - min) / math.max(max - min, 1)) * bar.AbsoluteSize.X, true)
        end,
        GetValue = function()
            return value
        end,
    }
end

