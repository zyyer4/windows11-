    icon.Font = Enum.Font.GothamSemibold
    icon.TextXAlignment = Enum.TextXAlignment.Center
    icon.TextYAlignment = Enum.TextYAlignment.Center
    icon.Position = UDim2.fromOffset(9, 8)
    icon.Size = UDim2.fromOffset(27, 27)
    icon.Parent = button
    corner(icon, 7)
    tab.Icon = icon

    local tabLabel = text(
        button,
        tab.Title,
        13,
        Theme.SubText,
        Enum.Font.GothamMedium
    )
    tabLabel.Position = UDim2.fromOffset(48, 0)
    tabLabel.Size = UDim2.new(1, -57, 1, 0)
    tabLabel.TextTruncate = Enum.TextTruncate.AtEnd
    tab.Label = tabLabel

    local selected = Instance.new("Frame")
    selected.Name = "SelectedBar"
    selected.BackgroundColor3 = tab.Accent
    selected.BorderSizePixel = 0
    selected.Position = UDim2.new(0, 0, 0.5, -12)
    selected.Size = UDim2.fromOffset(3, 24)
    selected.Visible = false
    selected.Parent = button
    corner(selected, 2)
    tab.SelectedBar = selected

    -- Empty page by design.
    local page = Instance.new("ScrollingFrame")
    page.Name = tab.Title .. "_Page"
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Size = UDim2.new(1, 0, 1, 0)
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Theme.Border
    page.Visible = false
    page.Parent = self.Pages
    tab.Page = page

    padding(page, 18, 10, 18, 18)

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 7)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page

    -- Lightweight Fluent-style compatibility controls.
    function tab:AddLabel(value)
        local label = text(page, value or "", 13, Theme.SubText, Enum.Font.GothamMedium)
        label.Size = UDim2.new(1, 0, 0, 30)
        label.TextWrapped = true
        return label
    end

    function tab:AddButton(labelText, callback)
        local button = Instance.new("TextButton")
        button.Name = tostring(labelText or "Button")
        button.Size = UDim2.new(1, 0, 0, 42)
        button.BackgroundColor3 = Theme.Surface
        button.BackgroundTransparency = 0.18
        button.BorderSizePixel = 0
        button.AutoButtonColor = false
        button.Text = tostring(labelText or "Button")
        button.TextColor3 = Theme.Text
        button.TextSize = 13
        button.Font = Enum.Font.GothamSemibold
        button.Parent = page
        corner(button, 10)
        stroke(button, Theme.Border, 0.68)
        button.MouseEnter:Connect(function() tween(button, 0.10, {BackgroundTransparency = 0.04}) end)
        button.MouseLeave:Connect(function() tween(button, 0.10, {BackgroundTransparency = 0.18}) end)
        button.MouseButton1Click:Connect(function()
            if callback then callback() end
        end)
        return button
    end

    function tab:AddSwitch(labelText, callback)
        local row = Instance.new("Frame")
        row.Name = tostring(labelText or "Switch")
        row.Size = UDim2.new(1, 0, 0, 44)
        row.BackgroundColor3 = Theme.Surface
        row.BackgroundTransparency = 0.18
        row.BorderSizePixel = 0
        row.Parent = page
        corner(row, 10)
        stroke(row, Theme.Border, 0.68)

        local label = text(row, tostring(labelText or "Switch"), 13, Theme.Text, Enum.Font.GothamMedium)
        label.Position = UDim2.fromOffset(13, 0)
        label.Size = UDim2.new(1, -75, 1, 0)

        local toggle = Instance.new("TextButton")
        toggle.Size = UDim2.fromOffset(48, 24)
        toggle.Position = UDim2.new(1, -60, 0.5, -12)
        toggle.BackgroundColor3 = Theme.Muted
        toggle.BorderSizePixel = 0
        toggle.AutoButtonColor = false
        toggle.Text = "OFF"
        toggle.TextColor3 = Theme.Text
        toggle.TextSize = 10
        toggle.Font = Enum.Font.GothamBold
        toggle.Parent = row
        corner(toggle, 12)

        local state = false
        local switch = {}
        local function apply(newState, fire)
            state = newState and true or false
            toggle.Text = state and "ON" or "OFF"
            toggle.BackgroundColor3 = state and Theme.Green or Theme.Muted
            if fire and callback then callback(state) end
        end

        function switch:Set(newState)
            apply(newState, true)
        end

        function switch:Get() return state end
        switch.Button = toggle
        switch.Frame = row
        toggle.MouseButton1Click:Connect(function() apply(not state, true) end)
        return switch
    end

    function tab:AddTextBox(labelText, callback, options)
        local box = Instance.new("TextBox")
        box.Name = tostring(labelText or "TextBox")
        box.Size = UDim2.new(1, 0, 0, 52)
        box.BackgroundColor3 = Theme.Surface
        box.BackgroundTransparency = 0.18
        box.BorderSizePixel = 0
        box.ClearTextOnFocus = false
        box.Text = ""
        box.PlaceholderText = (options and options.placeholder) or ""
        box.PlaceholderColor3 = Theme.Muted
        box.TextColor3 = Theme.Text
        box.TextSize = 13
        box.Font = Enum.Font.Gotham
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.Parent = page
        corner(box, 10)
        stroke(box, Theme.Border, 0.68)
        padding(box, 13, 0, 13, 0)
        box.FocusLost:Connect(function()
            if callback then callback(box.Text) end
        end)
        return box
    end

    function tab:Show()
        self.Window:SelectTab(self)
    end

    -- Fluent-style foundation for future content.
    function tab:AddSection(titleValue)
        local section = {
            Tab = tab,
            Window = self,
        }

        local card = Instance.new("Frame")
        card.Name = "Section"
        card.BackgroundColor3 = Theme.Surface
        card.BackgroundTransparency = 0.34
        card.BorderSizePixel = 0
        card.Size = UDim2.new(1, 0, 0, 70)
        card.Parent = page
        corner(card, 11)
        stroke(card, Theme.Border, 0.70)

        local heading = text(
            card,
            titleValue or "Section",
            14,
            Theme.Text,
            Enum.Font.GothamSemibold
        )
        heading.Position = UDim2.fromOffset(14, 9)
        heading.Size = UDim2.new(1, -28, 0, 23)

        section.Frame = card
        section.Title = heading

        return section
    end

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {
                BackgroundTransparency = 0.72,
            })
        end
    end)

    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {
                BackgroundTransparency = 1,
            })
        end
    end)

    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function UI:SelectTab(tab)
    if not tab then return end

    self.ActiveTab = tab

    for _, item in ipairs(self.Tabs) do
        local active = item == tab

        item.Page.Visible = active
        item.SelectedBar.Visible = active

        if active then
            tween(item.Button, 0.14, {
                BackgroundTransparency = 0.14,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.Text,
            })
        else
            tween(item.Button, 0.14, {
                BackgroundTransparency = 1,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.SubText,
            })
        end
    end

    self.PageTitle.Text = tab.Title
    self.PageSubtitle.Text =
        tab.Description ~= "" and tab.Description
        or "Build this page using the Fluent-style API."
end

function UI:SetTitle(titleValue, subtitleValue)
    if titleValue then
        self.TitleLabel.Text = titleValue
    end
    if subtitleValue then
        self.SubtitleLabel.Text = subtitleValue
    end
end

function UI:Destroy()
    if self._inputConnection then
        self._inputConnection:Disconnect()
        self._inputConnection = nil
    end

    if self.Gui then
        self.Gui:Destroy()
    end
end


