local function compactAdminNumber(value)
    local n = tonumber(value)
    if not n then return tostring(value or "-") end
    local suffixes = {{1e18,"Qi"},{1e15,"Qa"},{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}
    local a = math.abs(n)
    for _, item in ipairs(suffixes) do
        if a >= item[1] then
            local v = string.format("%.2f", n / item[1]):gsub("(%..-)0+$", "%1"):gsub("%.$", "")
            return v .. item[2]
        end
    end
    return tostring(math.floor(n) == n and math.floor(n) or n)
end

local function stringifyAdminStats(stats)
    if type(stats) ~= "table" then return "No public stats supplied" end
    local parts = {}
    local preferred = {"Strength", "Durability", "Rebirths"}
    local used = {}
    for _, key in ipairs(preferred) do
        if stats[key] ~= nil then
            table.insert(parts, key .. ": " .. compactAdminNumber(stats[key]))
            used[key] = true
        end
    end
    local others = {}
    for key, value in pairs(stats) do
        if not used[key] and string.lower(tostring(key)) ~= "durability" then
            table.insert(others, tostring(key) .. ": " .. compactAdminNumber(value))
        end
    end
    table.sort(others)
    for _, item in ipairs(others) do table.insert(parts, item) end
    return #parts > 0 and table.concat(parts, "  •  ") or "No public stats supplied"
end

local function adminMatches(record, query)
    if query == "" then return true end
    local haystack = table.concat({
        tostring(record.Username or ""),
        tostring(record.DisplayName or ""),
        tostring(record.UserId or ""),
        tostring(record.Game or ""),
        tostring(record.PlaceId or ""),
        tostring(record.Server or ""),
        tostring(record.JobId or ""),
        tostring(record.Version or "")
    }, " "):lower()
    return string.find(haystack, query:lower(), 1, true) ~= nil
end

local function renderAdminExecutions()
    if not adminUnlocked or not adminResultsLabel then return end
    local lines = {}
    local count = 0
    for _, record in ipairs(adminExecutions) do
        if adminMatches(record, adminSearch) then
