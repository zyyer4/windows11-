	ui:_addSyncer(function()
		for name, c in pairs(cards) do
			local selected = name == ui.settings.theme
			c.ring.Color = selected and ui.theme.accent or rgb(150, 150, 160)
			c.ring.Thickness = selected and 2 or 1
			c.ring.Transparency = selected and 0 or 0.7
			c.check.Visible = selected
