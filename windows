-- A row with a toggle switch. Returns (row, state).
--   opts.key      -> saved/loaded with the rest of the settings (use a unique string)
--   opts.onChange -> called with the new value (also called when a saved value is loaded)
--   state.on, state:Set(on, fire)
function Panel:AddToggleRow(opts)
	local ui = self._ui
	self._rowCount += 1
	local key = opts.key

	local initial = opts.on == true
	local needsFire = false
	if key then
		local saved = ui.settings.toggles[key]
		if saved ~= nil then
			needsFire = saved ~= initial
			initial = saved
		else
			ui.settings.toggles[key] = initial
		end
	end

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = self._rowCount,
	})

	local label = new("TextLabel", {
		Text = opts.label or "",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -46, 1, 0),
		BackgroundTransparency = 1,
	})
	ui:_bind(label, "TextColor3", "textDim")
	label.Parent = row

	local track = new("TextButton", {
		Text = "",
		Size = UDim2.fromOffset(38, 22),
		Position = UDim2.new(1, -38, 0.5, -11),
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, { corner(11) })
	local trackGradient = new("UIGradient", { Rotation = 135 })
	trackGradient.Parent = track

	local function knobPos(on)
		return on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
	end
	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = knobPos(initial),
		BackgroundColor3 = COLOR.white,
		BorderSizePixel = 0,
	}, { corner(9) })
	knob.Parent = track

	local state = { on = initial }

	local function paint(animate)
		local theme = ui.theme
		trackGradient.Color = ColorSequence.new(lighten(theme.accent, 0.25), darken(theme.accent, 0.1))
		trackGradient.Enabled = state.on
		local props = {
			BackgroundColor3 = state.on and COLOR.white or theme.surface,
			BackgroundTransparency = state.on and 0 or 0.85,
		}
		if animate then
			tween(track, props, 0.15)
		else
			track.BackgroundColor3 = props.BackgroundColor3
			track.BackgroundTransparency = props.BackgroundTransparency
		end
	end
	ui:_themed(function(_, animate)
		paint(animate)
	end)

	function state:Set(on, fire)
		on = on == true
		if key then
			ui.settings.toggles[key] = on
		end
		if on == self.on then
			return
		end
		self.on = on
		paint(true)
		-- little squash-and-stretch pulse on the knob as it slides
		tween(knob, { Size = UDim2.fromOffset(22, 18) }, 0.08)
		task.delay(0.08, function()
			tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.12, Enum.EasingStyle.Back)
		end)
		tween(knob, { Position = knobPos(on) }, 0.2, Enum.EasingStyle.Back)
		if fire then
			if opts.onChange then
				opts.onChange(on)
			end
			ui:_changed()
		end
	end

	track.MouseButton1Click:Connect(function()
		state:Set(not state.on, true)
	end)

	if key then
		ui._toggleStates[key] = state
	end
	if needsFire and opts.onChange then
		task.defer(opts.onChange, initial) -- a saved value differs from the default: tell your game logic
	end

	track.Parent = row
	row.Parent = self.body
	return row, state
end

-- A slider row. opts: label, min, max, step, value, format(v) -> string, onChange(v)
-- Returns (row, state) with state:Get() / state:Set(v, fire).
function Panel:AddSliderRow(opts)
	local ui = self._ui
	local page = self._page
	self._rowCount += 1
	local min = opts.min or 0
	local max = opts.max or 1
	local step = opts.step or 0
	local fmt = opts.format or tostring

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		LayoutOrder = self._rowCount,
	})

	local label = new("TextLabel", {
		Text = opts.label or "",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.6, 0, 0, 24),
		BackgroundTransparency = 1,
	})
	ui:_bind(label, "TextColor3", "textDim")
	label.Parent = row

	local valueLabel = new("TextLabel", {
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.4, 0, 0, 24),
		Position = UDim2.new(0.6, 0, 0, 0),
		BackgroundTransparency = 1,
	})
	ui:_bind(valueLabel, "TextColor3", "text")
	valueLabel.Parent = row

	-- invisible, taller hit area so the thin track is easy to grab
	local hit = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 0, 24),
	})
	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
	}, { corner(3) })
	ui:_bind(track, "BackgroundColor3", "surface")
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}, { corner(3) })
	ui:_bind(fill, "BackgroundColor3", "accent")
	fill.Parent = track
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = COLOR.white,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, { corner(7) })
	knob.Parent = track
	track.Parent = hit
	hit.Parent = row

	local value = clamp(opts.value or min, min, max)
	local state = {}

	local function render()
		local frac = max > min and (value - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(frac, 1)
		knob.Position = UDim2.new(frac, -7, 0.5, -7)
		valueLabel.Text = fmt(value)
	end

	function state:Get()
		return value
	end
	function state:Set(v, fire)
		v = clamp(v, min, max)
		if step > 0 then
			v = min + math.floor((v - min) / step + 0.5) * step
		end
		v = tonumber(string.format("%.4f", clamp(v, min, max)))
		local changed = v ~= value
		value = v
		render()
		if fire and changed and opts.onChange then
			opts.onChange(v)
		end
	end
	render()

	local dragging = false
	local function setFromX(x)
		local width = hit.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local frac = clamp((x - hit.AbsolutePosition.X) / width, 0, 1)
		state:Set(min + frac * (max - min), true)
	end
	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			page.content.ScrollingEnabled = false -- so touch-dragging doesn't scroll the page
			setFromX(input.Position.X)
		end
	end)
	table.insert(ui._conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(ui._conns, UserInputService.InputEnded:Connect(function(input)
		if dragging and isPress(input) then
			dragging = false
			page.content.ScrollingEnabled = true
		end
	end))

	row.Parent = self.body
	return row, state
end

