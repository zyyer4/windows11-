        b.Name = name
        b.Text = ""
        b.AutoButtonColor = false
        b.BackgroundColor3 = color
        b.BorderSizePixel = 0
        b.Size = UDim2.fromOffset(14, 14)
        b.Parent = traffic
        corner(b, 7)
