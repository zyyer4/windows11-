            tostring(record.DisplayName or ""),
            tostring(record.UserId or ""),
            tostring(record.Game or ""),
            tostring(record.PlaceId or ""),
            tostring(record.Server or ""),
            tostring(record.JobId or ""),
            tostring(record.Version or ""),
        }, " "):lower()

        return string.find(haystack, query:lower(), 1, true) ~= nil
    end

