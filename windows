--========================================================--
-- FAST FARM TRACKING
--========================================================--

local fastRepRunning = false
local trackingStarted = false

local farmStartTime = 0
local farmPausedElapsed = 0

local strengthHistory = {}
local durabilityHistory = {}

local calculationInterval = 10

local initialStrength =
    strengthStat.Value

local initialDurability =
    durabilityStat.Value

task.spawn(function()

    local lastCalcTime = tick()

    while not _G.JohnnyScriptDestroyed do

        local currentTime = tick()

        local currentStrength =
            strengthStat.Value

        local currentDurability =
            durabilityStat.Value

        strengthLabel.Text =
            "Strength: " ..
            formatStatNumber(
                currentStrength
            ) ..
            " | Gained: " ..
            formatStatNumber(
                currentStrength -
                initialStrength
            )

        durabilityLabel.Text =
            "Durability: " ..
            formatStatNumber(
                currentDurability
            ) ..
            " | Gained: " ..
            formatStatNumber(
                currentDurability -
                initialDurability
            )

        if fastRepRunning then

            if not trackingStarted then

                trackingStarted = true

                farmStartTime =
                    currentTime

                strengthHistory = {}
                durabilityHistory = {}

            end

            local elapsed =
                farmPausedElapsed +
                (
                    currentTime -
                    farmStartTime
                )

            local days =
                math.floor(
                    elapsed / 86400
                )

            local hours =
                math.floor(
                    (elapsed % 86400) /
                    3600
                )

            local minutes =
                math.floor(
                    (elapsed % 3600) /
                    60
                )

            local seconds =
                math.floor(
                    elapsed % 60
                )

            stopwatchLabel.Text =
                string.format(
                    "%dd %dh %dm %ds - Fast Rep Running",
                    days,
                    hours,
                    minutes,
                    seconds
                )

            stopwatchLabel.TextColor3 =
                Color3.fromRGB(
                    50,
                    255,
                    50
                )

            table.insert(
                strengthHistory,
                {
                    time = currentTime,
                    value = currentStrength
                }
            )

            table.insert(
                durabilityHistory,
                {
                    time = currentTime,
                    value = currentDurability
                }
            )

            while
                #strengthHistory > 0
                and
                currentTime -
                strengthHistory[1].time >
                calculationInterval
            do

                table.remove(
                    strengthHistory,
                    1
                )
            end

            while
                #durabilityHistory > 0
                and
                currentTime -
                durabilityHistory[1].time >
                calculationInterval
            do

                table.remove(
                    durabilityHistory,
                    1
                )
            end

            if
                currentTime -
                lastCalcTime >=
                calculationInterval
            then

                lastCalcTime =
                    currentTime

                if #strengthHistory >= 2 then

                    local first =
                        strengthHistory[1]

                    local last =
                        strengthHistory[
                            #strengthHistory
                        ]

                    local delta =
                        last.value -
                        first.value

                    local secondsElapsed =
                        last.time -
                        first.time

                    if secondsElapsed > 0 then

                        local perSecond =
                            delta /
                            secondsElapsed

                        projectedStrengthLabel.Text =
                            string.format(
                                "Strength Pace: %s/Hour | %s/Day | %s/Week",
                                formatStatNumber(
                                    perSecond * 3600
                                ),
                                formatStatNumber(
                                    perSecond * 86400
                                ),
                                formatStatNumber(
                                    perSecond * 604800
                                )
                            )
                    end
                end

                if #durabilityHistory >= 2 then

                    local first =
                        durabilityHistory[1]

                    local last =
                        durabilityHistory[
                            #durabilityHistory
                        ]

                    local delta =
                        last.value -
                        first.value

                    local secondsElapsed =
                        last.time -
                        first.time

                    if secondsElapsed > 0 then

                        local perSecond =
                            delta /
                            secondsElapsed

                        projectedDurabilityLabel.Text =
                            string.format(
                                "Durability Pace: %s/Hour | %s/Day | %s/Week",
                                formatStatNumber(
                                    perSecond * 3600
                                ),
                                formatStatNumber(
                                    perSecond * 86400
                                ),
                                formatStatNumber(
                                    perSecond * 604800
                                )
                            )
                    end
                end

                local totalElapsed =
                    farmPausedElapsed +
                    (
                        currentTime -
                        farmStartTime
                    )

                if totalElapsed > 0 then

                    local strengthPerSecond =
                        (
                            currentStrength -
                            initialStrength
                        ) /
                        totalElapsed

                    local durabilityPerSecond =
                        (
                            currentDurability -
                            initialDurability
                        ) /
                        totalElapsed

                    averageStrengthLabel.Text =
                        string.format(
                            "Average Strength Pace: %s/Hour | %s/Day | %s/Week",
                            formatStatNumber(
                                strengthPerSecond * 3600
                            ),
                            formatStatNumber(
                                strengthPerSecond * 86400
                            ),
                            formatStatNumber(
                                strengthPerSecond * 604800
                            )
                        )

                    averageDurabilityLabel.Text =
                        string.format(
                            "Average Durability Pace: %s/Hour | %s/Day | %s/Week",
                            formatStatNumber(
                                durabilityPerSecond * 3600
                            ),
                            formatStatNumber(
                                durabilityPerSecond * 86400
                            ),
                            formatStatNumber(
                                durabilityPerSecond * 604800
                            )
                        )
                end
            end

        elseif trackingStarted then

            trackingStarted = false

            farmPausedElapsed +=
                currentTime -
                farmStartTime

            local elapsed =
                farmPausedElapsed

            stopwatchLabel.Text =
                string.format(
                    "%dd %dh %dm %ds - Fast Rep Stopped",
                    math.floor(
                        elapsed / 86400
                    ),
                    math.floor(
                        (elapsed % 86400) /
                        3600
                    ),
                    math.floor(
                        (elapsed % 3600) /
                        60
                    ),
                    math.floor(
                        elapsed % 60
                    )
                )

            stopwatchLabel.TextColor3 =
                Color3.fromRGB(
                    255,
                    165,
                    0
                )

            projectedStrengthLabel.Text =
                "Strength Pace: 0 /Hour | 0 /Day | 0 /Week"

            projectedDurabilityLabel.Text =
                "Durability Pace: 0 /Hour | 0 /Day | 0 /Week"

            averageStrengthLabel.Text =
                "Average Strength Pace: 0 /Hour | 0 /Day | 0 /Week"

            averageDurabilityLabel.Text =
                "Average Durability Pace: 0 /Hour | 0 /Day | 0 /Week"

            strengthHistory = {}
            durabilityHistory = {}
        end

        task.wait(0.05)
    end
end)

