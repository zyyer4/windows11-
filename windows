function UI:Minimize()
    if self.IsMinimized then return end

    self.IsMinimized = true
    self.SavedPosition = self.Root.Position
    self.SavedSize = self.Root.Size

    local root = self.Root
    local gui = self.Gui
    local rootScale = self.RootScale

    -- The shell physically transforms into the top-center pill instead of simply disappearing.
    root.Visible = true
    root.ZIndex = 20
    rootScale.Scale = 1

    local shrink = TweenService:Create(
        rootScale,
        TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
        {Scale = 0.085}
    )
    local move = TweenService:Create(
        root,
        TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
        {Position = UDim2.fromScale(0.5, 0.045)}
    )

    shrink:Play()
    move:Play()
    move.Completed:Wait()

    root.Visible = false

    if self.MinimizedButton then
        self.MinimizedButton:Destroy()
    end

    local open = Instance.new("TextButton")
    open.Name = "Open"
    open.AnchorPoint = Vector2.new(0.5, 0)
