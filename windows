local function hasMaxSpinsMessage()
    local playerGui = Player:FindFirstChildOfClass("PlayerGui")

    if not playerGui then
        return false
    end

    for _, object in ipairs(playerGui:GetDescendants()) do
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox")
        then
            local ok, value = pcall(function()
                return object.Text
            end)

            if ok
                and type(value) == "string"
                and value:lower():find("you have max spins", 1, true)
            then
                return true
            end
        end
    end

    return false
end

local function spinFortuneWheelOnce()
    print("[Johnny] Fortune Wheel: starting diagnostic spin")

    if hasMaxSpinsMessage() then
        print("[Johnny] Fortune Wheel: maximum spins reached; stopping.")
        return "MAX_SPINS"
    end

    local ok, result = pcall(function()

        local events =
            ReplicatedStorage:FindFirstChild("rEvents")

        if not describeInstance("rEvents", events) then
            return false, "rEvents was not found in ReplicatedStorage"
        end

        local remote =
            events:FindFirstChild("openFortuneWheelRemote")

        if not describeInstance(
            "openFortuneWheelRemote",
            remote
        ) then
            return false,
                "openFortuneWheelRemote was not found under rEvents"
        end

        if not remote:IsA("RemoteFunction") then
            return false,
                "openFortuneWheelRemote is "
                .. remote.ClassName
                .. ", not RemoteFunction"
        end

        local chances =
            ReplicatedStorage:FindFirstChild(
                "fortuneWheelChances"
            )

        if not describeInstance(
            "fortuneWheelChances",
            chances
        ) then
            return false,
                "fortuneWheelChances was not found in ReplicatedStorage"
        end

        local wheel =
            chances:FindFirstChild("Fortune Wheel")

        if not describeInstance(
            "Fortune Wheel",
            wheel
        ) then
            return false,
                "Fortune Wheel was not found under fortuneWheelChances"
        end

        print(
            "[Johnny] Fortune Wheel: invoking remote..."
        )

        local invokeOk, serverResult =
            pcall(function()
                return remote:InvokeServer(
                    "openFortuneWheel",
                    wheel
                )
            end)

        if not invokeOk then
            warn(
                "[Johnny] Fortune Wheel SERVER/REMOTE ERROR: "
                .. tostring(serverResult)
            )

            return false, serverResult
        end

        print(
            "[Johnny] Fortune Wheel: server returned:",
            serverResult
        )

        return true, serverResult
    end)

    if not ok then
        warn(
            "[Johnny] Fortune Wheel LOCAL ERROR: "
            .. tostring(result)
        )
        return false
    end

    if result == false then
        return false
    end

    task.wait(0.15)

    if hasMaxSpinsMessage() then
        print("[Johnny] Fortune Wheel: maximum spins reached; stopping.")
        return "MAX_SPINS"
    end

    return true
