	keys:AddRow({ label = "🟡 Minimize", value = "Title bar only" })
	keys:AddRow({ label = "🟢 Maximize", value = "Fill screen" })

	local function refresh()
		for _, fn in ipairs(updaters) do
			pcall(fn)
		end
	end
	refresh()
	task.spawn(function()
		while not self._destroyed do
			task.wait(1)
			if page.content.Visible and not self._hidden then
				refresh()
			end
		end
	end)

	return page
