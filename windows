local function collectPublicStats()
    local result = {}
    local player = Players.LocalPlayer
    local leaderstats = player and player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, value in ipairs(leaderstats:GetChildren()) do
            if value:IsA("ValueBase") then
                result[value.Name] = value.Value
            end
        end
    end

    -- Explicitly include Durability if the game exposes it outside leaderstats.
    if result.Durability == nil and player then
        local aliases = {"Durability", "durability", "Defense", "defense"}
        for _, alias in ipairs(aliases) do
            local attr = player:GetAttribute(alias)
            if attr ~= nil then
                result.Durability = attr
                break
            end
        end
    end

    if result.Durability == nil and player then
        local containers = {"Stats", "Data", "PlayerData"}
        for _, containerName in ipairs(containers) do
            local container = player:FindFirstChild(containerName)
            if container then
                for _, alias in ipairs(aliases) do
                    local value = container:FindFirstChild(alias)
                    if value and value:IsA("ValueBase") then
                        result.Durability = value.Value
                        break
                    end
                end
            end
            if result.Durability ~= nil then break end
        end
    end

    return result
end

