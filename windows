    local function makeRestoreCard()
        local card=themeCard("Restore",70,4)
        create("TextLabel",{Position=UDim2.new(0,16,0,11),Size=UDim2.new(.65,0,0,20),BackgroundTransparency=1,Text="Restore Empire default",TextColor3=COLORS.text,TextSize=13,Font=Enum.Font.GothamSemibold,TextXAlignment=Enum.TextXAlignment.Left},card)
        create("TextLabel",{Position=UDim2.new(0,16,0,33),Size=UDim2.new(.65,0,0,18),BackgroundTransparency=1,Text="Reset the window to the original blue glass palette.",TextColor3=COLORS.muted,TextSize=9,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},card)
        local b=create("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-16,.5,0),Size=UDim2.fromOffset(142,30),BackgroundColor3=Color3.fromRGB(28,42,68),Text="Restore Default",TextColor3=COLORS.text,TextSize=10,Font=Enum.Font.GothamSemibold,AutoButtonColor=false},card)
        corner(b,7); stroke(b,COLORS.line,.68,1); hoverScale(b,1.018)
        b.Activated:Connect(function()
            local cfg=findTheme("Modern")
            gradientRotation=115
            restyleWindow(cfg,gradientRotation)
            windowFrame.BackgroundTransparency=.24
            local windowCorner=windowFrame:FindFirstChildOfClass("UICorner")
            if windowCorner then windowCorner.CornerRadius=UDim.new(0,15) end
            b.Text="Restored ✓"
            task.delay(.9,function() if b.Parent then b.Text="Restore Default" end end)
        end)
    end

    -- Mark the existing UI surfaces once before applying the first theme.  The
    -- marking is intentionally conservative and never changes behavior.
    for _,obj in ipairs(windowFrame:GetDescendants()) do
        if obj:IsA("GuiObject") and obj:GetAttribute("EmpireThemeRole")==nil then
            local bg=obj.BackgroundColor3
            local role=nil
            if bg==COLORS.bg then role="bg"
            elseif bg==COLORS.sidebar then role="sidebar"
            elseif bg==COLORS.panel then role="panel"
            elseif bg==COLORS.panel2 then role="panel2"
            elseif bg==Color3.fromRGB(25,32,48) then role="nav"
            elseif bg==Color3.fromRGB(28,42,68) then role="button"
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if obj.TextColor3==COLORS.muted then role="mutedText"
                elseif obj.TextColor3==COLORS.text then role="text" end
            end
            if role then obj:SetAttribute("EmpireThemeRole",role) end
        end
    end

    makePresetCard()
    makeGradientCard()
    makeStyleCard()
    makeRestoreCard()

    -- The Theme page should start exactly like the normal Empire shell, but we
    -- still run the same safe path so its controls are immediately consistent.
    restyleWindow(themes[1],gradientRotation)
end

