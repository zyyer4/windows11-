--========================================================--
-- IMPORTANT:
-- Titanium Hydra is NEVER unequipped.
--
-- This allows the new 12-slot setup to keep
-- Titanium Hydra equipped while the script manages
-- Swift Samurai / Tribal Overlord.
--========================================================--

local function getUniquePetsFolder()

    local petsFolder =
        Player:FindFirstChild("petsFolder")

    if not petsFolder then
        return nil
    end

    return petsFolder:FindFirstChild("Unique")
end

local function isProtectedPet(pet)

    return pet
        and pet.Name ==
        "Titanium Hydra"
end

local function unequipAllExceptProtected()

    local petsFolder =
        Player:FindFirstChild("petsFolder")

    if not petsFolder then
        return
    end

    for _, folder in ipairs(
        petsFolder:GetChildren()
    ) do

        if folder:IsA("Folder") then

            for _, pet in ipairs(
                folder:GetChildren()
            ) do

                if not isProtectedPet(pet) then

                    pcall(function()
                        equipPetEvent:FireServer(
                            "unequipPet",
                            pet
                        )
                    end)

                end
            end
        end
    end
end

local function equipPetByName(petName)

    local uniquePets =
        getUniquePetsFolder()

    if not uniquePets then
        return
    end

    for _, pet in ipairs(
        uniquePets:GetChildren()
    ) do

        if pet.Name == petName then

            pcall(function()
                equipPetEvent:FireServer(
                    "equipPet",
                    pet
                )
            end)

        end
    end
end

local function managePets(petName)

    -- Titanium Hydra stays equipped.
    unequipAllExceptProtected()

    task.wait(0.05)

    -- Equip the requested pet.
    equipPetByName(petName)

end

--========================================================--
-- FAST REBIRTH LOGIC
--========================================================--

local function doFastRebirth()

    local currentRebirths =
        rebirthsStat.Value

    local strengthTarget =
        5000 +
        (currentRebirths * 2550)

    while
        isFastRebirthRunning
        and
        strengthStat.Value <
        strengthTarget
    do

        local reps

        if Player.MembershipType ==
            Enum.MembershipType.Premium then

            reps = 8

        else

            reps = 14

        end

        for _ = 1, reps do

            if not isFastRebirthRunning then
                break
            end

            pcall(function()
                muscleEvent:FireServer("rep")
            end)

        end

        task.wait(0.01)
    end

    if
        isFastRebirthRunning
        and
        strengthStat.Value >=
        strengthTarget
    then

        -- Keep Titanium Hydra equipped.
        managePets("Tribal Overlord")

        task.wait(0.1)

        local before =
            rebirthsStat.Value

        repeat

            pcall(function()
                rebirthRemote:InvokeServer(
                    "rebirthRequest"
                )
            end)

            task.wait(0.05)

        until
            rebirthsStat.Value > before
            or
            not isFastRebirthRunning
    end
end

fastRebirthLoop = function()

    while isFastRebirthRunning do

        -- Titanium Hydra remains equipped.
        -- Swift Samurai is managed normally.
        managePets("Swift Samurai")

        doFastRebirth()

        task.wait(0.05)
    end

end

