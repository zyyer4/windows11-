    local function compactNumber(value)
        local n = tonumber(value)
        if not n then
            return tostring(value or "-")
        end

        local abs = math.abs(n)
        local suffixes = {
            {1e18, "Qi"},
            {1e15, "Qa"},
            {1e12, "T"},
            {1e9, "B"},
            {1e6, "M"},
            {1e3, "K"},
        }

        for _, item in ipairs(suffixes) do
            if abs >= item[1] then
                local v = n / item[1]
                local textValue = string.format("%.2f", v)
                    :gsub("(%..-)0+$", "%1")
                    :gsub("%.$", "")
                return textValue .. item[2]
            end
        end

        return tostring(math.floor(n) == n and math.floor(n) or n)
    end

    local function stringifyStats(stats)
        if type(stats) ~= "table" then
            return "No public stats supplied"
        end

        local parts = {}
        local preferred = {"Strength", "Durability", "Rebirths"}
        local used = {}

        for _, key in ipairs(preferred) do
            if stats[key] ~= nil then
                table.insert(parts, key .. ": " .. compactNumber(stats[key]))
                used[key] = true
            end
        end

        local others = {}
        for key, value in pairs(stats) do
            if not used[key] and string.lower(tostring(key)) ~= "durability" then
                table.insert(others, tostring(key) .. ": " .. compactNumber(value))
            end
        end
        table.sort(others)

        for _, item in ipairs(others) do
            table.insert(parts, item)
        end

        return #parts > 0 and table.concat(parts, "  •  ") or "No public stats supplied"
    end

    local function matches(record, query)
        if query == "" then
