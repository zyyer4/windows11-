    open.Parent = gui
    corner(open, 18)
    stroke(open, Color3.fromRGB(110, 255, 135), 0.18, 1)
    addGradient(open, Color3.fromRGB(28, 32, 38), Color3.fromRGB(2, 4, 6), 90)
    self.MinimizedButton = open
    makeDraggable(open, open)

