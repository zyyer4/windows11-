local pingAdjusterEnabled = true

local pausePing = 250
local resumePing = 200
local pauseDuration = 1

local pingPaused = false
local lastKnownPing = 0

local pingStatusLabel =
    FarmingTab:AddLabel(
        "Ping: -- ms | Status: Ready"
    )

pingStatusLabel.TextSize = 16

local function readPingStat(stat)

    if not stat then
        return nil
    end

    local ok, value =
        pcall(function()
            return stat:GetValue()
        end)

    if ok
        and type(value) == "number"
        and value >= 0
    then

        return value
    end

    local okString, valueString =
        pcall(function()
            return stat:GetValueString()
        end)

    if okString
        and type(valueString) ==
        "string"
    then

        local number =
            tonumber(
                valueString:
                match("([%d%.]+)")
            )

        if number then
            return number
        end
    end

    return nil
end

local function getPing()

    local candidates = {}

    local network =
        Stats:FindFirstChild("Network")

    if network then

        local serverStats =
            network:FindFirstChild(
                "ServerStatsItem"
            )

        if serverStats then

            table.insert(
                candidates,
                serverStats:FindFirstChild(
                    "Data Ping"
                )
            )

            table.insert(
                candidates,
                serverStats:FindFirstChild(
                    "Ping"
                )
            )
        end
    end

    local performance =
        Stats:FindFirstChild(
            "PerformanceStats"
        )

    if performance then

        table.insert(
            candidates,
            performance:FindFirstChild(
                "Ping"
            )
        )
    end

    for _, stat in ipairs(candidates) do

        local value =
            readPingStat(stat)

        if value then

            lastKnownPing =
                value

            return value
        end
    end

    return lastKnownPing
end

local function updatePingStatus(status)

    local ping =
        getPing()

    pingStatusLabel.Text =
        string.format(
            "Ping: %d ms | Status: %s",
            math.floor(
                ping + 0.5
            ),
            status
        )
end

local function waitForPingRecovery()

    if pauseDuration > 0 then

        local finish =
            tick() +
            pauseDuration

        while
            fastRepRunning
            and
            pingAdjusterEnabled
            and
            tick() < finish
        do

            updatePingStatus(
                "Paused - cooldown"
            )

            task.wait(0.1)
        end
    end

    while
        fastRepRunning
        and
        pingAdjusterEnabled
    do

        local ping =
            getPing()

        if ping < resumePing then
            break
        end

        updatePingStatus(
            "Paused - waiting for recovery"
        )

        task.wait(0.15)
    end

    pingPaused = false

    if fastRepRunning then

        updatePingStatus(
            pingAdjusterEnabled
            and "Running"
            or "Disabled"
        )
    end
end

