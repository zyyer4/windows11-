    local uniquePets =
        getUniquePetsFolder()

    if not uniquePets then
        return
    end

    for _, pet in ipairs(
        uniquePets:GetChildren()
    ) do

        if pet.Name == petName then

            pcall(function()
                equipPetEvent:FireServer(
                    "equipPet",
                    pet
                )
            end)

        end
    end
end

