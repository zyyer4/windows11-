-- ===================== Settings page =====================
-- window:BuildSettingsPage() -- opacity slider, reduce motion, Save/Load/Reset

function GlassUI:BuildSettingsPage(container)
	container = container or self.content
	local self_ = self

	-- opacity
	local opacityRow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
	})
	new("TextLabel", {
		Text = "Window opacity", Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = COLOR.textDim,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
		Size = UDim2.new(0.7, 0, 0, 16),
	}).Parent = opacityRow
	local opacityValue = new("TextLabel", {
		Text = math.floor(self._opacity * 100) .. "%", Font = Enum.Font.GothamBold, TextSize = 13,
		TextColor3 = COLOR.text, TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1,
		Size = UDim2.new(0.3, 0, 0, 16), Position = UDim2.new(0.7, 0, 0, 0),
	})
	opacityValue.Parent = opacityRow
	buildSlider(opacityRow, {
		min = 0.2, max = 0.9, value = self._opacity,
		onChange = function(v)
			self_:SetOpacity(v)
			opacityValue.Text = math.floor(v * 100) .. "%"
		end,
	})
	opacityRow.Parent = container

	-- reduce motion
	local motionRow = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 })
	new("TextLabel", {
		Text = "Reduce motion", Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = COLOR.textDim,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
		Size = UDim2.new(1, -46, 1, 0),
	}).Parent = motionRow
	do
		local track = new("TextButton", {
			Text = "", Size = UDim2.fromOffset(38, 22), Position = UDim2.new(1, -38, 0.5, -11),
			BackgroundColor3 = GlassUI._reduceMotion and COLOR.green or Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = GlassUI._reduceMotion and 0 or 0.85,
			AutoButtonColor = false, BorderSizePixel = 0,
		}, { corner(11) })
		local knob = new("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = GlassUI._reduceMotion and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
		}, { corner(9) })
		knob.Parent = track
		track.MouseButton1Click:Connect(function()
			GlassUI._reduceMotion = not GlassUI._reduceMotion
			tween(knob, { Position = GlassUI._reduceMotion and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9) }, 0.15)
			tween(track, {
				BackgroundColor3 = GlassUI._reduceMotion and COLOR.green or Color3.fromRGB(255, 255, 255),
				BackgroundTransparency = GlassUI._reduceMotion and 0 or 0.85,
			}, 0.15)
		end)
		track.Parent = motionRow
	end
	motionRow.Parent = container

	-- save / load / reset
	local btnRow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 10,
	}, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) })

	local status = new("TextLabel", {
		Text = "", Font = Enum.Font.Gotham, TextSize = 11.5, TextColor3 = COLOR.textFaint,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
	})

	local function makeBtn(label, primary)
		local btn = new("TextButton", {
			Text = label, Font = Enum.Font.GothamBold, TextSize = 12.5,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			AutoButtonColor = false, BorderSizePixel = 0,
			Size = UDim2.new(0.3333, -6, 1, 0),
			BackgroundColor3 = primary and COLOR.blue or Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = primary and 0 or 0.9,
		}, primary and { corner(8), gradient(lighten(COLOR.blue, 0.15), COLOR.purple, 135) } or { corner(8) })
		btn.Parent = btnRow
		return btn
	end

	makeBtn("Save", true).MouseButton1Click:Connect(function()
		local ok, where = self_:SaveSettings()
		status.Text = ok and ("Saved (" .. where .. ").") or "Couldn't save."
	end)
	makeBtn("Load previous").MouseButton1Click:Connect(function()
		if self_:LoadSettings() then
			status.Text = "Loaded previous settings."
			opacityValue.Text = math.floor(self_._opacity * 100) .. "%"
		else
			status.Text = "No saved settings yet."
		end
	end)
	makeBtn("Reset").MouseButton1Click:Connect(function()
		self_:ApplySettingsSnapshot({ theme = "violet", opacity = 0.65, reduceMotion = false })
		opacityValue.Text = math.floor(self_._opacity * 100) .. "%"
		status.Text = "Reset to defaults."
	end)

	btnRow.Parent = container
	status.Parent = container
end

