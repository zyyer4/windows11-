-- Fast Farm mode controls that were previously only exposed by the compact panel.
local function getFarmPaceNumbers()
    local sh, sd, sw = "0", "0", "0"
    local dh, dd, dw = "0", "0", "0"
    local ok1, sv = pcall(function() return projectedStrengthLabel.Text end)
    local ok2, dv = pcall(function() return projectedDurabilityLabel.Text end)
    if ok1 and type(sv) == "string" then
        local a,b,c = sv:match("Strength Pace:%s*([^/]+)%s*/Hour%s*|%s*([^/]+)%s*/Day%s*|%s*([^/]+)%s*/Week")
        if a then sh,sd,sw = a:gsub("%s+", ""), b:gsub("%s+", ""), c:gsub("%s+", "") end
    end
    if ok2 and type(dv) == "string" then
        local a,b,c = dv:match("Durability Pace:%s*([^/]+)%s*/Hour%s*|%s*([^/]+)%s*/Day%s*|%s*([^/]+)%s*/Week")
        if a then dh,dd,dw = a:gsub("%s+", ""), b:gsub("%s+", ""), c:gsub("%s+", "") end
    end
    return sh, sd, sw, dh, dd, dw
end

