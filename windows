--========================================================--
-- FAST REP LOOP
--========================================================--

local function fastRepLoop()

    while fastRepRunning do

        if pingAdjusterEnabled then

            local ping =
                getPing()

            if ping >= pausePing then

                pingPaused = true

                updatePingStatus(
                    "Paused - high ping"
                )

                waitForPingRecovery()

                continue
            end

        else

            pingPaused = false
        end

        if not fastRepRunning then
            break
        end

        local batchStart =
            tick()

        while
            fastRepRunning
            and
            tick() - batchStart < 0.05
        do

            if
                pingAdjusterEnabled
                and
