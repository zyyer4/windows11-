                                ),
                                formatStatNumber(
                                    perSecond * 86400
                                ),
                                formatStatNumber(
                                    perSecond * 604800
                                )
                            )
                    end
                end

                local totalElapsed =
                    farmPausedElapsed +
                    (
                        currentTime -
                        farmStartTime
                    )

                if totalElapsed > 0 then

                    local strengthPerSecond =
                        (
                            currentStrength -
