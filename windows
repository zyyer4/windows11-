-- Add your own: GlassUI.RegisterTheme("ocean", "Ocean", Color3.fromRGB(20,120,200), Color3.fromRGB(10,40,80))
function GlassUI.RegisterTheme(id, name, tintA, tintB)
	GlassUI.Themes[id] = { name = name, tintA = tintA, tintB = tintB }
	table.insert(GlassUI.ThemeOrder, id)
end

-- When true, every tween below plays near-instantly. Flip via the Settings page.
GlassUI._reduceMotion = false

-- ===================== settings storage =====================
-- Writes GlassUI/<name>.json via writefile/readfile if the environment provides
-- them (script executors do; Roblox Studio/a normal client does not). Falls back
-- to in-memory storage for the current session otherwise — plug in your own with
-- GlassUI.SetStorage({ Save = function(json, name) ... end, Load = function(name) ... end }).
local memoryStore = {}
local HttpService = game:GetService("HttpService")

GlassUI._storage = {
	Save = function(json, name)
		if writefile then
			local ok = pcall(function()
				if makefolder and not (isfolder and isfolder("GlassUI")) then
					pcall(makefolder, "GlassUI")
				end
				writefile("GlassUI/" .. name .. ".json", json)
			end)
			if ok then return true, "file" end
		end
		memoryStore[name] = json
		return true, "memory"
	end,
	Load = function(name)
		if readfile and isfile and isfile("GlassUI/" .. name .. ".json") then
			local ok, data = pcall(readfile, "GlassUI/" .. name .. ".json")
			if ok then return data, "file" end
		end
		if memoryStore[name] then return memoryStore[name], "memory" end
		return nil
	end,
}

function GlassUI.SetStorage(storage)
	GlassUI._storage = storage
end

-- ===================== small helpers =====================

local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function stroke(transparency, thickness)
	return new("UIStroke", {
		Color = COLOR.stroke,
		Transparency = transparency or 0.9,
		Thickness = thickness or 1,
	})
end

-- Two-stop diagonal gradient, e.g. gradient(baseColor, 135) for a glossy button.
local function lighten(c, amt)
	return c:Lerp(Color3.new(1, 1, 1), amt)
end
local function darken(c, amt)
	return c:Lerp(Color3.new(0, 0, 0), amt)
end
local function gradient(fromColor, toColor, rotation)
	return new("UIGradient", {
		Color = ColorSequence.new(fromColor, toColor),
		Rotation = rotation or 135,
	})
end

local function tween(inst, props, time, style)
	if GlassUI._reduceMotion then
		time = 0.01
	end
	local t = TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad), props)
	t:Play()
	return t
end

-- Makes `frame` draggable by dragging `handle` (e.g. the titlebar).
local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

-- Enables/disables the real background blur behind the glass window.
local function setWorldBlur(on)
	local blur = Lighting:FindFirstChild("GlassUIBlur")
	if on then
		if not blur then
			blur = new("BlurEffect", { Name = "GlassUIBlur", Size = 0 })
			blur.Parent = Lighting
		end
		tween(blur, { Size = 18 }, 0.25)
	elseif blur then
		local t = tween(blur, { Size = 0 }, 0.2)
		t.Completed:Connect(function()
			blur:Destroy()
		end)
	end
end

-- ===================== window =====================

function GlassUI.new(opts)
	opts = opts or {}
	local self = setmetatable({}, GlassUI)

	local player = game.Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local screenGui = new("ScreenGui", {
		Name = "GlassUI_" .. (opts.title or "Window"),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	local window = new("Frame", {
		Name = "Window",
		Size = opts.size or UDim2.fromOffset(720, 480),
		Position = UDim2.new(0.5, -360, 0.5, -240),
		AnchorPoint = Vector2.new(0, 0),
		BackgroundColor3 = COLOR.windowBg,
		BackgroundTransparency = 0.35, -- <- the "glass": see through to the blurred world
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, {
		corner(14),
		stroke(0.85, 1),
		gradient(Color3.fromRGB(70, 55, 110), Color3.fromRGB(20, 70, 95), 160),
	})
	window.UIGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(1, 0.85),
	})

	local titlebar = new("Frame", {
		Name = "Titlebar",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.94,
		BorderSizePixel = 0,
	})
	new("UIStroke", { Color = COLOR.stroke, Transparency = 0.93, Thickness = 1 }).Parent = titlebar
	titlebar.Parent = window

	-- traffic light dots: red = close, amber = minimize, green = maximize
	local dotsHolder = new("Frame", {
		Size = UDim2.fromOffset(56, 12),
		Position = UDim2.new(0, 14, 0.5, -6),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
	})
	local dots = {}
	for i, c in ipairs({ COLOR.red, COLOR.amber, COLOR.green }) do
		local dot = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = c,
			BorderSizePixel = 0,
		}, { corner(6), gradient(lighten(c, 0.35), darken(c, 0.1), 135) })
		dot.MouseEnter:Connect(function() tween(dot, { Size = UDim2.fromOffset(14, 14) }, 0.1) end)
		dot.MouseLeave:Connect(function() tween(dot, { Size = UDim2.fromOffset(12, 12) }, 0.1) end)
		dot.Parent = dotsHolder
		dots[i] = dot
	end
	dotsHolder.Parent = titlebar

	new("TextLabel", {
		Text = opts.title or "Window",
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = COLOR.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0, 200, 0, 16),
		Position = UDim2.new(0, 82, 0, 6),
		BackgroundTransparency = 1,
	}).Parent = titlebar

	if opts.subtitle then
		new("TextLabel", {
			Text = opts.subtitle,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = COLOR.textFaint,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0, 200, 0, 14),
			Position = UDim2.new(0, 82, 0, 20),
			BackgroundTransparency = 1,
		}).Parent = titlebar
	end

	makeDraggable(window, titlebar)

	local body = new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 1, -40),
		Position = UDim2.new(0, 0, 0, 40),
		BackgroundTransparency = 1,
	})
	body.Parent = window

	-- sidebar
	local sidebar = new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 190, 1, 0),
		BackgroundColor3 = COLOR.sidebarBg,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
	}, {
		new("UIStroke", { Color = COLOR.stroke, Transparency = 0.93, Thickness = 1 }),
		new("UIPadding", {
			PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
		}),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	sidebar.Parent = body

	-- content (scrolling)
	local content = new("ScrollingFrame", {
		Name = "Content",
		Size = UDim2.new(1, -190, 1, 0),
		Position = UDim2.new(0, 190, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = COLOR.textFaint,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	}, {
		new("UIPadding", {
			PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, 18),
			PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20),
		}),
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	content.Parent = body

	self.screenGui = screenGui
	self.window = window
	self.sidebar = sidebar
	self.content = content
	self._navCount = 0
	self._statGrid = nil
	self._baseSize = opts.size or UDim2.fromOffset(720, 480)
	self._basePos = window.Position
	self._minimized = false
	self._maximized = false
	self._gradient = window:FindFirstChildOfClass("UIGradient")
	self._themeId = "violet"
	self._opacity = 0.65
	self._configName = opts.configName or opts.title or "GlassUI"

	window.Parent = screenGui
	screenGui.Parent = playerGui

	setWorldBlur(true)
	self._blurred = true

	-- opening "pop in" animation: scale up from the window's own center
	local target = self._baseSize
	window.Size = UDim2.new(target.X.Scale, target.X.Offset * 0.85, target.Y.Scale, target.Y.Offset * 0.85)
	window.Position = self._basePos + UDim2.fromOffset(target.X.Offset * 0.075, target.Y.Offset * 0.075)
	window.BackgroundTransparency = 1
	tween(window, { Size = target, Position = self._basePos, BackgroundTransparency = 0.35 }, 0.35, Enum.EasingStyle.Back)

	-- a small pill shown after closing, to bring the window back
	local reopen = new("TextButton", {
		Name = "Reopen",
		Text = "  Reopen " .. (opts.title or "Window"),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		AutoButtonColor = false,
		Size = UDim2.fromOffset(160, 36),
		Position = UDim2.new(0.5, -80, 1, -60),
		BackgroundColor3 = COLOR.blue,
		Visible = false,
		BorderSizePixel = 0,
	}, { corner(18), gradient(lighten(COLOR.blue, 0.15), COLOR.purple, 135) })
	reopen.Parent = screenGui
	self.reopenButton = reopen

	dots[1].MouseButton1Click:Connect(function() -- red: close
		local t = tween(window, { Size = UDim2.new(target.X.Scale, 0, target.Y.Scale, 0), BackgroundTransparency = 1 }, 0.22)
		t.Completed:Connect(function()
			window.Visible = false
			reopen.Visible = true
			tween(reopen, { BackgroundTransparency = 0 }, 0.15)
		end)
	end)

	reopen.MouseButton1Click:Connect(function()
		reopen.Visible = false
		window.Visible = true
		window.Size = UDim2.new(target.X.Scale, 0, target.Y.Scale, 0)
		window.BackgroundTransparency = 1
		self._minimized = false
		self._maximized = false
		body.Visible = true
		tween(window, { Size = self._baseSize, BackgroundTransparency = 0.35 }, 0.3, Enum.EasingStyle.Back)
	end)

	dots[2].MouseButton1Click:Connect(function() -- amber: minimize
		self._maximized = false
		self._minimized = not self._minimized
		if self._minimized then
			tween(window, { Size = UDim2.new(0, self._baseSize.X.Offset, 0, 40) }, 0.3, Enum.EasingStyle.Back)
			task.delay(0.15, function() if self._minimized then body.Visible = false end end)
		else
			body.Visible = true
			tween(window, { Size = self._baseSize }, 0.3, Enum.EasingStyle.Back)
		end
	end)

	dots[3].MouseButton1Click:Connect(function() -- green: maximize / restore
		self._minimized = false
		body.Visible = true
		self._maximized = not self._maximized
		if self._maximized then
			local viewport = workspace.CurrentCamera.ViewportSize
			tween(window, {
				Size = UDim2.fromOffset(viewport.X * 0.92, viewport.Y * 0.88),
				Position = UDim2.fromOffset(viewport.X * 0.04, viewport.Y * 0.05),
			}, 0.32, Enum.EasingStyle.Back)
		else
			tween(window, { Size = self._baseSize, Position = self._basePos }, 0.32, Enum.EasingStyle.Back)
		end
	end)

	if opts.autoLoad ~= false then
		self:LoadSettings()
	end

	return self
end

function GlassUI:Destroy()
	if self._blurred then
		setWorldBlur(false)
	end
	if self.reopenButton then
		self.reopenButton:Destroy()
	end
	self.screenGui:Destroy()
end

-- ===================== theme / opacity =====================

function GlassUI:SetTheme(id)
	local theme = GlassUI.Themes[id]
	if not theme or not self._gradient then return end
	self._themeId = id
	tween(self._gradient, { Color = ColorSequence.new(theme.tintA, theme.tintB) }, 0.3)
end

function GlassUI:SetOpacity(opacity)
	opacity = math.clamp(opacity, 0.2, 0.9)
	self._opacity = opacity
	tween(self.window, { BackgroundTransparency = 1 - opacity }, 0.15)
end

-- Removes everything from the content area except its layout/padding, so a
-- nav item can rebuild the page from scratch (see the demo script).
function GlassUI:ClearContent()
	for _, child in ipairs(self.content:GetChildren()) do
		if not (child:IsA("UIListLayout") or child:IsA("UIPadding")) then
			child:Destroy()
		end
	end
	self._statGrid = nil
end

-- ===================== settings save / load =====================

function GlassUI:GetSettingsSnapshot()
	return { theme = self._themeId, opacity = self._opacity, reduceMotion = GlassUI._reduceMotion }
end

function GlassUI:ApplySettingsSnapshot(s)
	if not s then return end
	if s.theme then self:SetTheme(s.theme) end
	if s.opacity then self:SetOpacity(s.opacity) end
	if s.reduceMotion ~= nil then GlassUI._reduceMotion = s.reduceMotion end
end

function GlassUI:SaveSettings()
	local json = HttpService:JSONEncode(self:GetSettingsSnapshot())
	local ok, where = GlassUI._storage.Save(json, self._configName)
	return ok, where -- where is "file" or "memory"
end

function GlassUI:LoadSettings()
	local json = GlassUI._storage.Load(self._configName)
	if not json then return false end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok then return false end
	self:ApplySettingsSnapshot(data)
	return true
end

-- ===================== a tiny draggable slider (Roblox has no native <input range>) =====================

local function buildSlider(parent, opts)
	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 24),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
	}, { corner(3) })

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = COLOR.blue,
		BorderSizePixel = 0,
	}, { corner(3), gradient(lighten(COLOR.blue, 0.2), COLOR.purple, 0) })
	fill.Parent = track

	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, { corner(8) })
	knob.Parent = track
	track.Parent = parent

	local function setFraction(f, fire)
		f = math.clamp(f, 0, 1)
		fill.Size = UDim2.new(f, 0, 1, 0)
		knob.Position = UDim2.new(f, 0, 0.5, 0)
		local value = opts.min + (opts.max - opts.min) * f
		if fire and opts.onChange then opts.onChange(value) end
		return value
	end
	setFraction((opts.value - opts.min) / (opts.max - opts.min), false)

	local dragging = false
	local function updateFromPos(pos)
		local rel = (pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
		setFraction(rel, true)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromPos(input.Position)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromPos(input.Position)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return { SetValue = function(v) setFraction((v - opts.min) / (opts.max - opts.min), false) end }
end

-- ===================== Themes page =====================
-- window:BuildThemesPage()               -- builds into window.content
-- window:BuildThemesPage(someContainer)  -- builds into a container you made (e.g. a nav item's own page)

function GlassUI:BuildThemesPage(container)
	container = container or self.content
	local self_ = self

	local grid = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, {
		new("UIGridLayout", {
			CellPadding = UDim2.fromOffset(10, 10),
			CellSize = UDim2.new(0.5, -5, 0, 84),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local checks = {}
	for i, id in ipairs(GlassUI.ThemeOrder) do
		local theme = GlassUI.Themes[id]
		local card = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.95,
			BorderSizePixel = 0,
			LayoutOrder = i,
		}, { corner(9), stroke(0.9, 1) })

		new("Frame", {
			Size = UDim2.new(1, -16, 0, 40),
			Position = UDim2.fromOffset(8, 8),
			BorderSizePixel = 0,
		}, { corner(7), gradient(theme.tintA, theme.tintB, 135) }).Parent = card

		new("TextLabel", {
			Text = theme.name,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = COLOR.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -34, 0, 16),
			Position = UDim2.fromOffset(8, 54),
		}).Parent = card

		local check = new("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.new(1, -22, 0, 55),
			BackgroundColor3 = COLOR.green,
			BorderSizePixel = 0,
			Visible = self_._themeId == id,
		}, { corner(7) })
		new("TextLabel", {
			Text = "✓", Font = Enum.Font.GothamBold, TextSize = 9,
			TextColor3 = Color3.fromRGB(12, 31, 20), BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}).Parent = check
		check.Parent = card
		checks[id] = check

		card.MouseButton1Click:Connect(function()
			self_:SetTheme(id)
			for cid, chk in pairs(checks) do
				chk.Visible = (cid == id)
			end
		end)

		card.Parent = grid
	end

	grid.Parent = container

	new("TextLabel", {
		Text = "Theme applies instantly. Save it on the Settings page so it loads next time.",
