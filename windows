local function makePerformanceControls()
    clearCards()
    grid.CellSize=UDim2.new(1,-7,0,58)

    _G.EmpirePerformanceSettings=_G.EmpirePerformanceSettings or {
        accessories=false,
        particles=true,
        trailsBeams=true,
        lights=true,
        postEffects=true,
        skyAtmosphere=false,
        decalsTextures=false,
        sounds=false,
        animations=false,
    }

    _G.EmpireAntiLagBackup=_G.EmpireAntiLagBackup or {
        props={},
        destroyed={},
    }

    local settings=_G.EmpirePerformanceSettings
    local backup=_G.EmpireAntiLagBackup

    local function remember(obj,property)
        if not obj then return end
        local entry=backup.props[obj]
        if not entry then
            entry={}
            backup.props[obj]=entry
        end
        if entry[property]==nil then
            local ok,value=pcall(function() return obj[property] end)
            if ok then entry[property]=value end
        end
    end

    local function setProp(obj,property,value)
        remember(obj,property)
        pcall(function() obj[property]=value end)
    end

    local function applyPerformanceCleanup()
        local character=player.Character

        if settings.accessories and character then
            for _,obj in ipairs(character:GetDescendants()) do
                if obj:IsA("Accessory") then
                    for _,part in ipairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") then
                            setProp(part,"LocalTransparencyModifier",1)
                        end
                    end
                end
            end
        end

        if settings.particles or settings.trailsBeams then
            for _,obj in ipairs(workspace:GetDescendants()) do
                if settings.particles and (
                    obj:IsA("ParticleEmitter") or
                    obj:IsA("Smoke") or
                    obj:IsA("Fire") or
                    obj:IsA("Sparkles")
                ) then
                    setProp(obj,"Enabled",false)
                elseif settings.trailsBeams and (
                    obj:IsA("Trail") or
                    obj:IsA("Beam")
                ) then
                    setProp(obj,"Enabled",false)
                end
            end
        end

        if settings.lights then
            for _,obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
                    setProp(obj,"Enabled",false)
                end
            end
        end

        if settings.postEffects then
            for _,obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("PostEffect") then
                    setProp(obj,"Enabled",false)
                end
            end
        end

        if settings.skyAtmosphere then
            for _,obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("Atmosphere") then
                    setProp(obj,"Density",0)
                    setProp(obj,"Haze",0)
                    setProp(obj,"Glare",0)
                elseif obj:IsA("Sky") then
                    local alreadySaved=false
                    for _,saved in ipairs(backup.destroyed) do
                        if saved.original==obj then
                            alreadySaved=true
                            break
                        end
                    end
                    if not alreadySaved then
                        local ok,clone=pcall(function() return obj:Clone() end)
                        if ok and clone then
                            table.insert(backup.destroyed,{original=obj,clone=clone,parent=Lighting})
                        end
                        pcall(function() obj:Destroy() end)
                    end
                end
            end
        end

        if settings.decalsTextures then
