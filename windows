function UI:SelectTab(tab)
    if not tab then return end

    self.ActiveTab = tab

    for _, item in ipairs(self.Tabs) do
        local active = item == tab

        item.Page.Visible = active
        item.SelectedBar.Visible = active

        if active then
            tween(item.Button, 0.14, {
                BackgroundTransparency = 0.10,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.Text,
            })
        else
            tween(item.Button, 0.14, {
                BackgroundTransparency = 1,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.SubText,
            })
        end
    end

    self.PageTitle.Text = tab.Title
    self.PageSubtitle.Text =
        tab.Description ~= "" and tab.Description
        or "Build this page using the Fluent-style API."
end

function UI:SetTitle(titleValue, subtitleValue)
    if titleValue then
        self.TitleLabel.Text = titleValue
    end
    if subtitleValue then
        self.SubtitleLabel.Text = subtitleValue
    end
end

function UI:Destroy()
    self:StopGlobalExecutionFeed()
    if self._inputConnection then
        self._inputConnection:Disconnect()
        self._inputConnection = nil
    end

    if self.Gui then
        self.Gui:Destroy()
    end
end

