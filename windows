local function setFortuneWheel(state)
    fortuneWheelRunning = state
    fortuneWheelLoopId += 1

    local myLoopId = fortuneWheelLoopId

    if not state then
        print("[Johnny] Fortune Wheel: stopped")
        return
    end

    task.spawn(function()

        while
            fortuneWheelRunning
            and
            myLoopId == fortuneWheelLoopId
            and
            not _G.JohnnyScriptDestroyed
        do

            local result = spinFortuneWheelOnce()

            if result == "MAX_SPINS" then
                fortuneWheelRunning = false

                if fortuneWheelSwitch then
                    pcall(function()
                        fortuneWheelSwitch:Set(false)
                    end)
                end

                break
            end

            task.wait(1)
        end
    end)
end

