--[[
	GlassUI
	A small "black glass" macOS-style UI library for Roblox.

	Put this ModuleScript in ReplicatedStorage (e.g. ReplicatedStorage.GlassUI),
	then require it from a LocalScript to build a window.

	The "glass" look is two things layered together, exactly like a real
	frosted-glass panel:
	  1. Lighting.Blur — blurs the 3D game world behind the UI.
	  2. A semi-transparent black Frame on top of that blur.
	Turn the blur on when you open the window and off when you close it.

	USAGE (see GlassUI_Demo.client.lua for a full working example):

		local GlassUI = require(game.ReplicatedStorage.GlassUI)
		local window = GlassUI.new({ title = "Panel", subtitle = "UI Kit Demo" })

		window:AddNavItem({ id = "overview", label = "Overview", color = "blue", active = true })
		window:AddStat({ label = "Active sessions", value = "128" })

		local panel = window:AddPanel({ title = "Gained this session", open = true })
		panel:AddRow({ label = "Requests handled", value = "3,204", checked = true })

		local row, toggle = panel:AddToggleRow({ label = "Email digests", on = true })
]]

