    card.MouseEnter:Connect(function() tween(cardScale,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Scale=1.012}) end)
    card.MouseLeave:Connect(function() tween(cardScale,TweenInfo.new(.2,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Scale=1}) end)
    local accentBar=create("Frame",{Position=UDim2.new(0,0,0,0),Size=UDim2.new(0,3,1,0),BackgroundColor3=accent or COLORS.blue,BorderSizePixel=0},card); corner(accentBar,2)
    create("TextLabel",{Position=UDim2.new(0,16,0,15),Size=UDim2.new(1,-32,0,25),BackgroundTransparency=1,Text=title,TextColor3=COLORS.text,TextSize=14,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},card)
    create("TextLabel",{Position=UDim2.new(0,16,0,45),Size=UDim2.new(1,-32,0,39),BackgroundTransparency=1,Text=desc,TextColor3=COLORS.muted,TextSize=10,TextWrapped=true,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top},card)
    local b=create("TextButton",{Position=UDim2.new(0,16,1,-43),Size=UDim2.new(1,-32,0,30),BackgroundColor3=Color3.fromRGB(28,42,68),Text=buttonText,TextColor3=COLORS.text,TextSize=11,Font=Enum.Font.GothamSemibold,AutoButtonColor=true},card)
    corner(b,7); stroke(b,Color3.fromRGB(119,139,183),.72,1)
    hoverScale(b,1.025)
    b.Activated:Connect(function()
        b.Text=(b.Text=="Enabled" and "Enable") or "Enabled"
        if b.Text=="Enabled" then b.BackgroundColor3=accent or COLORS.blue else b.BackgroundColor3=Color3.fromRGB(28,42,68) end
    end)
end

local function makeThemeControls()
    clearCards()
    grid.CellSize=UDim2.new(1,-7,0,122)
    local function sliderCard(title,desc,value,min,max,step,format)
        local card=create("Frame",{BackgroundColor3=COLORS.panel,BackgroundTransparency=.16,BorderSizePixel=0},cardArea)
        corner(card,10); stroke(card,COLORS.line,.58,1)
        create("TextLabel",{Position=UDim2.new(0,16,0,14),Size=UDim2.new(1,-100,0,23),BackgroundTransparency=1,Text=title,TextColor3=COLORS.text,TextSize=14,Font=Enum.Font.GothamSemibold,TextXAlignment=Enum.TextXAlignment.Left},card)
        local valueLabel=create("TextLabel",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-16,0,14),Size=UDim2.fromOffset(72,22),BackgroundTransparency=1,Text=format(value),TextColor3=COLORS.muted,TextSize=10,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Right},card)
        create("TextLabel",{Position=UDim2.new(0,16,0,39),Size=UDim2.new(1,-32,0,22),BackgroundTransparency=1,Text=desc,TextColor3=COLORS.muted,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},card)
        local minus=create("TextButton",{Position=UDim2.new(0,16,1,-38),Size=UDim2.fromOffset(34,27),BackgroundColor3=Color3.fromRGB(29,39,60),Text="−",TextColor3=COLORS.text,TextSize=16,Font=Enum.Font.Gotham},card); corner(minus,6); stroke(minus,COLORS.line,.68,1)
        local plus=create("TextButton",{Position=UDim2.new(0,56,1,-38),Size=UDim2.fromOffset(34,27),BackgroundColor3=Color3.fromRGB(29,39,60),Text="+",TextColor3=COLORS.text,TextSize=16,Font=Enum.Font.Gotham},card); corner(plus,6); stroke(plus,COLORS.line,.68,1)
        local bar=create("Frame",{Position=UDim2.new(0,102,1,-31),Size=UDim2.new(1,-118,0,5),BackgroundColor3=Color3.fromRGB(29,39,60),BorderSizePixel=0},card); corner(bar,3)
        local fill=create("Frame",{Size=UDim2.new((value-min)/(max-min),0,1,0),BackgroundColor3=COLORS.blue,BorderSizePixel=0},bar); corner(fill,4)
        local current=value
        local function set(v)
            current=math.clamp(v,min,max); valueLabel.Text=format(current); tween(fill,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Size=UDim2.new((current-min)/(max-min),0,1,0)})
            if title=="Glass opacity" then tween(windowFrame,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{BackgroundTransparency=1-current}) end
        end
        minus.Activated:Connect(function() set(current-step) end)
        plus.Activated:Connect(function() set(current+step) end)
    end
