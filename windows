    local function themeCard(title,height,order)
        local card=create("Frame",{
            LayoutOrder=order, Size=UDim2.new(1,-4,0,height),
            BackgroundColor3=COLORS.panel, BackgroundTransparency=.12, BorderSizePixel=0,
        },cardArea)
        corner(card,12)
        stroke(card,COLORS.line,.58,1)
        return card
    end

    local function restyleWindow(cfg, rotation)
        activeConfig=cfg or activeConfig
        activeThemeName=activeConfig.name
        gradientRotation=rotation or gradientRotation

        windowFrame.BackgroundColor3=activeConfig.bg
        sidebar.BackgroundColor3=activeConfig.side

        local windowGradient=windowFrame:FindFirstChildOfClass("UIGradient")
        if windowGradient then
            windowGradient.Color=ColorSequence.new({
                ColorSequenceKeypoint.new(0,activeConfig.g1),
                ColorSequenceKeypoint.new(.55,activeConfig.g2),
                ColorSequenceKeypoint.new(1,activeConfig.g3),
            })
            windowGradient.Rotation=gradientRotation
        end

        -- Theme only the existing surfaces with known Empire roles.  In
        -- particular, do NOT force every TextButton to the accent color; that
        -- was what broke navigation, Misc, Info, and the source controls.
        for _,obj in ipairs(windowFrame:GetDescendants()) do
            if obj:IsA("GuiObject") then
                local role=obj:GetAttribute("EmpireThemeRole")
                if role=="sidebar" then
                    obj.BackgroundColor3=activeConfig.side
                elseif role=="panel" then
                    obj.BackgroundColor3=activeConfig.panel
                elseif role=="panel2" then
                    obj.BackgroundColor3=activeConfig.panel2
                elseif role=="nav" then
                    obj.BackgroundColor3=activeConfig.nav
                elseif role=="button" then
                    obj.BackgroundColor3=activeConfig.button
                elseif role=="bg" then
                    obj.BackgroundColor3=activeConfig.bg
                elseif role=="mutedText" and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                    obj.TextColor3=Color3.fromRGB(160,170,190)
                elseif role=="text" and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                    obj.TextColor3=Color3.fromRGB(243,246,255)
                end
            elseif obj:IsA("UIStroke") then
                local parent=obj.Parent
                local isTraffic=parent and parent.Parent==traffic
                if not isTraffic then
                    obj.Color=activeConfig.line
                    obj.Thickness=activeConfig.stroke
                end
            end
        end

        -- Re-theme navigation without touching its event logic.
        for _,child in ipairs(nav:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3=activeConfig.nav
            end
        end

        -- Restore the currently selected navigation button with the accent.
        local currentName=(breadcrumb.Text or ""):match("Empire / (.+)")
        if currentName then
            local selected=nav:FindFirstChild(currentName.."Tab")
            if selected and selected:IsA("TextButton") then
                selected.BackgroundColor3=activeConfig.accent
                selected.BackgroundTransparency=.18
            end
        end
    end

    local function findTheme(name)
        for _,cfg in ipairs(themes) do
            if cfg.name==name then return cfg end
        end
        return themes[1]
    end

