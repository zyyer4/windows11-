local function hoverScale(button, scaleValue)
    local scale=create("UIScale",{Scale=1},button)
    local target=scaleValue or 1.025
    button.MouseEnter:Connect(function()
        tween(scale,TweenInfo.new(.16,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Scale=target})
    end)
    button.MouseLeave:Connect(function()
        tween(scale,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Scale=1})
    end)
    button.MouseButton1Down:Connect(function()
        tween(scale,TweenInfo.new(.07,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=.975})
    end)
    button.MouseButton1Up:Connect(function()
        tween(scale,TweenInfo.new(.13,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=target})
    end)
end

-- Generic click-and-drag helper: `handle` is the GuiObject that listens for the
-- input, `target` is the GuiObject that actually gets repositioned. Works for
-- both mouse and touch, and preserves whatever AnchorPoint `target` already has.
local function makeDraggable(handle, target, onDragEnd)
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    local function update(input)
        local delta = input.Position - dragStart
        target.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position

            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    if dragging and onDragEnd then
                        pcall(onDragEnd, target.Position)
                    end
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            update(input)
        end
    end)
end

