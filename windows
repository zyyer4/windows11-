local function doFastRebirth()

    local currentRebirths =
        rebirthsStat.Value

    local strengthTarget =
        5000 +
        (currentRebirths * 2550)

    while
        isFastRebirthRunning
        and
        strengthStat.Value <
        strengthTarget
    do

        local reps

        if Player.MembershipType ==
            Enum.MembershipType.Premium then

            reps = 8

        else

            reps = 14

        end

        for _ = 1, reps do

            if not isFastRebirthRunning then
                break
            end

            pcall(function()
                muscleEvent:FireServer("rep")
            end)

        end

        task.wait(0.01)
    end

    if
        isFastRebirthRunning
        and
        strengthStat.Value >=
        strengthTarget
    then

        -- Keep Titanium Hydra equipped.
        managePets("Tribal Overlord")

        task.wait(0.1)

        local before =
            rebirthsStat.Value

        repeat

            _G.EmpireDiagnostics.rebirthInvokes=_G.EmpireDiagnostics.rebirthInvokes+1
            _G.EmpireDiagnostics.lastEvent="Fast Rebirth Invoke"
            local okReb,errReb=pcall(function()
                rebirthRemote:InvokeServer(
                    "rebirthRequest"
                )
            end)
            if not okReb then
                _G.EmpireDiagnostics.errors=_G.EmpireDiagnostics.errors+1
                _G.EmpireDiagnostics.lastError=tostring(errReb):sub(1,120)
            end

            task.wait(0.05)

        until
            rebirthsStat.Value > before
            or
            not isFastRebirthRunning
    end
end

fastRebirthLoop = function()

    while isFastRebirthRunning do

        -- Titanium Hydra remains equipped.
        -- Swift Samurai is managed normally.
        managePets("Swift Samurai")

        doFastRebirth()

        task.wait(0.05)
    end

end

