--========================================================--
-- FAST REBIRTH PACE
--========================================================--

local lastRebirthTime = tick()
local lastRebirthValue =
    rebirthsStat.Value

local paceHistoryHour = {}
local paceHistoryDay = {}
local paceHistoryWeek = {}

local maxHistoryLength = 20
local rebirthCount = 0

local function updateRebirthsLabel()

    local gained =
        rebirthsStat.Value -
        initialRebirths

    rebirthStatsLabel.Text =
        string.format(
            "Rebirths: %s | Gained: %s",
            formatRebirthNumber(
                rebirthsStat.Value
            ),
            formatRebirthNumber(gained)
        )
end

local function averageTable(tbl)

    if #tbl == 0 then
        return 0
    end

    local total = 0

    for _, value in ipairs(tbl) do
        total += value
    end

    return total / #tbl
end

local function calculateRebirthPace()

    rebirthCount += 1

    if rebirthCount < 2 then
        lastRebirthTime = tick()
        lastRebirthValue =
            rebirthsStat.Value
        return
    end

    local now = tick()

    local gained =
        rebirthsStat.Value -
        lastRebirthValue

    if gained <= 0 then
        return
    end

    local elapsed =
        now - lastRebirthTime

    if elapsed <= 0 then
        return
    end

    local perSecond =
        gained / elapsed

    local perHour =
        perSecond * 3600

    local perDay =
        perSecond * 86400

    local perWeek =
        perSecond * 604800

    rebirthPaceLabel.Text =
        string.format(
            "Pace: %s / Hour | %s / Day | %s / Week",
            formatRebirthNumber(perHour),
            formatRebirthNumber(perDay),
            formatRebirthNumber(perWeek)
        )

    table.insert(
        paceHistoryHour,
        perHour
    )

    table.insert(
        paceHistoryDay,
        perDay
    )

    table.insert(
        paceHistoryWeek,
        perWeek
    )

    if #paceHistoryHour > maxHistoryLength then
        table.remove(paceHistoryHour, 1)
        table.remove(paceHistoryDay, 1)
        table.remove(paceHistoryWeek, 1)
    end

    rebirthAverageLabel.Text =
        string.format(
            "Average Pace: %s / Hour | %s / Day | %s / Week",
            formatRebirthNumber(
                averageTable(paceHistoryHour)
            ),
            formatRebirthNumber(
                averageTable(paceHistoryDay)
            ),
            formatRebirthNumber(
                averageTable(paceHistoryWeek)
            )
        )

    lastRebirthTime = now
    lastRebirthValue =
        rebirthsStat.Value
end

rebirthsStat:GetPropertyChangedSignal(
    "Value"
):Connect(function()

    calculateRebirthPace()
    updateRebirthsLabel()

end)

--========================================================--
-- PET MANAGEMENT
--========================================================--
-- IMPORTANT:
-- Titanium Hydra is NEVER unequipped.
--
-- This allows the new 12-slot setup to keep
-- Titanium Hydra equipped while the script manages
-- Swift Samurai / Tribal Overlord.
--========================================================--

local function getUniquePetsFolder()

    local petsFolder =
        Player:FindFirstChild("petsFolder")

    if not petsFolder then
        return nil
    end

    return petsFolder:FindFirstChild("Unique")
end

local function isProtectedPet(pet)

    return pet
        and pet.Name ==
        "Titanium Hydra"
end

local function unequipAllExceptProtected()

    local petsFolder =
        Player:FindFirstChild("petsFolder")

    if not petsFolder then
        return
    end

    for _, folder in ipairs(
        petsFolder:GetChildren()
    ) do

        if folder:IsA("Folder") then

            for _, pet in ipairs(
                folder:GetChildren()
            ) do

                if not isProtectedPet(pet) then

                    pcall(function()
                        equipPetEvent:FireServer(
                            "unequipPet",
                            pet
                        )
                    end)

                end
            end
        end
    end
end

local function equipPetByName(petName)

    local uniquePets =
        getUniquePetsFolder()

    if not uniquePets then
        return
    end

    for _, pet in ipairs(
        uniquePets:GetChildren()
    ) do

        if pet.Name == petName then

            pcall(function()
                equipPetEvent:FireServer(
                    "equipPet",
                    pet
                )
            end)

        end
    end
end

local function managePets(petName)

    -- Titanium Hydra stays equipped.
    unequipAllExceptProtected()

    task.wait(0.05)

    -- Equip the requested pet.
    equipPetByName(petName)

end

--========================================================--
-- FAST REBIRTH LOGIC
--========================================================--

local function doFastRebirth()

    local currentRebirths =
        rebirthsStat.Value

    local strengthTarget =
        5000 +
        (currentRebirths * 2550)

    while
        isFastRebirthRunning
        and
        strengthStat.Value <
        strengthTarget
    do

        local reps

        if Player.MembershipType ==
            Enum.MembershipType.Premium then

            reps = 8

        else

            reps = 14

        end

        for _ = 1, reps do

            if not isFastRebirthRunning then
                break
            end

            pcall(function()
                muscleEvent:FireServer("rep")
            end)

        end

        task.wait(0.01)
    end

    if
        isFastRebirthRunning
        and
        strengthStat.Value >=
        strengthTarget
    then

        -- Keep Titanium Hydra equipped.
        managePets("Tribal Overlord")

        task.wait(0.1)

        local before =
            rebirthsStat.Value

        repeat

            pcall(function()
                rebirthRemote:InvokeServer(
                    "rebirthRequest"
                )
            end)

            task.wait(0.05)

        until
            rebirthsStat.Value > before
            or
            not isFastRebirthRunning
    end
end

local function fastRebirthLoop()

    while isFastRebirthRunning do

        -- Titanium Hydra remains equipped.
        -- Swift Samurai is managed normally.
        managePets("Swift Samurai")

        doFastRebirth()

        task.wait(0.05)
    end

end

