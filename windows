        local candidates={
            type(env)=="table" and rawget(env,"request") or nil,
            type(env)=="table" and rawget(env,"http_request") or nil,
            type(httpTable)=="table" and rawget(httpTable,"request") or nil,
            type(synTable)=="table" and rawget(synTable,"request") or nil,
        }
        for _,fn in ipairs(candidates) do
            if type(fn)=="function" then return fn end
        end
        return nil
    end

