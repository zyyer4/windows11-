local function addAutoExercise(
    exerciseName
)

    local key =
        "JohnnyAuto" ..
        exerciseName:gsub(
            "%s",
            ""
        )

    ToolsTab:AddSwitch(
        "Auto " .. exerciseName,
        function(state)

            _G[key] = state

            if not state then
                return
            end

            task.spawn(function()

                while _G[key] do

                    local character =
                        Player.Character

                    local backpack =
                        Player.Backpack

                    local tool =
                        (
                            character
                            and
                            character:FindFirstChild(
                                exerciseName
                            )
                        )
                        or
                        (
                            backpack
                            and
                            backpack:FindFirstChild(
                                exerciseName
                            )
                        )

                    if tool and character then

                        local humanoid =
                            character:
                            FindFirstChildOfClass(
                                "Humanoid"
                            )

                        if humanoid
                            and
                            tool.Parent ==
                            backpack
                        then

                            pcall(function()
                                humanoid:EquipTool(
                                    tool
                                )
                            end)
                        end
                    end

                    pcall(function()
                        muscleEvent:FireServer(
                            "rep"
                        )
                    end)

                    task.wait(0.1)
                end
            end)
        end
    )
end

