-- Add your own theme (call before creating the window so it shows on the Themes page):
--   GlassUI.RegisterTheme("Mint", { windowBg = Color3.fromRGB(10, 24, 20), accent = Color3.fromRGB(80, 230, 180) })
function GlassUI.RegisterTheme(name, overrides)
	local theme = {}
	for k, v in pairs(BASE_THEME) do
		theme[k] = v
	end
	for k, v in pairs(overrides or {}) do
		theme[k] = v
	end
	theme.name = name
	if not THEMES[name] then
		table.insert(THEME_ORDER, name)
	end
	THEMES[name] = theme
end

