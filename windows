-- A row of equal-width buttons.
--   buttons = { { icon = "💾", text = "Save", primary = true, onClick = fn },
--               { icon = "🔄", text = "Reset", danger = true, confirm = "Sure?", onClick = fn } }
function Panel:AddButtonRow(buttons)
	local ui = self._ui
	self._rowCount += 1
	local n = #buttons
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = self._rowCount,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for i, def in ipairs(buttons) do
		local baseT = def.primary and 0 or (def.danger and 0.82 or 0.88)
		local idleText = def.icon and (def.icon .. "  " .. def.text) or def.text
		local btn = new("TextButton", {
			Text = idleText,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundTransparency = baseT,
			LayoutOrder = i,
			Size = UDim2.new(1 / n, -8 * (n - 1) / n, 0, 28),
		}, { corner(7) })
		ui:_themed(function(theme)
			if def.primary then
				btn.BackgroundColor3 = theme.accent
				btn.TextColor3 = theme.accentOn
			elseif def.danger then
				btn.BackgroundColor3 = COLOR.red
				btn.TextColor3 = COLOR.red
			else
				btn.BackgroundColor3 = theme.surface
				btn.TextColor3 = theme.text
			end
		end)
		btn.MouseEnter:Connect(function()
			tween(btn, { BackgroundTransparency = math.max(baseT - 0.08, 0) }, 0.1)
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, { BackgroundTransparency = baseT }, 0.1)
		end)

		local armed = false
		btn.MouseButton1Click:Connect(function()
			if def.confirm and not armed then
				armed = true
				btn.Text = "⚠️  " .. def.confirm
				task.delay(2.5, function()
					if armed then
						armed = false
						btn.Text = idleText
					end
				end)
				return
			end
			armed = false
			btn.Text = idleText
			if def.onClick then
				task.spawn(def.onClick)
			end
		end)
		btn.Parent = row
	end

	row.Parent = self.body
	return row
end

