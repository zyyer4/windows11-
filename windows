local GlassUI = (function()
--[[
	GlassUI  (standalone)
	A self-contained "black glass" UI library for Roblox. One file, no dependencies:
	no ReplicatedStorage, no server script, no RemoteFunction.

	Use it any of these ways:
	  * Paste it at the top of your own LocalScript and use the returned table
	    (see GlassUI_Standalone.lua for that exact setup).
	  * Keep it in its own file and run it with loadstring(<file contents>)().
	  * Or drop it in any ModuleScript and require it.

	LOOK
	  Lighting.GlassUIBlur (blurs the world) + a semi-transparent frame + a theme tint.

	FEATURES
	  * Real pages: every nav item owns a page. Clicking it switches pages.
	  * Themes: window:SetTheme("Ocean"), GlassUI.RegisterTheme(...) for your own.
	  * Settings: opacity, blur on/off + strength, UI scale, accent colour,
	    show/hide keybind, auto-save. Saved and loaded as one JSON blob.
	  * Toggle rows with a `key` are saved too (e.g. your feature switches).

	SAVING
	  Default storage writes  GlassUI/<configName>.json  when the environment provides
	  writefile / readfile / isfile / makefolder. If it doesn't, settings are kept in
	  memory for the current session only (the status line says so).
	  Use GlassUI.SetStorage({ Save = fn(json, name), Load = fn(name) }) to plug in
	  your own (DataStore, HttpService, etc.).

	OPTIONS  GlassUI.new({ title, subtitle, size, parent, configName, autoLoad })
	  parent      where the ScreenGui goes (default: LocalPlayer.PlayerGui)
	  configName  file/slot name for saving (default: the title)
	  autoLoad    false = don't load saved settings on startup

	QUICK START
		local window = GlassUI.new({ title = "Panel", subtitle = "UI Kit Demo" })

		local _, farming = window:AddNavItem({ id = "farming", label = "Farming", color = "green", active = true })
		farming:AddStat({ label = "Active sessions", value = "128" })
		local panel = farming:AddPanel({ title = "Gained this session", open = true })
		panel:AddToggleRow({ label = "Auto farm", key = "autoFarm", on = false, onChange = print })

		local _, themes = window:AddNavItem({ id = "themes", label = "Themes", color = "purple" })
		window:BuildThemesPage(themes)
		local _, misc = window:AddNavItem({ id = "misc", label = "Misc", color = "gray" })
		window:BuildSettingsPage(misc)
]]

