    function tab:AddButton(name2, callback)
        local button = addFeatureButton(page, name2, callback)
        local feature = {
            Name = name2,
            Type = "Button",
            Button = button,
            Callback = callback,
        }
        function feature:Run(...)
            if self.Callback then
                return self.Callback(...)
            end
        end
        tab.Features[name2] = feature
        Johnny.Features[name2] = feature
        return feature
    end

    function tab:AddSwitch(name2, callback)
        local state = addFeatureSwitch(page, name2, callback)
        tab.Features[name2] = state
        Johnny.Features[name2] = state
        return state
