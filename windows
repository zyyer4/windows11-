local farmPaceLabel = FarmingTab:AddLabel("Pace display: Full")

local function setFarmPaceFormat(name)
    farmPaceFormat = name
    farmPaceLabel.Text = "Pace display: " .. name
    local h, d, w, dh, dd, dw = getFarmPaceNumbers()
    if name == "Short" then
        projectedStrengthLabel.Text = string.format("Strength: %s/h | %s/d | %s/w", h, d, w)
        projectedDurabilityLabel.Text = string.format("Durability: %s/h | %s/d | %s/w", dh, dd, dw)
    elseif name == "Compact" then
        projectedStrengthLabel.Text = string.format("STR %s / %s / %s", h, d, w)
        projectedDurabilityLabel.Text = string.format("DUR %s / %s / %s", dh, dd, dw)
    elseif name == "Mini" then
        projectedStrengthLabel.Text = string.format("STR %s/h", h)
        projectedDurabilityLabel.Text = string.format("DUR %s/h", dh)
    end
end

