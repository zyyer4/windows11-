-- Row of accent colour chips ("Theme" = use the theme's own accent).
function Panel:AddAccentRow()
	local ui = self._ui
	self._rowCount += 1
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = self._rowCount,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local rings = {}
	local function makeRing(chip)
		local ring = new("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Transparency = 1,
			Thickness = 2,
		})
		ring.Parent = chip
		return ring
	end

	local auto = new("TextButton", {
		Text = "Theme",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundTransparency = 0.88,
		Size = UDim2.fromOffset(56, 24),
		LayoutOrder = 0,
	}, { corner(12) })
	ui:_bind(auto, "BackgroundColor3", "surface")
	ui:_bind(auto, "TextColor3", "text")
	auto.MouseButton1Click:Connect(function()
		ui:SetAccent("auto")
	end)
	auto.Parent = row
	rings.auto = makeRing(auto)

	for i, a in ipairs(ACCENTS) do
		local chip = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundColor3 = a.color,
			Size = UDim2.fromOffset(24, 24),
			LayoutOrder = i,
		}, { corner(12) })
		chip.MouseButton1Click:Connect(function()
			ui:SetAccent(a.id)
		end)
		chip.Parent = row
		rings[a.id] = makeRing(chip)
	end

	ui:_addSyncer(function()
		local current = ui.settings.accent
		for id, ring in pairs(rings) do
			local selected = (id == current) or (id == "auto" and not findAccent(current))
			ring.Color = ui.theme.text
			ring.Transparency = selected and 0 or 1
		end
	end)

	row.Parent = self.body
	return row
end

-- ===================== ready-made pages =====================

-- Fills `page` with the theme picker + accent colour chips.
function GlassUI:BuildThemesPage(page)
	page = page or self:_getDefaultPage()
	local themes = page:AddPanel({ title = "Theme", icon = "🎨", open = true })
	themes:AddThemeGrid()
	local accent = page:AddPanel({ title = "Accent color", icon = "🖌️", open = true })
	accent:AddAccentRow()
	return page
end

-- Fills `page` with appearance / behaviour settings and the save & load controls.
function GlassUI:BuildSettingsPage(page)
	page = page or self:_getDefaultPage()
	local s = self.settings

	local function percent(v)
		return string.format("%d%%", math.floor(v * 100 + 0.5))
	end
	local function whole(v)
		return string.format("%d", math.floor(v + 0.5))
	end

	-- Appearance
	local look = page:AddPanel({ title = "Appearance", icon = "✨", open = true })
	local _, opacity = look:AddSliderRow({
		label = "Window opacity", min = 0.2, max = 1, step = 0.01, value = s.opacity, format = percent,
		onChange = function(v) self:SetOpacity(v) end,
	})
	local _, blurToggle = look:AddToggleRow({
		label = "Background blur", on = s.blur,
		onChange = function(on) self:SetBlur(on) end,
	})
	local _, blurSize = look:AddSliderRow({
		label = "Blur strength", min = 0, max = 40, step = 1, value = s.blurSize, format = whole,
		onChange = function(v) self:SetBlurSize(v) end,
	})
	local _, scale = look:AddSliderRow({
		label = "UI scale", min = 0.7, max = 1.5, step = 0.05, value = s.scale, format = percent,
		onChange = function(v) self:SetScale(v) end,
	})

	-- Behaviour
	local behavior = page:AddPanel({ title = "Behavior", icon = "🎮", open = true })
	behavior:AddKeybindRow({ label = "Show / hide window key" })
	local _, autoSave = behavior:AddToggleRow({
		label = "Auto-save changes", on = s.autoSave,
		onChange = function(on) self:SetAutoSave(on) end,
	})
	behavior:AddButtonRow({
		{ icon = "🎯", text = "Recenter window", onClick = function() self:Recenter() end },
	})

	-- Save / load
	local saved = page:AddPanel({ title = "Saved settings", icon = "💾", open = true })
	local _, statusLabel = saved:AddRow({ label = "Status", value = "" })
	self._statusLabel = statusLabel
	self:_themed(function()
		self:_renderStatus()
	end)
	saved:AddButtonRow({
		{ text = "Save", primary = true, onClick = function() self:SaveSettings() end },
		{ icon = "📂", text = "Load", onClick = function() self:LoadSettings() end },
		{ text = "Reset", danger = true, confirm = "Sure?", onClick = function() self:ResetSettings() end },
	})

	self:_addSyncer(function()
		opacity:Set(self.settings.opacity, false)
		blurToggle:Set(self.settings.blur, false)
		blurSize:Set(self.settings.blurSize, false)
		scale:Set(self.settings.scale, false)
		autoSave:Set(self.settings.autoSave, false)
	end)

	return page
end

-- Fills `page` with an info screen: about, player, game/server, live performance, shortcuts.
--   opts.title  = "About"                       (heading of the first panel)
--   opts.about  = { { "Script", "My hub" }, { "Version", "1.0" } }   (extra rows)
function GlassUI:BuildInfoPage(page, opts)
	page = page or self:_getDefaultPage()
	opts = opts or {}
	local player = Players.LocalPlayer
	local updaters = {}

	-- a row whose value is recomputed every second while the page is visible
	local function live(panel, label, initial, fn)
		local _, valueLabel = panel:AddRow({ label = label, value = initial })
		table.insert(updaters, function()
			valueLabel.Text = tostring(fn())
		end)
	end

	local about = page:AddPanel({ title = opts.title or "About", icon = "ℹ️", open = true })
	about:AddRow({ label = "UI library", value = "GlassUI " .. GlassUI.Version })
	for _, line in ipairs(opts.about or {}) do
		about:AddRow({ label = tostring(line[1]), value = tostring(line[2]) })
	end
	about:AddRow({ label = "Save slot", value = tostring(self._configName) })
	live(about, "Theme", self.settings.theme, function()
		return self.settings.theme
	end)

	local me = page:AddPanel({ title = "Player", icon = "👤", open = true })
	me:AddRow({ label = "Username", value = player.Name })
	me:AddRow({ label = "Display name", value = player.DisplayName })
	me:AddRow({ label = "User ID", value = tostring(player.UserId) })
	me:AddRow({ label = "Account age", value = player.AccountAge .. " days" })

	local perf = page:AddPanel({ title = "Performance", icon = "📈", open = true })
	local frames, lastT = 0, os.clock()
	table.insert(self._conns, RunService.Heartbeat:Connect(function()
		frames += 1
	end))
	live(perf, "FPS", "...", function()
		local now = os.clock()
		local fps = frames / math.max(now - lastT, 0.001)
		frames, lastT = 0, now
		return string.format("%d", math.floor(fps + 0.5))
	end)
	live(perf, "Ping", "...", function()
		local ok, ms = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		return ok and (string.format("%d", math.floor(ms + 0.5)) .. " ms") or "n/a"
	end)
	live(perf, "Session time", "0:00:00", function()
		local s = os.time() - self._startTime
		return string.format("%d:%02d:%02d", s // 3600, s % 3600 // 60, s % 60)
	end)

	local srv = page:AddPanel({ title = "Game & server", icon = "🌐", open = false })
	local _, gameName = srv:AddRow({ label = "Game", value = game.Name })
	task.spawn(function()
		local ok, product = pcall(function()
			return MarketplaceService:GetProductInfo(game.PlaceId)
		end)
		if ok and product and product.Name then
			gameName.Text = product.Name
		end
	end)
	srv:AddRow({ label = "Place ID", value = tostring(game.PlaceId) })
	srv:AddRow({ label = "Server ID", value = game.JobId ~= "" and string.sub(game.JobId, 1, 8) or "Studio" })
	live(srv, "Players", "", function()
		return #Players:GetPlayers() .. " / " .. Players.MaxPlayers
	end)

	local keys = page:AddPanel({ title = "Shortcuts", icon = "⌨️", open = false })
	live(keys, "Show / hide window", self.settings.toggleKey, function()
		return self.settings.toggleKey
	end)
