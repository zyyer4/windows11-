    header.Name = "Header"
    header.BackgroundTransparency = 1
    header.Size = UDim2.new(1, 0, 0, 70)
    header.Parent = root
    self.Header = header
    makeDraggable(header, root)

    -- Functional traffic lights. No symbols inside them.
