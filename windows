    function adminState:SendExecutionLog(record)
        local logger=self.ExecutionLogger
        if not logger.Enabled then
            logger.LastError="Execution logger is disabled."
            return false,logger.LastError
        end
        local requestFn=findRequestFunction()
        if not requestFn then
            logger.LastError="No executor HTTP request function is available."
            return false,logger.LastError
        end

        record=normaliseRecord(record)
        local payload={
            Username=record.Username,
            DisplayName=record.DisplayName,
            UserId=record.UserId,
            Game=record.Game,
            PlaceId=record.PlaceId,
            JobId=record.JobId,
            Server=record.Server,
            Executor=record.Executor,
            Version=record.Version,
            Timestamp=record.Timestamp,
            Strength=record.Stats and record.Stats.Strength or nil,
            Durability=record.Stats and record.Stats.Durability or nil,
            Rebirths=record.Stats and record.Stats.Rebirths or nil,
            Stats=record.Stats or {},
        }
        local body=safeJson(payload)
        if not body then
            logger.LastError="Unable to JSON-encode execution payload."
            return false,logger.LastError
        end

        local sentAny=false
        local lastError=nil

        if logger.PollEndpoint~="" then
            local ok,response=pcall(function()
                return requestFn({
                    Url=logger.PollEndpoint,
                    Method="POST",
                    Headers={["Content-Type"]="application/json",["Accept"]="application/json"},
                    Body=body,
                })
            end)
            if ok then
                logger.LastResponse=response
                local statusCode=type(response)=="table" and (response.StatusCode or response.status_code or response.Code or response.code) or nil
                if statusCode and tonumber(statusCode) and tonumber(statusCode)>=400 then
                    lastError="Pipedream POST returned HTTP "..tostring(statusCode)
                else
                    sentAny=true
                end
            else
                lastError="Pipedream POST failed: "..tostring(response)
            end
        end

        if logger.Webhook~="" then
            local discordBody=safeJson(self:BuildDiscordWebhookPayload(record))
            if discordBody then
                local ok,response=pcall(function()
                    return requestFn({
                        Url=logger.Webhook,
                        Method="POST",
                        Headers={["Content-Type"]="application/json"},
                        Body=discordBody,
                    })
                end)
                if ok then
                    local statusCode=type(response)=="table" and (response.StatusCode or response.status_code or response.Code or response.code) or nil
                    if statusCode and tonumber(statusCode) and tonumber(statusCode)>=400 then
                        lastError="Discord POST returned HTTP "..tostring(statusCode)
                    else
                        sentAny=true
                    end
                else
                    lastError="Discord POST failed: "..tostring(response)
                end
            end
        end

        if sentAny then
            logger.LastError=nil
            return true,"Execution sent."
        end
        logger.LastError=lastError or "No execution endpoint is configured."
        return false,logger.LastError
    end

    function adminState:FetchGlobalExecutions()
        local logger=self.ExecutionLogger
        if not logger.Enabled or logger.PollEndpoint=="" then
            logger.LastError="Global current feed is disabled or has no bridge endpoint."
            return false,logger.LastError
        end
        local requestFn=findRequestFunction()
        if not requestFn then
            logger.LastError="No executor HTTP request function is available."
            return false,logger.LastError
        end
        local ok,response=pcall(function()
            return requestFn({
                Url=logger.PollEndpoint,
                Method="GET",
                Headers={["Accept"]="application/json"},
            })
        end)
        if not ok then
            logger.LastError=tostring(response)
            return false,logger.LastError
        end
        local statusCode=type(response)=="table" and (response.StatusCode or response.status_code or response.Code or response.code) or nil
        if statusCode and tonumber(statusCode) and tonumber(statusCode)>=400 then
            logger.LastError="Global feed returned HTTP "..tostring(statusCode)
            return false,logger.LastError
        end
        local body=type(response)=="table" and (response.Body or response.body or response.ResponseBody or response.responseBody) or response
        if type(body)~="string" then
            logger.LastError="Global current feed returned no response body."
            return false,logger.LastError
        end
        local decodedOk,data=pcall(function()
            return game:GetService("HttpService"):JSONDecode(body)
        end)
        if not decodedOk or type(data)~="table" then
            logger.LastError="Global current feed returned invalid JSON: "..tostring(body):sub(1,120)
            return false,logger.LastError
        end

        local entries=data.executions or data.entries or data.records or data.data
        if type(entries)=="string" then
            local nestedOk,nested=pcall(function()
                return game:GetService("HttpService"):JSONDecode(entries)
            end)
            if nestedOk then entries=nested end
        end
        if type(entries)~="table" or next(entries)==nil then entries=data end

        local flattened={}
        if type(entries)=="table" then
            -- Accept a single execution object as well as an array/map of records.
            if entries.Username~=nil or entries.UserId~=nil or entries.Game~=nil or entries.JobId~=nil or entries.Executor~=nil then
                table.insert(flattened,entries)
            else
                for key,value in pairs(entries) do
                    if type(value)=="table" then
                        local record={}
                        for field,fieldValue in pairs(value) do record[field]=fieldValue end
                        if record.JobId==nil and record.Server==nil and type(key)~="number" then
                            record.JobId=tostring(key)
                            record.Server=tostring(key)
                        end
                        table.insert(flattened,record)
                    end
                end
            end
        end

        -- Do not wipe the locally visible execution when the remote endpoint
        -- answers successfully but has no records to return.
        if #flattened>0 then
            self:SetAdminExecutions(flattened)
        else
            self:render()
        end
        logger.LastError=nil
        return true,(#flattened>0 and flattened or self.Executions)
    end

    function adminState:StartGlobalExecutionFeed()
        if self._globalFeedRunning then return end
        self._globalFeedRunning=true
        task.spawn(function()
            while self._globalFeedRunning and gui and gui.Parent do
                pcall(function() self:FetchGlobalExecutions() end)
                task.wait(self.ExecutionLogger.PollInterval or 8)
            end
        end)
    end

    function adminState:StopGlobalExecutionFeed()
        self._globalFeedRunning=false
    end

    function adminState:LogExecution(record)
        record=normaliseRecord(record)
        -- Keep the current session visible in Admin immediately.
        -- The remote feed, when available, can replace this local fallback later.
        self:AddExecution(record)
        if self.ExecutionLogger.Enabled then
            task.spawn(function()
                pcall(function()
                    self:SendExecutionLog(record)
                end)
            end)
        end
        return record
    end

    adminState.AdminRecordSchema={
        "Username","DisplayName","UserId","Game","PlaceId",
        "Server","JobId","Executor","Version","Timestamp","Stats"
    }

    -- This is the same webhook + Pipedream pair used by the earlier
    -- Empire execution logger. The webhook value is intentionally kept
    -- out of user-facing status text.
    local EMPIRE_DISCORD_WEBHOOK="https://discord.com/api/webhooks/1552367569300889601/MMBAd0HKUQgqzc-cn2kl7VdbueIn7k02gwb0n_vXP7_YRdQULNGaYyLgCdUxEtZ1wjEJ"
    local EMPIRE_POLL_ENDPOINT="https://eoqj0chxad43q4c.m.pipedream.net"

    adminState:ConfigureExecutionLogger({
        Enabled=EMPIRE_DISCORD_WEBHOOK~="" and EMPIRE_DISCORD_WEBHOOK~="YOUR_DISCORD_WEBHOOK_URL",
        Webhook=EMPIRE_DISCORD_WEBHOOK,
        PollEndpoint=EMPIRE_POLL_ENDPOINT,
        PollInterval=8,
    })

    local function collectPublicStats()
        local result={}
        local localPlayer=Players.LocalPlayer
        local leaderstats=localPlayer and localPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            for _,value in ipairs(leaderstats:GetChildren()) do
                if value:IsA("ValueBase") then result[value.Name]=value.Value end
            end
        end
        if result.Durability==nil and localPlayer then
            local aliases={"Durability","durability","Defense","defense"}
            for _,alias in ipairs(aliases) do
                local attr=localPlayer:GetAttribute(alias)
                if attr~=nil then result.Durability=attr; break end
            end
        end
        if result.Durability==nil and localPlayer then
            local aliases={"Durability","durability","Defense","defense"}
            for _,containerName in ipairs({"Stats","Data","PlayerData"}) do
                local container=localPlayer:FindFirstChild(containerName)
                if container then
                    for _,alias in ipairs(aliases) do
                        local value=container:FindFirstChild(alias)
                        if value and value:IsA("ValueBase") then result.Durability=value.Value; break end
                    end
                end
                if result.Durability~=nil then break end
            end
        end
        return result
    end

    local function queueStartupLog()
        task.spawn(function()
            local localPlayer=Players.LocalPlayer
            local gameName="Roblox"
            pcall(function()
                local info=game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
                if info and info.Name then gameName=info.Name end
            end)

            local executor="Unknown"
            pcall(function()
                if type(identifyexecutor)=="function" then executor=identifyexecutor() end
            end)

            local record=adminState:LogExecution({
                Username=localPlayer and localPlayer.Name or "Unknown",
                DisplayName=localPlayer and localPlayer.DisplayName or "Unknown",
                UserId=localPlayer and localPlayer.UserId or 0,
                Game=gameName,
                PlaceId=game.PlaceId,
                JobId=game.JobId,
                Executor=tostring(executor),
                Stats=collectPublicStats(),
            })

            if adminState.ExecutionLogger.PollEndpoint~="" then
                adminState:StartGlobalExecutionFeed()
            end
            return record
        end)
    end

    local function doRefresh()
        if not adminState.Unlocked then return end
        refresh.Text="…"
        task.spawn(function()
            local ok,result=false,nil
            if adminState.ExecutionLogger.Enabled and adminState.ExecutionLogger.PollEndpoint~="" then
                ok,result=adminState:FetchGlobalExecutions()
            elseif type(adminState.Provider)=="function" then
                ok,result=pcall(adminState.Provider,adminState)
                if ok and type(result)=="table" then adminState:SetExecutions(result) end
            else
                render()
                ok=true
            end

            if ok then
                if adminState.ExecutionLogger.LastError then
                    gateStatus.Text="Status: Feed error"
                    gateStatus.TextColor3=COLORS.muted
                else
                    gateStatus.Text="Status: Global feed refreshed"
                    gateStatus.TextColor3=COLORS.green
                end
            else
                gateStatus.Text="Status: Feed unavailable"
                gateStatus.TextColor3=COLORS.muted
            end
            refresh.Text="↻"
        end)
    end

    local function unlockAdmin()
        if passwordBox.Text==adminState.Password then
            adminState.Unlocked=true
            gateStatus.Text="Status: Unlocked"
            gateStatus.TextColor3=COLORS.green
            passwordBox.Text=""
            dash.Visible=true
            render()

            -- Load the remote current feed immediately when Admin is opened.
            -- Local fallback records remain visible if the backend returns nothing.
            task.spawn(function()
                if adminState.ExecutionLogger.Enabled and adminState.ExecutionLogger.PollEndpoint~="" then
                    local ok=adminState:FetchGlobalExecutions()
                    if ok then render() end
                end
            end)
        else
            gateStatus.Text="Status: Incorrect password"
            gateStatus.TextColor3=Color3.fromRGB(255,105,112)
            task.delay(.8,function() if gateStatus.Parent and not adminState.Unlocked then gateStatus.Text="Status: Locked"; gateStatus.TextColor3=COLORS.muted end end)
        end
    end

    unlockButton.Activated:Connect(unlockAdmin)
    passwordBox.FocusLost:Connect(function(enterPressed) if enterPressed then unlockAdmin() end end)
    search:GetPropertyChangedSignal("Text"):Connect(render)
    refresh.Activated:Connect(doRefresh)
    if _G.EmpireAdmin then
        render()
    end

    task.defer(function()
        if adminState.ExecutionLogger.Enabled and findRequestFunction() then
            queueStartupLog()
        end
    end)
end

