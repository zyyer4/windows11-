local compactAntiLagEnabled = false

local function activateFastRebAntiLag()
    compactAntiLagEnabled = not compactAntiLagEnabled

    if compactAntiLagEnabled then
        -- Performance mode: remove expensive visual effects without deleting the
        -- player's UI, so the compact Mode window remains usable.
        for _, object in ipairs(Lighting:GetChildren()) do
            if object:IsA("Sky") or object:IsA("PostEffect") then
                pcall(function() object:Destroy() end)
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam")
                or obj:IsA("PointLight")
                or obj:IsA("SpotLight")
                or obj:IsA("SurfaceLight") then
                pcall(function() obj:Destroy() end)
            end
        end
    end
end


