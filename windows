        Theme.SubText
    )
    pageSubtitle.Position = UDim2.fromOffset(17, 34)
    pageSubtitle.Size = UDim2.new(1, -34, 0, 21)
    pageSubtitle.TextTruncate = Enum.TextTruncate.AtEnd
    self.PageSubtitle = pageSubtitle

    local pages = Instance.new("Frame")
    pages.Name = "Pages"
    pages.BackgroundTransparency = 1
    pages.Position = UDim2.fromOffset(0, 63)
    pages.Size = UDim2.new(1, 0, 1, -63)
    pages.Parent = content
    self.Pages = pages

    search:GetPropertyChangedSignal("Text"):Connect(function()
        self:_filterTabs(search.Text)
    end)

    -- Quality-of-life: RightShift toggles the shell without destroying it.
    self.ToggleKey = Enum.KeyCode.RightShift
    self._inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == self.ToggleKey then
            if self.IsMinimized then
                self:Restore()
            else
                self:Minimize()
            end
        elseif input.KeyCode == Enum.KeyCode.Escape and not self.IsMinimized then
            search:ReleaseFocus()
        end
    end)

    -- Close = destroy.
    closeButton.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    -- Minimize = compact "Open" pill like the supplied reference image.
    minimizeButton.MouseButton1Click:Connect(function()
        if self.IsMinimized then
            self:Restore()
        else
            self:Minimize()
        end
    end)

    -- Green = maximize / restore.
    maximizeButton.MouseButton1Click:Connect(function()
        self:ToggleMaximize()
    end)

    -- Small hover feedback while keeping the traffic lights symbol-free.
    for _, b in ipairs({closeButton, minimizeButton, maximizeButton}) do
        local normal = b.Size
        b.MouseEnter:Connect(function()
            tween(b, 0.10, {
                Size = UDim2.fromOffset(16, 16),
            })
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.10, {
                Size = normal,
            })
        end)
    end

    root.BackgroundTransparency = 1
    tween(root, 0.18, {BackgroundTransparency = 0.12})

    return self
end

function UI:Minimize()
    if self.IsMinimized then return end

    self.IsMinimized = true
    self.SavedPosition = self.Root.Position
    self.SavedSize = self.Root.Size

    local root = self.Root
    local gui = self.Gui

    -- Hide the shell and leave a compact dark "Open" pill.
    root.Visible = false

    if self.MinimizedButton then
        self.MinimizedButton:Destroy()
    end

    local open = Instance.new("TextButton")
    open.Name = "Open"
    open.AnchorPoint = Vector2.new(0.5, 0)
    open.Position = UDim2.fromScale(0.5, 0.045)
    open.Size = UDim2.fromOffset(122, 38)
    open.BackgroundColor3 = Color3.fromRGB(5, 7, 9)
    open.BackgroundTransparency = 0.04
    open.BorderSizePixel = 0
    open.AutoButtonColor = false
    open.Text = "Open"
    open.TextColor3 = Theme.Text
    open.TextSize = 14
    open.Font = Enum.Font.GothamSemibold
    open.Parent = gui
    corner(open, 18)
    stroke(open, Theme.Green, 0.25, 1)
    self.MinimizedButton = open
    makeDraggable(open, open)

    local openStroke = open:FindFirstChildOfClass("UIStroke")
    if openStroke then
        openStroke.Transparency = 0.12
    end

    local indicator = Instance.new("Frame")
    indicator.BackgroundColor3 = Theme.Green
    indicator.BorderSizePixel = 0
    indicator.Position = UDim2.fromOffset(12, 13)
    indicator.Size = UDim2.fromOffset(9, 9)
    indicator.Parent = open
    corner(indicator, 5)

    local crown = Instance.new("TextLabel")
    crown.BackgroundTransparency = 1
    crown.Text = "♛"
    crown.TextColor3 = Theme.Text
    crown.TextSize = 13
    crown.Font = Enum.Font.GothamBold
    crown.TextXAlignment = Enum.TextXAlignment.Center
    crown.TextYAlignment = Enum.TextYAlignment.Center
    crown.Position = UDim2.fromOffset(27, 0)
    crown.Size = UDim2.fromOffset(20, 38)
    crown.Parent = open

    open.MouseButton1Click:Connect(function()
        self:Restore()
    end)
end

function UI:Restore()
    if not self.IsMinimized then return end

    self.IsMinimized = false

    if self.MinimizedButton then
        self.MinimizedButton:Destroy()
        self.MinimizedButton = nil
    end

    self.Root.Visible = true
end

function UI:ToggleMaximize()
    if self.IsMinimized then
        self:Restore()
    end

    if not self.IsMaximized then
        self.SavedPosition = self.Root.Position
        self.SavedSize = self.Root.Size

        tween(self.Root, 0.20, {
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(0.90, 0.88),
        })

        self.IsMaximized = true
    else
        tween(self.Root, 0.20, {
            Position = self.SavedPosition or UDim2.fromScale(0.5, 0.5),
            Size = self.SavedSize or UDim2.fromScale(0.70, 0.76),
        })

        self.IsMaximized = false
    end
end

function UI:_filterTabs(query)
    query = string.lower(query or "")

    for _, tab in ipairs(self.Tabs) do
        local match = query == ""
            or string.find(string.lower(tab.Title), query, 1, true) ~= nil

        tab.Button.Visible = match
    end
end

function UI:AddTab(config)
    if type(config) == "string" then
        config = {Title = config}
    end
    config = config or {}

    local tab = {
        Window = self,
        Title = config.Title or ("Tab " .. tostring(#self.Tabs + 1)),
        Emoji = config.Emoji or "•",
        Description = config.Description or "",
        Accent = config.Accent or Theme.Green,
    }

    local button = Instance.new("TextButton")
    button.Name = tab.Title .. "_Tab"
    button.BackgroundColor3 = Theme.SurfaceSelected
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Text = ""
    button.Size = UDim2.new(1, 0, 0, 43)
    button.Parent = self.Navigation
    corner(button, 9)
    tab.Button = button

    -- Colored square with the requested emoji.
    local icon = Instance.new("TextLabel")
    icon.Name = "EmojiIcon"
    icon.BackgroundColor3 = tab.Accent
    icon.BackgroundTransparency = 0.02
