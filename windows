--[[
    AstrarServices / Windows 11 Layout
    ----------------------------------
    Layout-only Fluent-style shell.

    This version intentionally contains NO fake farming/stat/player features.
    It is only the UI foundation so you can build the pages yourself.

    API:
        local UI = loadstring(game:HttpGet("YOUR_RAW_URL"))()
        local Window = UI:CreateWindow({...})
        local Tab = Window:AddTab({...})
        Window:SelectTab(Tab)
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local UI = {}
UI.__index = UI

local Theme = {
    Window = Color3.fromRGB(15, 17, 20),
    Sidebar = Color3.fromRGB(12, 14, 17),
    Surface = Color3.fromRGB(22, 25, 29),
    SurfaceHover = Color3.fromRGB(29, 33, 38),
    SurfaceSelected = Color3.fromRGB(27, 31, 36),
    Border = Color3.fromRGB(57, 63, 71),
    Text = Color3.fromRGB(240, 242, 245),
    SubText = Color3.fromRGB(151, 158, 168),
    Muted = Color3.fromRGB(94, 101, 111),

    Red = Color3.fromRGB(255, 95, 87),
    Yellow = Color3.fromRGB(255, 189, 46),
    Green = Color3.fromRGB(40, 200, 64),

    Accent = Color3.fromRGB(77, 145, 255),
}

local TabColors = {
    Farming = Color3.fromRGB(78, 165, 255),
    Rebirth = Color3.fromRGB(255, 174, 71),
    Pets = Color3.fromRGB(194, 116, 255),
    Player = Color3.fromRGB(71, 205, 150),
    Killing = Color3.fromRGB(255, 82, 82),
    Stats = Color3.fromRGB(86, 145, 255),
    Tickets = Color3.fromRGB(255, 211, 71),
    Perf = Color3.fromRGB(115, 121, 132),
    Misc = Color3.fromRGB(169, 176, 188),
}

local function tween(obj, duration, properties)
    local ok, result = pcall(function()
        local t = TweenService:Create(
            obj,
            TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            properties
        )
        t:Play()
        return t
    end)
    return ok and result or nil
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function stroke(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Border
    s.Transparency = transparency == nil and 0.45 or transparency
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function padding(parent, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent
    return p
end

local function label(parent, text, size, color, font)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text or ""
    l.TextSize = size or 14
    l.TextColor3 = color or Theme.Text
    l.Font = font or Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Parent = parent
    return l
end

local function draggable(handle, object)
    local dragging = false
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = object.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        object.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

function UI:CreateWindow(config)
    config = config or {}

    -- Remove a previous copy when re-running the script.
    local parent = (gethui and gethui()) or game:GetService("CoreGui")
    local old = parent:FindFirstChild("AstrarServices_Win11")
    if old then
        old:Destroy()
    end

    local self = setmetatable({}, UI)
    self.Tabs = {}
    self.ActiveTab = nil

    local gui = Instance.new("ScreenGui")
    gui.Name = "AstrarServices_Win11"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999
    gui.Parent = parent
    self.Gui = gui

    -- A scale-based window prevents the old 980x650 fixed-size problem.
    -- It stays compact on a 1280x585 screen and adapts to other resolutions.
    local root = Instance.new("Frame")
    root.Name = "Window"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
    root.Size = config.Size or UDim2.fromScale(0.76, 0.82)
    root.BackgroundColor3 = Theme.Window
    root.BackgroundTransparency = 0.08
    root.BorderSizePixel = 0
    root.ClipsDescendants = true
    root.Parent = gui
    corner(root, 16)
    stroke(root, Theme.Border, 0.25, 1)
    self.Root = root

    -- Subtle dark glass gradient. No white background.
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(21, 24, 28)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(11, 13, 16)),
    })
    gradient.Rotation = 90
    gradient.Parent = root

    -- Header
    local header = Instance.new("Frame")
    header.Name = "Header"
    header.BackgroundTransparency = 1
    header.Size = UDim2.new(1, 0, 0, 72)
    header.Parent = root
    self.Header = header
    draggable(header, root)

    -- Traffic-light dots ONLY. No symbols and no minimize/close/maximize behavior.
    local traffic = Instance.new("Frame")
    traffic.BackgroundTransparency = 1
    traffic.Position = UDim2.fromOffset(20, 25)
    traffic.Size = UDim2.fromOffset(58, 16)
    traffic.Parent = header

    local trafficLayout = Instance.new("UIListLayout")
    trafficLayout.FillDirection = Enum.FillDirection.Horizontal
    trafficLayout.Padding = UDim.new(0, 8)
    trafficLayout.Parent = traffic

    for _, color in ipairs({Theme.Red, Theme.Yellow, Theme.Green}) do
        local dot = Instance.new("Frame")
        dot.Size = UDim2.fromOffset(14, 14)
        dot.BackgroundColor3 = color
        dot.BorderSizePixel = 0
        dot.Parent = traffic
        corner(dot, 7)
    end

    local title = label(
        header,
        config.Title or "Muscle Legends - V3.2.1 Private",
        18,
        Theme.Text,
        Enum.Font.GothamBold
    )
    title.Position = UDim2.fromOffset(96, 13)
    title.Size = UDim2.new(1, -120, 0, 25)
    title.TextTruncate = Enum.TextTruncate.AtEnd
    self.TitleLabel = title

    local subtitle = label(
        header,
        config.Subtitle or "AstrarServices",
        12,
        Theme.SubText,
        Enum.Font.Gotham
    )
    subtitle.Position = UDim2.fromOffset(96, 38)
    subtitle.Size = UDim2.new(1, -120, 0, 20)
    subtitle.TextTruncate = Enum.TextTruncate.AtEnd
    self.SubtitleLabel = subtitle

    local headerLine = Instance.new("Frame")
    headerLine.BackgroundColor3 = Theme.Border
    headerLine.BackgroundTransparency = 0.72
    headerLine.BorderSizePixel = 0
    headerLine.Position = UDim2.new(0, 18, 0, 71)
    headerLine.Size = UDim2.new(1, -36, 0, 1)
    headerLine.Parent = root

    -- Main body
    local body = Instance.new("Frame")
    body.Name = "Body"
    body.BackgroundTransparency = 1
    body.Position = UDim2.fromOffset(14, 84)
    body.Size = UDim2.new(1, -28, 1, -98)
    body.Parent = root

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.BackgroundColor3 = Theme.Sidebar
    sidebar.BackgroundTransparency = 0.16
    sidebar.BorderSizePixel = 0
    sidebar.Size = UDim2.new(0.245, 0, 1, 0)
    sidebar.Parent = body
    corner(sidebar, 13)
    stroke(sidebar, Theme.Border, 0.58)

    -- Search
    local search = Instance.new("TextBox")
    search.Name = "Search"
    search.BackgroundColor3 = Theme.Surface
    search.BackgroundTransparency = 0.18
    search.BorderSizePixel = 0
    search.ClearTextOnFocus = false
    search.PlaceholderText = "Search"
    search.PlaceholderColor3 = Theme.Muted
    search.Text = ""
    search.TextColor3 = Theme.Text
    search.TextSize = 13
    search.Font = Enum.Font.Gotham
    search.TextXAlignment = Enum.TextXAlignment.Left
    search.Position = UDim2.fromOffset(9, 9)
    search.Size = UDim2.new(1, -18, 0, 38)
    search.Parent = sidebar
    corner(search, 9)
    stroke(search, Theme.Border, 0.72)
    padding(search, 13, 0, 10, 0)
    self.SearchBox = search

    local nav = Instance.new("ScrollingFrame")
    nav.Name = "Navigation"
    nav.BackgroundTransparency = 1
    nav.BorderSizePixel = 0
    nav.Position = UDim2.fromOffset(8, 56)
    nav.Size = UDim2.new(1, -16, 1, -64)
    nav.ScrollBarThickness = 2
    nav.ScrollBarImageColor3 = Theme.Border
    nav.AutomaticCanvasSize = Enum.AutomaticSize.Y
    nav.CanvasSize = UDim2.new()
    nav.Parent = sidebar
    self.Navigation = nav

    local navLayout = Instance.new("UIListLayout")
    navLayout.Padding = UDim.new(0, 4)
    navLayout.SortOrder = Enum.SortOrder.LayoutOrder
    navLayout.Parent = nav

    -- Content
    local content = Instance.new("Frame")
    content.Name = "Content"
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0.245, 12, 0, 0)
    content.Size = UDim2.new(0.755, -12, 1, 0)
    content.Parent = body
    self.Content = content

    local pageTitle = label(
        content,
        config.ContentTitle or "Stats",
        24,
        Theme.Text,
        Enum.Font.GothamBold
    )
    pageTitle.Position = UDim2.fromOffset(18, 2)
    pageTitle.Size = UDim2.new(1, -36, 0, 32)
    self.PageTitle = pageTitle

    local pageSubtitle = label(
        content,
        config.ContentSubtitle or "Select a tab to begin building your interface.",
        12,
        Theme.SubText
    )
    pageSubtitle.Position = UDim2.fromOffset(18, 34)
    pageSubtitle.Size = UDim2.new(1, -36, 0, 22)
    pageSubtitle.TextTruncate = Enum.TextTruncate.AtEnd
    self.PageSubtitle = pageSubtitle

    local pages = Instance.new("Frame")
    pages.Name = "Pages"
    pages.BackgroundTransparency = 1
    pages.Position = UDim2.fromOffset(0, 65)
    pages.Size = UDim2.new(1, 0, 1, -65)
    pages.Parent = content
    self.Pages = pages

    -- Search behavior
    search:GetPropertyChangedSignal("Text"):Connect(function()
        self:_filterTabs(search.Text)
    end)

    -- Small open animation without changing the final layout size.
    root.BackgroundTransparency = 1
    tween(root, 0.18, {BackgroundTransparency = 0.08})

    return self
end

function UI:_filterTabs(query)
    query = string.lower(query or "")

    for _, tab in ipairs(self.Tabs) do
        local matches = query == "" or string.find(string.lower(tab.Title), query, 1, true) ~= nil
        tab.Button.Visible = matches
    end
end

function UI:AddTab(config)
    config = config or {}

    local tab = {
        Window = self,
        Title = config.Title or ("Tab " .. tostring(#self.Tabs + 1)),
        Description = config.Description or "",
        Accent = config.Accent or TabColors[config.Title] or Theme.Accent,
    }

    -- Navigation row
    local button = Instance.new("TextButton")
    button.Name = tab.Title .. "_Tab"
    button.BackgroundColor3 = Theme.SurfaceSelected
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Text = ""
    button.Size = UDim2.new(1, 0, 0, 43)
    button.Parent = self.Navigation
    corner(button, 9)
    tab.Button = button

    -- Colored square icon: color carries the meaning, no icon glyph needed.
    local icon = Instance.new("Frame")
    icon.Name = "ColorIcon"
    icon.BackgroundColor3 = tab.Accent
    icon.BorderSizePixel = 0
    icon.Position = UDim2.fromOffset(10, 9)
    icon.Size = UDim2.fromOffset(25, 25)
    icon.Parent = button
    corner(icon, 7)
    tab.Icon = icon

    local tabLabel = label(button, tab.Title, 13, Theme.SubText, Enum.Font.GothamMedium)
    tabLabel.Position = UDim2.fromOffset(47, 0)
    tabLabel.Size = UDim2.new(1, -56, 1, 0)
    tabLabel.TextTruncate = Enum.TextTruncate.AtEnd
    tab.Label = tabLabel

    local selected = Instance.new("Frame")
    selected.Name = "SelectedBar"
    selected.BackgroundColor3 = tab.Accent
    selected.BorderSizePixel = 0
    selected.Position = UDim2.new(0, 0, 0.5, -12)
    selected.Size = UDim2.fromOffset(3, 24)
    selected.Visible = false
    selected.Parent = button
    corner(selected, 2)
    tab.SelectedBar = selected

    -- Empty page. This is intentional: build your own content here.
    local page = Instance.new("ScrollingFrame")
    page.Name = tab.Title .. "_Page"
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Size = UDim2.new(1, 0, 1, 0)
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Theme.Border
    page.Visible = false
    page.Parent = self.Pages
    tab.Page = page

    local pagePadding = padding(page, 18, 10, 18, 18)
    tab.PagePadding = pagePadding

    -- Minimal fluent-style section helper for future building.
    function tab:AddSection(title)
        local section = {
            Tab = tab,
            Window = self,
        }

        local card = Instance.new("Frame")
        card.Name = "Section"
        card.BackgroundColor3 = Theme.Surface
        card.BackgroundTransparency = 0.28
        card.BorderSizePixel = 0
        card.Size = UDim2.new(1, 0, 0, 0)
        card.AutomaticSize = Enum.AutomaticSize.Y
        card.Parent = page
        corner(card, 11)
        stroke(card, Theme.Border, 0.72)

        local sectionTitle = label(card, title or "Section", 14, Theme.Text, Enum.Font.GothamSemibold)
        sectionTitle.Position = UDim2.fromOffset(14, 11)
        sectionTitle.Size = UDim2.new(1, -28, 0, 22)

        local placeholder = label(
            card,
            "",
            12,
            Theme.SubText
        )
        placeholder.Position = UDim2.fromOffset(14, 35)
        placeholder.Size = UDim2.new(1, -28, 0, 1)

        local list = Instance.new("UIListLayout")
        list.Padding = UDim.new(0, 8)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = card

        padding(card, 14, 10, 14, 14)

        section.Frame = card
        section.Title = sectionTitle
        section.Layout = list

        return section
    end

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {BackgroundTransparency = 0.72})
        end
    end)

    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {BackgroundTransparency = 1})
        end
    end)

    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function UI:SelectTab(tab)
    if not tab then
        return
    end

    self.ActiveTab = tab

    for _, item in ipairs(self.Tabs) do
        local active = item == tab

        item.Page.Visible = active
        item.SelectedBar.Visible = active

        if active then
            tween(item.Button, 0.14, {
                BackgroundTransparency = 0.16,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.Text,
            })
        else
            tween(item.Button, 0.14, {
                BackgroundTransparency = 1,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.SubText,
            })
        end
    end

    self.PageTitle.Text = tab.Title
    self.PageSubtitle.Text = tab.Description ~= "" and tab.Description
        or "Build this page using the Fluent-style API."
end

function UI:SetTitle(title, subtitle)
    if title then
        self.TitleLabel.Text = title
    end
    if subtitle then
        self.SubtitleLabel.Text = subtitle
    end
end

function UI:Destroy()
    if self.Gui then
        self.Gui:Destroy()
    end
end

