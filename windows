local function tween(object, duration, properties)
    local ok, result = pcall(function()
        local t = TweenService:Create(
            object,
            TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            properties
        )
        t:Play()
        return t
    end)
    return ok and result or nil
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function stroke(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Border
    s.Transparency = transparency == nil and 0.45 or transparency
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function padding(parent, left, top, right, bottom)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, left or 0)
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.Parent = parent
    return p
end

local function text(parent, value, size, color, font)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = value or ""
    l.TextSize = size or 14
    l.TextColor3 = color or Theme.Text
    l.Font = font or Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Parent = parent
    return l
end

local function makeDraggable(handle, object)
    local dragging = false
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = object.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        object.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

function UI:CreateWindow(config)
    config = config or {}

    local parent = (gethui and gethui()) or game:GetService("CoreGui")

    local old = parent:FindFirstChild("AstrarServices_Win11")
    if old then
        old:Destroy()
    end

    local self = setmetatable({}, UI)
    self.Tabs = {}
    self.ActiveTab = nil
    self.IsMinimized = false
    self.IsMaximized = false

    local gui = Instance.new("ScreenGui")
    gui.Name = "AstrarServices_Win11"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999
    gui.Parent = parent
    self.Gui = gui

    -- Responsive shell. Dark translucent black, not white.
    local root = Instance.new("Frame")
    root.Name = "Window"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
    root.Size = config.Size or UDim2.fromScale(0.70, 0.76)
    root.BackgroundColor3 = Theme.Window
    root.BackgroundTransparency = 0.12
    root.BorderSizePixel = 0
    root.ClipsDescendants = true
    root.Parent = gui
    corner(root, 15)
    stroke(root, Theme.Border, 0.28, 1)
    self.Root = root

    -- Very subtle black glass gradient.
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.WindowTop),
        ColorSequenceKeypoint.new(0.48, Theme.Window),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(4, 5, 7)),
    })
    gradient.Rotation = 90
    gradient.Parent = root

    -- Header
    local header = Instance.new("Frame")
    header.Name = "Header"
    header.BackgroundTransparency = 1
    header.Size = UDim2.new(1, 0, 0, 70)
    header.Parent = root
    self.Header = header
    makeDraggable(header, root)

    -- Functional traffic lights. No symbols inside them.
    local traffic = Instance.new("Frame")
    traffic.Name = "TrafficLights"
    traffic.BackgroundTransparency = 1
    traffic.Position = UDim2.fromOffset(20, 26)
    traffic.Size = UDim2.fromOffset(58, 16)
    traffic.Parent = header

    local trafficLayout = Instance.new("UIListLayout")
    trafficLayout.FillDirection = Enum.FillDirection.Horizontal
    trafficLayout.Padding = UDim.new(0, 8)
    trafficLayout.Parent = traffic

    local function trafficButton(color, name)
        local b = Instance.new("TextButton")
        b.Name = name
        b.Text = ""
        b.AutoButtonColor = false
        b.BackgroundColor3 = color
        b.BorderSizePixel = 0
        b.Size = UDim2.fromOffset(14, 14)
        b.Parent = traffic
        corner(b, 7)
        return b
    end

    local closeButton = trafficButton(Theme.Red, "Close")
    local minimizeButton = trafficButton(Theme.Yellow, "Minimize")
    local maximizeButton = trafficButton(Theme.Green, "Maximize")

    self.CloseButton = closeButton
    self.MinimizeButton = minimizeButton
    self.MaximizeButton = maximizeButton

    local title = text(
        header,
        config.Title or "Muscle Legends - V3.2.1 Private",
        18,
        Theme.Text,
        Enum.Font.GothamBold
    )
    title.Position = UDim2.fromOffset(96, 12)
    title.Size = UDim2.new(1, -118, 0, 26)
    title.TextTruncate = Enum.TextTruncate.AtEnd
    self.TitleLabel = title

    local subtitle = text(
        header,
        config.Subtitle or "AstrarServices",
        12,
        Theme.SubText
    )
    subtitle.Position = UDim2.fromOffset(96, 38)
    subtitle.Size = UDim2.new(1, -118, 0, 20)
    subtitle.TextTruncate = Enum.TextTruncate.AtEnd
    self.SubtitleLabel = subtitle

    local line = Instance.new("Frame")
    line.BackgroundColor3 = Theme.Border
    line.BackgroundTransparency = 0.70
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 17, 0, 69)
    line.Size = UDim2.new(1, -34, 0, 1)
    line.Parent = root

    -- Body
    local body = Instance.new("Frame")
    body.Name = "Body"
    body.BackgroundTransparency = 1
    body.Position = UDim2.fromOffset(13, 82)
    body.Size = UDim2.new(1, -26, 1, -95)
    body.Parent = root

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.BackgroundColor3 = Theme.Sidebar
    sidebar.BackgroundTransparency = 0.18
    sidebar.BorderSizePixel = 0
    sidebar.Size = UDim2.new(0.24, 0, 1, 0)
    sidebar.Parent = body
    corner(sidebar, 12)
    stroke(sidebar, Theme.Border, 0.62)

    local search = Instance.new("TextBox")
    search.Name = "Search"
    search.BackgroundColor3 = Theme.Surface
    search.BackgroundTransparency = 0.20
    search.BorderSizePixel = 0
    search.ClearTextOnFocus = false
    search.PlaceholderText = "Search"
    search.PlaceholderColor3 = Theme.Muted
    search.Text = ""
    search.TextColor3 = Theme.Text
    search.TextSize = 13
    search.Font = Enum.Font.Gotham
    search.TextXAlignment = Enum.TextXAlignment.Left
    search.Position = UDim2.fromOffset(9, 9)
    search.Size = UDim2.new(1, -18, 0, 37)
    search.Parent = sidebar
    corner(search, 9)
    stroke(search, Theme.Border, 0.72)
    padding(search, 13, 0, 10, 0)
    self.SearchBox = search

    local nav = Instance.new("ScrollingFrame")
    nav.Name = "Navigation"
    nav.BackgroundTransparency = 1
    nav.BorderSizePixel = 0
    nav.Position = UDim2.fromOffset(8, 54)
    nav.Size = UDim2.new(1, -16, 1, -61)
    nav.ScrollBarThickness = 2
    nav.ScrollBarImageColor3 = Theme.Border
    nav.AutomaticCanvasSize = Enum.AutomaticSize.Y
    nav.CanvasSize = UDim2.new()
    nav.Parent = sidebar
    self.Navigation = nav

    local navLayout = Instance.new("UIListLayout")
    navLayout.Padding = UDim.new(0, 4)
    navLayout.SortOrder = Enum.SortOrder.LayoutOrder
    navLayout.Parent = nav

    -- Content
    local content = Instance.new("Frame")
    content.Name = "Content"
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0.24, 12, 0, 0)
    content.Size = UDim2.new(0.76, -12, 1, 0)
    content.Parent = body
    self.Content = content

    local pageTitle = text(
        content,
        config.ContentTitle or "Stats",
        24,
        Theme.Text,
        Enum.Font.GothamBold
    )
    pageTitle.Position = UDim2.fromOffset(17, 2)
    pageTitle.Size = UDim2.new(1, -34, 0, 31)
    self.PageTitle = pageTitle

    local pageSubtitle = text(
        content,
        config.ContentSubtitle or "Select a tab to begin building your interface.",
        12,
        Theme.SubText
    )
    pageSubtitle.Position = UDim2.fromOffset(17, 34)
    pageSubtitle.Size = UDim2.new(1, -34, 0, 21)
    pageSubtitle.TextTruncate = Enum.TextTruncate.AtEnd
    self.PageSubtitle = pageSubtitle

    local pages = Instance.new("Frame")
    pages.Name = "Pages"
    pages.BackgroundTransparency = 1
    pages.Position = UDim2.fromOffset(0, 63)
    pages.Size = UDim2.new(1, 0, 1, -63)
    pages.Parent = content
    self.Pages = pages

    search:GetPropertyChangedSignal("Text"):Connect(function()
        self:_filterTabs(search.Text)
    end)

    -- Close = destroy.
    closeButton.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    -- Minimize = compact "Open" pill like the supplied reference image.
    minimizeButton.MouseButton1Click:Connect(function()
        if self.IsMinimized then
            self:Restore()
        else
            self:Minimize()
        end
    end)

    -- Green = maximize / restore.
    maximizeButton.MouseButton1Click:Connect(function()
        self:ToggleMaximize()
    end)

    -- Small hover feedback while keeping the traffic lights symbol-free.
    for _, b in ipairs({closeButton, minimizeButton, maximizeButton}) do
        local normal = b.Size
        b.MouseEnter:Connect(function()
            tween(b, 0.10, {
                Size = UDim2.fromOffset(16, 16),
            })
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.10, {
                Size = normal,
            })
        end)
    end

    root.BackgroundTransparency = 1
    tween(root, 0.18, {BackgroundTransparency = 0.12})

    return self
end

function UI:Minimize()
    if self.IsMinimized then return end

    self.IsMinimized = true
    self.SavedPosition = self.Root.Position
    self.SavedSize = self.Root.Size

    local root = self.Root
    local gui = self.Gui

    -- Hide the shell and leave a compact dark "Open" pill.
    root.Visible = false

    if self.MinimizedButton then
        self.MinimizedButton:Destroy()
    end

    local open = Instance.new("TextButton")
    open.Name = "Open"
    open.AnchorPoint = Vector2.new(0.5, 1)
    open.Position = UDim2.fromScale(0.5, 0.96)
    open.Size = UDim2.fromOffset(112, 36)
    open.BackgroundColor3 = Color3.fromRGB(8, 10, 12)
    open.BackgroundTransparency = 0.08
    open.BorderSizePixel = 0
    open.AutoButtonColor = false
    open.Text = "Open"
    open.TextColor3 = Theme.Text
    open.TextSize = 14
    open.Font = Enum.Font.GothamSemibold
    open.Parent = gui
    corner(open, 18)
    stroke(open, Theme.Green, 0.25, 1)
    self.MinimizedButton = open

    local indicator = Instance.new("Frame")
    indicator.BackgroundColor3 = Theme.Green
    indicator.BorderSizePixel = 0
    indicator.Position = UDim2.fromOffset(12, 13)
    indicator.Size = UDim2.fromOffset(10, 10)
    indicator.Parent = open
    corner(indicator, 5)

    open.MouseButton1Click:Connect(function()
        self:Restore()
    end)
end

function UI:Restore()
    if not self.IsMinimized then return end

    self.IsMinimized = false

    if self.MinimizedButton then
        self.MinimizedButton:Destroy()
        self.MinimizedButton = nil
    end

    self.Root.Visible = true
end

function UI:ToggleMaximize()
    if self.IsMinimized then
        self:Restore()
    end

    if not self.IsMaximized then
        self.SavedPosition = self.Root.Position
        self.SavedSize = self.Root.Size

        tween(self.Root, 0.20, {
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(0.90, 0.88),
        })

        self.IsMaximized = true
    else
        tween(self.Root, 0.20, {
            Position = self.SavedPosition or UDim2.fromScale(0.5, 0.5),
            Size = self.SavedSize or UDim2.fromScale(0.70, 0.76),
        })

        self.IsMaximized = false
    end
end

function UI:_filterTabs(query)
    query = string.lower(query or "")

    for _, tab in ipairs(self.Tabs) do
        local match = query == ""
            or string.find(string.lower(tab.Title), query, 1, true) ~= nil

        tab.Button.Visible = match
    end
end

function UI:AddTab(config)
    config = config or {}

    local tab = {
        Window = self,
        Title = config.Title or ("Tab " .. tostring(#self.Tabs + 1)),
        Emoji = config.Emoji or "•",
        Description = config.Description or "",
        Accent = config.Accent or Theme.Green,
    }

    local button = Instance.new("TextButton")
    button.Name = tab.Title .. "_Tab"
    button.BackgroundColor3 = Theme.SurfaceSelected
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Text = ""
    button.Size = UDim2.new(1, 0, 0, 43)
    button.Parent = self.Navigation
    corner(button, 9)
    tab.Button = button

    -- Colored square with the requested emoji.
    local icon = Instance.new("TextLabel")
    icon.Name = "EmojiIcon"
    icon.BackgroundColor3 = tab.Accent
    icon.BackgroundTransparency = 0.02
    icon.BorderSizePixel = 0
    icon.Text = tab.Emoji
    icon.TextSize = 15
    icon.TextColor3 = Color3.fromRGB(255, 255, 255)
    icon.Font = Enum.Font.GothamBold
    icon.TextXAlignment = Enum.TextXAlignment.Center
    icon.TextYAlignment = Enum.TextYAlignment.Center
    icon.Position = UDim2.fromOffset(9, 8)
    icon.Size = UDim2.fromOffset(27, 27)
    icon.Parent = button
    corner(icon, 7)
    tab.Icon = icon

    local tabLabel = text(
        button,
        tab.Title,
        13,
        Theme.SubText,
        Enum.Font.GothamMedium
    )
    tabLabel.Position = UDim2.fromOffset(48, 0)
    tabLabel.Size = UDim2.new(1, -57, 1, 0)
    tabLabel.TextTruncate = Enum.TextTruncate.AtEnd
    tab.Label = tabLabel

    local selected = Instance.new("Frame")
    selected.Name = "SelectedBar"
    selected.BackgroundColor3 = tab.Accent
    selected.BorderSizePixel = 0
    selected.Position = UDim2.new(0, 0, 0.5, -12)
    selected.Size = UDim2.fromOffset(3, 24)
    selected.Visible = false
    selected.Parent = button
    corner(selected, 2)
    tab.SelectedBar = selected

    -- Empty page by design.
    local page = Instance.new("ScrollingFrame")
    page.Name = tab.Title .. "_Page"
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Size = UDim2.new(1, 0, 1, 0)
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Theme.Border
    page.Visible = false
    page.Parent = self.Pages
    tab.Page = page

    padding(page, 18, 10, 18, 18)

    -- Fluent-style foundation for future content.
    function tab:AddSection(titleValue)
        local section = {
            Tab = tab,
            Window = self,
        }

        local card = Instance.new("Frame")
        card.Name = "Section"
        card.BackgroundColor3 = Theme.Surface
        card.BackgroundTransparency = 0.25
        card.BorderSizePixel = 0
        card.Size = UDim2.new(1, 0, 0, 70)
        card.Parent = page
        corner(card, 11)
        stroke(card, Theme.Border, 0.70)

        local heading = text(
            card,
            titleValue or "Section",
            14,
            Theme.Text,
            Enum.Font.GothamSemibold
        )
        heading.Position = UDim2.fromOffset(14, 9)
        heading.Size = UDim2.new(1, -28, 0, 23)

        section.Frame = card
        section.Title = heading

        return section
    end

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {
                BackgroundTransparency = 0.72,
            })
        end
    end)

    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, {
                BackgroundTransparency = 1,
            })
        end
    end)

    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function UI:SelectTab(tab)
    if not tab then return end

    self.ActiveTab = tab

    for _, item in ipairs(self.Tabs) do
        local active = item == tab

        item.Page.Visible = active
        item.SelectedBar.Visible = active

        if active then
            tween(item.Button, 0.14, {
                BackgroundTransparency = 0.14,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.Text,
            })
        else
            tween(item.Button, 0.14, {
                BackgroundTransparency = 1,
            })
            tween(item.Label, 0.14, {
                TextColor3 = Theme.SubText,
            })
        end
    end

    self.PageTitle.Text = tab.Title
    self.PageSubtitle.Text =
        tab.Description ~= "" and tab.Description
        or "Build this page using the Fluent-style API."
end

function UI:SetTitle(titleValue, subtitleValue)
    if titleValue then
        self.TitleLabel.Text = titleValue
    end
    if subtitleValue then
        self.SubtitleLabel.Text = subtitleValue
    end
end

function UI:Destroy()
    if self.Gui then
        self.Gui:Destroy()
    end
end

