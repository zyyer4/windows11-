            username.Position = UDim2.fromOffset(12, 6)
            username.Size = UDim2.new(0.45, 0, 0, 20)

            local displayName = adminText(card, tostring(record.DisplayName or ""), 10, "textDim", Enum.Font.Gotham)
            displayName.Position = UDim2.fromOffset(12, 27)
            displayName.Size = UDim2.new(0.45, 0, 0, 17)

            local userId = adminText(card, "UserId: " .. tostring(record.UserId or "-"), 10, "textFaint", Enum.Font.Gotham)
            userId.Position = UDim2.fromOffset(12, 47)
            userId.Size = UDim2.new(0.45, 0, 0, 17)

            local gameInfo = adminText(card, tostring(record.Game or "Unknown Game"), 11, "text", Enum.Font.GothamMedium)
            gameInfo.Position = UDim2.new(0.45, 0, 0, 6)
            gameInfo.Size = UDim2.new(0.55, -12, 0, 20)
            gameInfo.TextTruncate = Enum.TextTruncate.AtEnd

            local serverInfo = adminText(card, "Server: " .. tostring(record.Server or record.JobId or "-"), 9, "textDim", Enum.Font.Gotham)
            serverInfo.Position = UDim2.new(0.45, 0, 0, 27)
            serverInfo.Size = UDim2.new(0.55, -12, 0, 17)
            serverInfo.TextTruncate = Enum.TextTruncate.AtEnd

            local versionInfo = adminText(card, "Version: " .. tostring(record.Version or "-"), 9, "textFaint", Enum.Font.Gotham)
            versionInfo.Position = UDim2.new(0.45, 0, 0, 45)
            versionInfo.Size = UDim2.new(0.55, -12, 0, 17)

            local statsInfo = adminText(card, stringifyStats(record.Stats), 9, "textDim", Enum.Font.Gotham)
            statsInfo.Position = UDim2.fromOffset(12, 68)
            statsInfo.Size = UDim2.new(1, -24, 0, 16)
            statsInfo.TextTruncate = Enum.TextTruncate.AtEnd
        end
    end

    local function tryUnlock()
        if passwordBox.Text == ADMIN_PASSWORD then
            adminUnlocked = true
            status.Text = "Unlocked"
            status.TextColor3 = adminPage.window.theme.accent
            passwordBox.Text = ""
            gate.Visible = false
            dashboard.Visible = true
            renderExecutions()
        else
            adminUnlocked = false
            status.Text = "Incorrect password"
            status.TextColor3 = Color3.fromRGB(255, 95, 87)
        end
    end

    unlock.MouseButton1Click:Connect(tryUnlock)
    passwordBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            tryUnlock()
        end
    end)

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if adminUnlocked then
            renderExecutions()
        end
    end)

    refresh.MouseButton1Click:Connect(function()
        renderExecutions()
    end)

    function Window:SetAdminExecutions(entries)
        if type(entries) ~= "table" then
            adminExecutions = {}
        else
            adminExecutions = entries
        end
        if adminUnlocked then
            renderExecutions()
        end
    end

    function Window:GetAdminExecutions()
        return adminExecutions
    end

    function Window:IsAdminUnlocked()
        return adminUnlocked
    end

    function Window:LockAdmin()
        adminUnlocked = false
        dashboard.Visible = false
        gate.Visible = true
        passwordBox.Text = ""
        status.Text = "Locked"
        status.TextColor3 = adminPage.window.theme.textFaint
    end

    function Window:RefreshAdminExecutions()
        renderExecutions()
    end
end


