        local feature = addFeatureTextBox(page, name2, callback, options)
        tab.Features[name2] = feature
        Johnny.Features[name2] = feature
        return feature
    end

    function tab:Show()
        Window:SelectNav(id)
        return self
    end

    self._tabs[name] = tab
    return tab
end

