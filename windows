local function fastRepLoop()

    while fastRepRunning do

        if pingAdjusterEnabled then

            local ping =
                getPing()

            if ping >= pausePing then

                pingPaused = true

                updatePingStatus(
                    "Paused - high ping"
                )

                waitForPingRecovery()

                continue
            end

        else

            pingPaused = false
        end

        if not fastRepRunning then
            break
        end

        local batchStart =
            tick()

        while
            fastRepRunning
            and
            tick() - batchStart < 0.05
        do

            if
                pingAdjusterEnabled
                and
                getPing() >=
                pausePing
            then

                break
            end

            for i = 1, repsPerTick do

                if not fastRepRunning then
                    break
                end

                pcall(function()
                    muscleEvent:FireServer(
                        "rep"
                    )
                end)
            end

            task.wait(0.01)
        end

        task.wait()
    end

    pingPaused = false

    updatePingStatus(
        "Stopped"
    )
end

