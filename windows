-- FAST REBIRTH FORTUNE WHEEL
--========================================================--

local fastRebFortuneWheelRunning = false
local fastRebFortuneWheelLoopId = 0

local fastRebFortuneWheelSwitch = nil

local function spinFastRebFortuneWheelOnce()

    if hasMaxSpinsMessage() then
        return "MAX_SPINS"
    end

    local events =
        ReplicatedStorage:FindFirstChild("rEvents")

    local remote =
        events and events:FindFirstChild("openFortuneWheelRemote")

    local chances =
        ReplicatedStorage:FindFirstChild("fortuneWheelChances")

    local wheel =
        chances and chances:FindFirstChild("Fortune Wheel")

    if not remote or not remote:IsA("RemoteFunction") or not wheel then
        return false
    end

    local ok = pcall(function()
        remote:InvokeServer("openFortuneWheel", wheel)
    end)

    if not ok then
        return false
    end

    task.wait(0.15)

    if hasMaxSpinsMessage() then
        return "MAX_SPINS"
    end

    return true
end

local function setFastRebFortuneWheel(state)
    fastRebFortuneWheelRunning = state
    fastRebFortuneWheelLoopId += 1

    local myLoopId = fastRebFortuneWheelLoopId

    if not state then
        return
    end

    task.spawn(function()

        while
            fastRebFortuneWheelRunning
            and
            myLoopId == fastRebFortuneWheelLoopId
            and
            not _G.JohnnyScriptDestroyed
        do

            local result = spinFastRebFortuneWheelOnce()

            if result == "MAX_SPINS" then
                fastRebFortuneWheelRunning = false

                if fastRebFortuneWheelSwitch then
                    pcall(function()
                        fastRebFortuneWheelSwitch:Set(false)
                    end)
                end

                break
            end

            task.wait(1)
        end
    end)
end

fastRebFortuneWheelSwitch =
    FastRebTab:AddSwitch(
        "Spin Fortune Wheel",
        function(state)
            setFastRebFortuneWheel(state)
        end
    )

