local function getJohnnyGuiRoot()
    local root
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then root = result end
    end
    if not root then
        local ok, result = pcall(function() return game:GetService("CoreGui") end)
        if ok and typeof(result) == "Instance" then root = result end
    end
    if not root then root = Player:WaitForChild("PlayerGui") end
    return root
end

local function findMainJohnnyGui()
    local roots = { getJohnnyGuiRoot() }
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    pcall(function() table.insert(roots, Player:WaitForChild("PlayerGui")) end)
    for _, root in ipairs(roots) do
        if root and typeof(root) == "Instance" then
            local found = root:FindFirstChild("imgui", true)
            if found then return found end
        end
    end
    return nil
end

local function destroyMainUiForCompactMode()
    local imgui = findMainJohnnyGui()
    if imgui then pcall(function() imgui:Destroy() end) end
end

-- Supports common executor local-asset functions. The supplied image should be
-- placed in the executor's workspace as "johnny_custom_icon.png".
local function getJohnnyCustomAsset(fileName)
    local funcs = { getcustomasset, getsynasset }
    for _, fn in ipairs(funcs) do
        if type(fn) == "function" then
            local ok, result = pcall(fn, fileName)
            if ok and type(result) == "string" and result ~= "" then
                return result
            end
        end
    end
    return nil
end

local function destroyCompactMode()
    compactRainbowToken += 1
    compactNightMode = false
    compactThemeGradients = {}
    compactThemeButtons = {}
    compactPanel = nil
    compactOpenButton = nil
    if compactModeGui then
        pcall(function() compactModeGui:Destroy() end)
        compactModeGui = nil
    end
    local root = getJohnnyGuiRoot()
    pcall(function()
        local old = root:FindFirstChild("JohnnyCompactMode")
        if old then old:Destroy() end
    end)
end

