local existingParent = (gethui and gethui()) or game:GetService("CoreGui")
local existing = existingParent:FindFirstChild("AstrarServices_Win11")
if existing then
    existing:Destroy()
end

local Window = UI:CreateWindow({
    Title = "Muscle Legends - V3.2.1 Private",
    Subtitle = "AstrarServices",
    Size = UDim2.fromScale(0.76, 0.82),
    ContentTitle = "Stats",
    ContentSubtitle = "Select a tab to begin building your interface.",
})

local tabs = {
    {"Farming", "Automation and farming."},
    {"Rebirth", "Rebirth tools and settings."},
    {"Pets", "Pet management."},
    {"Player", "Player settings."},
    {"Killing", "Combat tools."},
    {"Stats", "Statistics and session information."},
    {"Tickets", "Tickets and rewards."},
    {"Perf", "Performance settings."},
    {"Misc", "Miscellaneous settings."},
}

local createdTabs = {}

for _, data in ipairs(tabs) do
    createdTabs[data[1]] = Window:AddTab({
        Title = data[1],
        Description = data[2],
        Accent = TabColors[data[1]],
    })
end

-- Match the screenshot's initial page.
Window:SelectTab(createdTabs.Stats)

return UI
