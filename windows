		LayoutOrder = self._rowCount,
	})

	new("TextLabel", {
		Text = opts.label or "",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = COLOR.textDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -46, 1, 0),
		BackgroundTransparency = 1,
	}).Parent = row

