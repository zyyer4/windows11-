local function readPingStat(stat)

    if not stat then
        return nil
    end

    local ok, value =
        pcall(function()
            return stat:GetValue()
        end)

    if ok
        and type(value) == "number"
        and value >= 0
    then

        return value
    end

    local okString, valueString =
        pcall(function()
            return stat:GetValueString()
        end)

    if okString
        and type(valueString) ==
        "string"
    then

        local number =
            tonumber(
                valueString:
                match("([%d%.]+)")
            )

        if number then
            return number
        end
    end

    return nil
end

