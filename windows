local function getFarmPaceNumbers()
    local h,d,w = "0","0","0"
    local ok, value = pcall(function() return projectedStrengthLabel.Text end)
    if ok and type(value) == "string" then
        local a,b,c = value:match("Strength Pace:%s*([^/]+)%/Hour%s*|%s*([^/]+)%/Day%s*|%s*([^/]+)%/Week")
        if a then h=a:gsub("%s+","") end
        if b then d=b:gsub("%s+","") end
        if c then w=c:gsub("%s+","") end
    end
    return h,d,w
end

