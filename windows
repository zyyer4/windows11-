-- A row with a toggle switch instead of a value. Returns (row, setter/getter table).
function Panel:AddToggleRow(opts)
	self._rowCount += 1
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = self._rowCount,
	})

	new("TextLabel", {
		Text = opts.label or "",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = COLOR.textDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -46, 1, 0),
		BackgroundTransparency = 1,
	}).Parent = row

	local track = new("TextButton", {
		Text = "",
		Size = UDim2.fromOffset(38, 22),
		Position = UDim2.new(1, -38, 0.5, -11),
		BackgroundColor3 = opts.on and COLOR.green or Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = opts.on and 0 or 0.85,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, { corner(11) })
	local trackGradient = gradient(lighten(COLOR.green, 0.25), darken(COLOR.green, 0.1), 135)
	trackGradient.Enabled = opts.on == true
	trackGradient.Parent = track

	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = opts.on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, { corner(9) })
	knob.Parent = track

	local state = { on = opts.on == true }
	track.MouseButton1Click:Connect(function()
		state.on = not state.on
		trackGradient.Enabled = state.on
		-- little squash-and-stretch pulse on the knob as it slides
		tween(knob, { Size = UDim2.fromOffset(22, 18) }, 0.08)
		task.delay(0.08, function()
			tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.12, Enum.EasingStyle.Back)
		end)
		tween(knob, { Position = state.on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9) }, 0.2, Enum.EasingStyle.Back)
		tween(track, {
			BackgroundColor3 = state.on and COLOR.green or Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = state.on and 0 or 0.85,
		}, 0.15)
		if opts.onChange then
			opts.onChange(state.on)
		end
	end)

	track.Parent = row
	row.Parent = self.body
	return row, state
end

