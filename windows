    function UI:SetAdminExecutions(entries)
        if type(entries) ~= "table" then
            entries = {}
        end
        adminExecutions = {}
        for _, record in ipairs(entries) do
            if type(record) == "table" then
                table.insert(adminExecutions, record)
            end
        end
        if adminUnlocked then
            renderExecutions()
        end
    end

    function UI:AddAdminExecution(record)
        if type(record) ~= "table" then return end
        table.insert(adminExecutions, 1, record)
        if adminUnlocked then
            renderExecutions()
        end
    end

    local function unlockAdmin()
        if passwordBox.Text == ADMIN_PASSWORD then
            adminUnlocked = true
            status.Text = "Unlocked - loading global executions..."
            status.TextColor3 = Theme.Yellow
            gate.Visible = false
            dashboard.Visible = true
            renderExecutions()

            task.spawn(function()
                local ok, result = UI:FetchGlobalExecutions()
                if ok then
                    status.Text = "Global feed connected - " .. tostring(#result) .. " current execution(s)"
                    status.TextColor3 = Theme.Green
                else
                    status.Text = "Global feed error: " .. tostring(result)
                    status.TextColor3 = Theme.Red
                end
                renderExecutions()
            end)
        else
            status.Text = "Incorrect password"
            status.TextColor3 = Theme.Red
            task.delay(0.8, function()
                if status.Parent then
                    status.Text = "Locked"
                    status.TextColor3 = Theme.Muted
                end
            end)
        end
    end

    unlock.MouseButton1Click:Connect(unlockAdmin)
    passwordBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then unlockAdmin() end
    end)

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if adminUnlocked then renderExecutions() end
    end)

    refresh.MouseButton1Click:Connect(function()
        if adminUnlocked then
            refresh.Text = "..."
            task.spawn(function()
                local ok = false
                if UI.ExecutionLogger.PollEndpoint ~= "" then
                    ok = UI:FetchGlobalExecutions()
                end
                if not ok then
                    renderExecutions()
                end
                refresh.Text = "R"
            end)
        end
    end)
end

-- ============================================================
-- DISCORD EXECUTION LOGGER + GLOBAL CURRENT FEED
-- ============================================================
-- Discord webhook = execution reporting.
-- Tiny Discord bridge = reads the same channel for the Admin tab.
-- No database is used.
--
-- IMPORTANT: replace the two placeholder URLs below with your own values.
-- The Discord webhook is used only to POST the execution embed.
-- The bridge URL is the public URL of the tiny Discord bot's /executions endpoint.

UI.ExecutionLogger = {
    Enabled = false,
    Webhook = "",
    PollEndpoint = "",
    Timeout = 8,
    PollInterval = 8,
    LastError = nil,
    LastResponse = nil,
}

local function findRequestFunction()
    local candidates = {
        rawget(getgenv and getgenv() or _G, "request"),
        rawget(getgenv and getgenv() or _G, "http_request"),
        rawget(getgenv and getgenv() or _G, "http") and rawget(getgenv and getgenv() or _G, "http").request,
        rawget(getgenv and getgenv() or _G, "syn") and rawget(getgenv and getgenv() or _G, "syn").request,
    }
    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            return fn
        end
    end
    return nil
end

local function safeJson(value)
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(value)
    end)
    return ok and encoded or nil
end

local function isoTimestamp()
    return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

local function normaliseRecord(record)
    record = type(record) == "table" and record or {}
    local localPlayer = Players.LocalPlayer

    return {
        Username = record.Username or (localPlayer and localPlayer.Name) or "Unknown",
        DisplayName = record.DisplayName or (localPlayer and localPlayer.DisplayName) or "Unknown",
        UserId = tonumber(record.UserId) or (localPlayer and localPlayer.UserId) or 0,
        Game = record.Game or "Unknown",
        PlaceId = tonumber(record.PlaceId) or game.PlaceId,
        Server = record.Server or record.JobId or game.JobId or "Unknown",
        JobId = record.JobId or game.JobId or "Unknown",
        Executor = record.Executor or "Unknown",
        Version = record.Version or "3.2.2",
        Timestamp = record.Timestamp or isoTimestamp(),
        Stats = type(record.Stats) == "table" and record.Stats or {},
    }
end

function UI:ConfigureExecutionLogger(config)
    config = type(config) == "table" and config or {}
    self.ExecutionLogger.Webhook = tostring(config.Webhook or self.ExecutionLogger.Webhook or "")
    self.ExecutionLogger.PollEndpoint = tostring(config.PollEndpoint or self.ExecutionLogger.PollEndpoint or "")
    self.ExecutionLogger.Enabled = config.Enabled == true
    self.ExecutionLogger.Timeout = tonumber(config.Timeout) or 8
    self.ExecutionLogger.PollInterval = tonumber(config.PollInterval) or 8
    self.ExecutionLogger.LastError = nil
    return self.ExecutionLogger
end

function UI:BuildDiscordEmbed(record)
    record = normaliseRecord(record)

    local statLines = {}
    for key, value in pairs(record.Stats) do
        table.insert(statLines, tostring(key) .. ": " .. tostring(value))
    end
    table.sort(statLines)

    local fields = {
        {
            name = "Player",
            value = string.format("%s (@%s)", tostring(record.DisplayName), tostring(record.Username)),
            inline = true,
        },
        {
            name = "UserId",
            value = tostring(record.UserId),
            inline = true,
        },
        {
            name = "Game",
            value = string.format("%s\nPlaceId: `%s`", tostring(record.Game), tostring(record.PlaceId)),
            inline = true,
        },
        {
            name = "Server / JobId",
            value = "`" .. tostring(record.JobId or record.Server) .. "`",
            inline = false,
        },
        {
            name = "Executor",
            value = tostring(record.Executor),
            inline = true,
        },
    }

    if #statLines > 0 then
        table.insert(fields, {
            name = "Public Stats",
            value = table.concat(statLines, "\n"):sub(1, 1024),
            inline = false,
        })
    end

    return {
        title = "EMPIRE | SCRIPT EXECUTED",
        description = string.format("**%s** executed Empire.", tostring(record.Username)),
        color = 16761930,
        fields = fields,
        footer = {text = "Empire V" .. tostring(record.Version)},
        timestamp = record.Timestamp,
    }
end

function UI:BuildDiscordWebhookPayload(record)
    return {
        username = "Empire Logger",
        embeds = {self:BuildDiscordEmbed(record)},
    }
end

function UI:SendExecutionLog(record)
    local logger = self.ExecutionLogger
    if not logger.Enabled or logger.Webhook == "" then
        return false, "Discord execution logger is disabled or has no webhook."
    end

    local requestFn = findRequestFunction()
    if not requestFn then
        return false, "No executor HTTP request function is available."
    end

    local body = safeJson(self:BuildDiscordWebhookPayload(record))
    if not body then
        return false, "Unable to JSON-encode Discord payload."
    end

    local ok, response = pcall(function()
        return requestFn({
            Url = logger.Webhook,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
            },
            Body = body,
        })
    end)

    if not ok then
        logger.LastError = tostring(response)
        return false, logger.LastError
    end

    logger.LastResponse = response
    logger.LastError = nil
    return true, response
end

function UI:FetchGlobalExecutions()
    local logger = self.ExecutionLogger
    if not logger.Enabled or logger.PollEndpoint == "" then
        return false, "Global current feed is disabled or has no bridge endpoint."
    end

    local requestFn = findRequestFunction()
    if not requestFn then
        return false, "No executor HTTP request function is available."
    end

    local ok, response = pcall(function()
        return requestFn({
            Url = logger.PollEndpoint,
            Method = "GET",
            Headers = { ["Accept"] = "application/json" },
        })
    end)

    if not ok then
        logger.LastError = tostring(response)
        return false, logger.LastError
    end

    local body = type(response) == "table" and (response.Body or response.body or response.ResponseBody or response.responseBody) or response
    if type(body) ~= "string" then
        return false, "Global current feed returned no response body."
    end

    local decodedOk, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if not decodedOk or type(data) ~= "table" then
        logger.LastError = "Global current feed returned invalid JSON: " .. tostring(body):sub(1, 120)
        return false, logger.LastError
    end

    -- Accept Pipedream's direct object response, an array, or common wrappers.
    local entries = data.executions or data.entries or data.records or data.data
    if type(entries) == "string" then
        local nestedOk, nested = pcall(function()
            return HttpService:JSONDecode(entries)
        end)
        if nestedOk then entries = nested end
    end

    if type(entries) ~= "table" or (type(entries) == "table" and next(entries) == nil) then
        entries = data
    end

    local flattened = {}
    if type(entries) == "table" then
        for key, value in pairs(entries) do
            if type(value) == "table" then
                local record = {}
                for field, fieldValue in pairs(value) do
                    record[field] = fieldValue
                end
                if record.JobId == nil and record.Server == nil and type(key) ~= "number" then
                    record.JobId = tostring(key)
                    record.Server = tostring(key)
                end
                table.insert(flattened, record)
            end
        end
    end

    -- If the endpoint returned a normal JSON array, pairs() above preserves its records.
    entries = flattened

    if type(entries) == "table" then
        self:SetAdminExecutions(entries)
        logger.LastError = nil
        return true, entries
    end

    return false, "Global current feed returned no execution records."
end

function UI:StartGlobalExecutionFeed()
    if self._globalFeedRunning then return end
    self._globalFeedRunning = true
    task.spawn(function()
        while self._globalFeedRunning and self.Gui and self.Gui.Parent do
            pcall(function() self:FetchGlobalExecutions() end)
            task.wait(self.ExecutionLogger.PollInterval or 8)
        end
    end)
end

function UI:StopGlobalExecutionFeed()
    self._globalFeedRunning = false
end

function UI:LogExecution(record)
    record = normaliseRecord(record)
    if self.ExecutionLogger.Enabled then
        task.spawn(function()
            self:SendExecutionLog(record)
        end)
    end
    return record
end

