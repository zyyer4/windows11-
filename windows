        local petsFolder,uniquePets=getPackPetsFolder()
        if not petsFolder or not uniquePets or not equipPetEvent then
            return false,"Status: Pet storage/event unavailable"
        end

        -- Fully clear the equipped set before applying the next loadout.
        for _,folder in ipairs(petsFolder:GetChildren()) do
            if folder:IsA("Folder") then
                for _,pet in ipairs(folder:GetChildren()) do
                    pcall(function()
                        equipPetEvent:FireServer("unequipPet",pet)
                    end)
                end
            end
        end

        if state.ClearDelay>0 then
            task.wait(state.ClearDelay)
        end

        local wanted=string.lower(petName)
        local found=0
        for _,pet in ipairs(uniquePets:GetChildren()) do
            if string.lower(pet.Name)==wanted then
                local ok=pcall(function()
                    equipPetEvent:FireServer("equipPet",pet)
                end)
                if ok then found+=1 end
                if state.EquipDelay>0 then
                    task.wait(state.EquipDelay)
                end
            end
        end

        if found==0 then
            return false,"Status: No "..petName.." copies found"
        end
        return true,"Status: Equipped "..tostring(found).." "..petName
    end

    local function stopPackSpam()
        state.PackSpamEnabled=false
        state.LoopToken+=1
        refreshButton()
    end

    local function startPackSpam()
        if state.PackSpamEnabled then return end
        state.PackSpamEnabled=true
        state.LoopToken+=1
        local token=state.LoopToken
        refreshButton()

        task.spawn(function()
            local petName="Mighty Monster"
            while state.PackSpamEnabled
                and state.LoopToken==token
                and not _G.JohnnyScriptDestroyed do
                local ok,resultOk,resultMsg=pcall(function()
                    return equipWholeLoadout(petName)
                end)
                if not ok then
                    resultOk=false
                    resultMsg="Status: Pack swap error"
                end
                if toggle.Parent then
                    status.Text=tostring(resultMsg or (resultOk and "Status: Loadout equipped" or "Status: Pack swap failed"))
                    status.TextColor3=resultOk and COLORS.green or Color3.fromRGB(255,130,130)
                end
                if not (state.PackSpamEnabled and state.LoopToken==token) then break end
                petName=(petName=="Mighty Monster") and "Wild Wizard" or "Mighty Monster"
                if state.Interval>0 then
                    task.wait(state.Interval)
                else
                    -- MAX mode: yield once per cycle so the client stays responsive.
                    task.wait()
                end
            end
        end)
    end

    toggle.Activated:Connect(function()
        if state.PackSpamEnabled then
            stopPackSpam()
        else
            startPackSpam()
        end
    end)

    task.defer(updateCanvas)
end



