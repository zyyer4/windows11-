            table.insert(lines, string.format(
                "%s | %s | UserId: %s\nGame: %s\nServer: %s\nVersion: %s\nStats: %s",
                tostring(record.Username or "Unknown"),
                tostring(record.DisplayName or ""),
                tostring(record.UserId or "-"),
                tostring(record.Game or "Unknown Game"),
                tostring(record.Server or record.JobId or "-"),
                tostring(record.Version or "-"),
                stringifyAdminStats(record.Stats)
            ))
        end
    end
    if count == 0 then
        adminResultsLabel.Text = "0 RECORDS\nNo matching executions."
    else
        adminResultsLabel.Text = tostring(count) .. " RECORD" .. (count == 1 and "" or "S") .. "\n\n" .. table.concat(lines, "\n\n")
    end
end

