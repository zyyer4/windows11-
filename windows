    }

    local function paint()
        local theme = page.window.theme
        track.BackgroundColor3 = state._on and theme.accent or theme.surface
        track.BackgroundTransparency = state._on and 0.08 or 0.82
        knob.BackgroundColor3 = state._on and theme.accentOn or theme.text
        knob.Position = state._on
            and UDim2.new(1, -20, 0.5, -9)
            or UDim2.new(0, 2, 0.5, -9)
    end

    page.window:_themed(function()
        paint()
    end)

    function state:Set(value, fire)
        local wanted = value == true
        if state._on == wanted then
            state.Enabled = wanted
            if fire and callback then
                callback(wanted)
            end
            return
        end

        state._on = wanted
        state.Enabled = wanted
        paint()

        if fire ~= false and callback then
            callback(wanted)
        end
    end

    track.MouseButton1Click:Connect(function()
        state:Set(not state._on, true)
    end)

