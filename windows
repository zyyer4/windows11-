--========================================================--
-- FAST REBIRTH PACE
--========================================================--

local lastRebirthTime = tick()
local lastRebirthValue =
    rebirthsStat.Value

local paceHistoryHour = {}
local paceHistoryDay = {}
local paceHistoryWeek = {}

local maxHistoryLength = 20
local rebirthCount = 0

local function updateRebirthsLabel()

    local gained =
        rebirthsStat.Value -
        initialRebirths

    rebirthStatsLabel.Text =
        string.format(
            "Rebirths: %s | Gained: %s",
            formatRebirthNumber(
                rebirthsStat.Value
            ),
            formatRebirthNumber(gained)
        )
end

local function averageTable(tbl)

    if #tbl == 0 then
        return 0
    end

    local total = 0

    for _, value in ipairs(tbl) do
        total += value
    end

    return total / #tbl
end

local function calculateRebirthPace()

    rebirthCount += 1

    if rebirthCount < 2 then
        lastRebirthTime = tick()
        lastRebirthValue =
            rebirthsStat.Value
        return
    end

    local now = tick()

    local gained =
        rebirthsStat.Value -
        lastRebirthValue

    if gained <= 0 then
        return
    end

    local elapsed =
        now - lastRebirthTime

    if elapsed <= 0 then
        return
    end

    local perSecond =
        gained / elapsed

    local perHour =
        perSecond * 3600

    local perDay =
        perSecond * 86400

    local perWeek =
        perSecond * 604800

    rebirthPaceLabel.Text =
        string.format(
            "Pace: %s / Hour | %s / Day | %s / Week",
            formatRebirthNumber(perHour),
            formatRebirthNumber(perDay),
            formatRebirthNumber(perWeek)
        )

    table.insert(
        paceHistoryHour,
        perHour
    )

    table.insert(
        paceHistoryDay,
        perDay
    )

    table.insert(
        paceHistoryWeek,
        perWeek
    )

    if #paceHistoryHour > maxHistoryLength then
        table.remove(paceHistoryHour, 1)
        table.remove(paceHistoryDay, 1)
        table.remove(paceHistoryWeek, 1)
    end

    rebirthAverageLabel.Text =
        string.format(
            "Average Pace: %s / Hour | %s / Day | %s / Week",
            formatRebirthNumber(
                averageTable(paceHistoryHour)
            ),
            formatRebirthNumber(
                averageTable(paceHistoryDay)
            ),
            formatRebirthNumber(
                averageTable(paceHistoryWeek)
            )
        )

    lastRebirthTime = now
    lastRebirthValue =
        rebirthsStat.Value
end

rebirthsStat:GetPropertyChangedSignal(
    "Value"
):Connect(function()

    calculateRebirthPace()
    updateRebirthsLabel()

end)

