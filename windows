-- ===================== small helpers =====================

local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

local function deepCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = type(v) == "table" and deepCopy(v) or v
	end
	return out
end

local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function lighten(c, amt)
	return c:Lerp(Color3.new(1, 1, 1), amt)
end
local function darken(c, amt)
	return c:Lerp(Color3.new(0, 0, 0), amt)
end
local function gradient(fromColor, toColor, rotation)
	return new("UIGradient", {
		Color = ColorSequence.new(fromColor, toColor),
		Rotation = rotation or 135,
	})
end

local function tween(inst, props, time, style)
	local t = TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad), props)
	t:Play()
	return t
end

-- Makes `frame` draggable by dragging `handle` (e.g. the titlebar).
local function makeDraggable(frame, handle, onEnd)
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if onEnd then
						onEnd(frame.Position)
					end
				end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

-- Enables/disables the real background blur behind the glass window.
local function setWorldBlur(on, size)
	local blur = Lighting:FindFirstChild("GlassUIBlur")
	if on and size > 0 then
		if not blur then
			blur = new("BlurEffect", { Name = "GlassUIBlur", Size = 0 })
			blur.Parent = Lighting
		end
		tween(blur, { Size = size }, 0.25)
	elseif blur then
		local t = tween(blur, { Size = 0 }, 0.2)
		t.Completed:Connect(function(state)
			-- a newer tween (blur switched back on) cancels this one; don't destroy then
			if state == Enum.PlaybackState.Completed then
				blur:Destroy()
			end
		end)
	end
end

-- ===================== save / load storage =====================
-- Storage is two functions:
--   Save(jsonString, configName) -> success:boolean, note?:string
--   Load(configName)             -> jsonString?:string, errorMessage?:string
-- Default: JSON file in the GlassUI folder when file functions exist, else session memory.

local CONFIG_DIR = "GlassUI"
local sessionMemory = {} -- fallback when there is no file access (lives until the game closes)

local function configPath(name)
	return CONFIG_DIR .. "/" .. tostring(name):gsub("[^%w_%-]", "_") .. ".json"
end

GlassUI._storage = {
	Save = function(json, name)
		if writefile then
			if makefolder and isfolder and not isfolder(CONFIG_DIR) then
				pcall(makefolder, CONFIG_DIR)
			end
			local ok, err = pcall(writefile, configPath(name), json)
			if ok then
				return true
			end
			return false, tostring(err)
		end
		sessionMemory[name] = json
		return true, "this session only"
	end,
	Load = function(name)
		if readfile and isfile then
			local path = configPath(name)
			if isfile(path) then
				local ok, data = pcall(readfile, path)
				if ok then
					return data
				end
				return nil, tostring(data)
			end
			return nil
		end
		return sessionMemory[name]
	end,
}

function GlassUI.SetStorage(storage)
	GlassUI._storage = storage
end

-- ===================== theming plumbing =====================

-- Runs fn(theme, animate) now and again every time the theme changes.
function GlassUI:_themed(fn)
	table.insert(self._themeFns, fn)
	fn(self.theme, false)
end

-- Keeps inst[prop] equal to theme[token].
function GlassUI:_bind(inst, prop, token)
	self:_themed(function(theme, animate)
		if animate then
			tween(inst, { [prop] = theme[token] }, 0.25)
		else
			inst[prop] = theme[token]
		end
	end)
end

function GlassUI:_stroke(parent, transparency, thickness)
	local s = new("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = transparency or 0.9,
		Thickness = thickness or 1,
	})
	s.Parent = parent
	self:_bind(s, "Color", "stroke")
	return s
end

-- Controls register a "syncer" that re-reads self.settings and updates themselves.
function GlassUI:_addSyncer(fn)
	table.insert(self._syncers, fn)
	fn()
end

function GlassUI:_syncControls()
	for _, fn in ipairs(self._syncers) do
		fn()
	end
end

function GlassUI:_resolveTheme()
	local base = THEMES[self.settings.theme] or THEMES.Midnight
	local theme = {}
	for k, v in pairs(base) do
		theme[k] = v
	end
	local override = findAccent(self.settings.accent)
	if override then
		theme.accent = override
	end
	local a = theme.accent
	local luminance = 0.299 * a.R + 0.587 * a.G + 0.114 * a.B
	theme.accentOn = luminance > 0.45 and rgb(12, 24, 18) or rgb(255, 255, 255)
	self.theme = theme
end

function GlassUI:_applyTheme(animate)
	self:_resolveTheme()
	for _, fn in ipairs(self._themeFns) do
		fn(self.theme, animate)
	end
	self:_syncControls()
end

-- ===================== settings state =====================

function GlassUI:GetSettings()
	return deepCopy(self.settings)
end

-- Something the user changed: refresh controls, mark unsaved, maybe auto-save.
function GlassUI:_changed()
	if self._applying or self._destroyed then
		return
	end
	self:_syncControls()
	if self.settings.autoSave then
		self:_setStatus("Saving soon...", "dim")
		self:_scheduleSave()
	else
		self:_setStatus("Unsaved changes", "dim")
	end
end

function GlassUI:_setStatus(text, kind)
	self._status = { text = text, kind = kind or "dim" }
	self:_renderStatus()
end

function GlassUI:_renderStatus()
	local label = self._statusLabel
	if not label then
		return
	end
	local st = self._status
	label.Text = st.text
	if st.kind == "ok" then
		label.TextColor3 = self.theme.accent
	elseif st.kind == "err" then
		label.TextColor3 = COLOR.red
	else
		label.TextColor3 = self.theme.textFaint
	end
end

function GlassUI:_scheduleSave()
	self._saveToken = (self._saveToken or 0) + 1
	local token = self._saveToken
	task.delay(1.5, function()
		if token == self._saveToken and not self._destroyed then
			self:SaveSettings()
		end
	end)
end

function GlassUI:_updateKey()
	local ok, keyCode = pcall(function()
		return Enum.KeyCode[self.settings.toggleKey]
	end)
	self._toggleKeyCode = (ok and keyCode) or Enum.KeyCode.RightShift
end

function GlassUI:_applyOpacity()
	if not self._hidden and self.window then
		self.window.BackgroundTransparency = 1 - self.settings.opacity
	end
end

function GlassUI:_maximizedLayout()
	local viewport = workspace.CurrentCamera.ViewportSize
	local s = self.settings.scale
	return UDim2.fromOffset(viewport.X * 0.92 / s, viewport.Y * 0.88 / s), UDim2.fromScale(0.5, 0.5)
end

function GlassUI:_applyScale(animate)
	local s = self.settings.scale
	if animate then
		tween(self._uiScale, { Scale = s }, 0.15)
	else
		self._uiScale.Scale = s
	end
	if self._maximized then
		local size = self:_maximizedLayout()
		tween(self.window, { Size = size }, 0.15)
	end
end

function GlassUI:_updateBlur()
	local on = (not self._hidden) and self.settings.blur
	setWorldBlur(on, self.settings.blurSize)
	self._blurred = on
end

-- Public setters (each one applies visually, then marks settings changed).

function GlassUI:SetTheme(name)
	if not THEMES[name] then
		return
	end
	self.settings.theme = name
	self:_applyTheme(not self._applying)
	self:_changed()
end

function GlassUI:SetAccent(id)
	self.settings.accent = id
	self:_applyTheme(not self._applying)
	self:_changed()
end

function GlassUI:SetOpacity(v)
	self.settings.opacity = clamp(v, 0.2, 1)
	self:_applyOpacity()
	self:_changed()
end

function GlassUI:SetBlur(on)
	self.settings.blur = on == true
	self:_updateBlur()
	self:_changed()
end

function GlassUI:SetBlurSize(n)
	self.settings.blurSize = clamp(n, 0, 40)
	self:_updateBlur()
	self:_changed()
end

function GlassUI:SetScale(s)
	self.settings.scale = clamp(s, 0.7, 1.5)
	self:_applyScale(not self._applying)
	self:_changed()
end

function GlassUI:SetToggleKey(name)
	local ok = pcall(function()
		return Enum.KeyCode[name]
	end)
	if not ok then
		return
	end
	self.settings.toggleKey = name
	self:_updateKey()
	self:_changed()
end

function GlassUI:SetAutoSave(on)
	self.settings.autoSave = on == true
	self:_changed()
end

-- Merge a settings table (e.g. decoded from JSON) into the live settings.
function GlassUI:ApplySettings(data)
	if type(data) ~= "table" then
		return
	end
	self._applying = true
	local s = self.settings

	if type(data.theme) == "string" and THEMES[data.theme] then
		s.theme = data.theme
	end
	if type(data.opacity) == "number" then
		s.opacity = clamp(data.opacity, 0.2, 1)
	end
	if type(data.blur) == "boolean" then
		s.blur = data.blur
	end
	if type(data.blurSize) == "number" then
		s.blurSize = clamp(data.blurSize, 0, 40)
	end
	if type(data.scale) == "number" then
		s.scale = clamp(data.scale, 0.7, 1.5)
	end
	if type(data.accent) == "string" then
		s.accent = data.accent
	end
	if type(data.toggleKey) == "string" then
		local ok = pcall(function()
			return Enum.KeyCode[data.toggleKey]
		end)
		if ok then
			s.toggleKey = data.toggleKey
		end
	end
	if type(data.autoSave) == "boolean" then
		s.autoSave = data.autoSave
	end
	if type(data.toggles) == "table" then
		for k, v in pairs(data.toggles) do
			if type(k) == "string" and type(v) == "boolean" then
				s.toggles[k] = v
			end
		end
	end

	self:_applyTheme(false)
	self:_applyOpacity()
	self:_applyScale(false)
	self:_updateBlur()
	self:_updateKey()
	for key, state in pairs(self._toggleStates) do
		local wanted = s.toggles[key]
		if wanted ~= nil and state.on ~= wanted then
			state:Set(wanted, true) -- fires the row's onChange so your game logic follows
		end
	end

	self._applying = false
	self:_syncControls()
end

-- Back to defaults for the look & behaviour. Your feature toggles are left alone.
function GlassUI:ResetSettings()
	local fresh = deepCopy(DEFAULTS)
	fresh.toggles = nil
	self:ApplySettings(fresh)
	self:_changed()
end

function GlassUI:SaveSettings()
	local storage = GlassUI._storage
	local json = HttpService:JSONEncode(self:GetSettings())
	self:_setStatus("Saving...", "dim")
	local ok, success, err = pcall(storage.Save, json, self._configName)
	if ok and success then
		self:_setStatus(err and ("Saved (" .. tostring(err) .. ")") or "Saved", "ok")
		return true
	end
	local message = ok and tostring(err or "save failed") or tostring(success)
	warn("[GlassUI] save failed: " .. message)
	self:_setStatus("Save failed: " .. message, "err")
	return false, message
end

function GlassUI:LoadSettings()
	local storage = GlassUI._storage
	self:_setStatus("Loading...", "dim")
	local ok, data, err = pcall(storage.Load, self._configName)
	if not ok then
		warn("[GlassUI] load failed: " .. tostring(data))
		self:_setStatus("Load failed", "err")
		return false, tostring(data)
	end
	if data == nil or data == "" then
		if err then
			self:_setStatus("Load failed: " .. tostring(err), "err")
			return false, tostring(err)
		end
		self:_setStatus("No saved settings yet", "dim")
		return false, "no saved settings"
	end
	local okJson, decoded = pcall(function()
		return HttpService:JSONDecode(data)
	end)
	if not okJson or type(decoded) ~= "table" then
		self:_setStatus("Saved data is corrupted", "err")
		return false, "corrupted data"
	end
	self:ApplySettings(decoded)
	self:_setStatus("Loaded", "ok")
	return true
end

-- ===================== window =====================

function GlassUI.new(opts)
	opts = opts or {}
	local self = setmetatable({}, GlassUI)

	self.settings = deepCopy(DEFAULTS)
	self._themeFns = {}
	self._syncers = {}
	self._toggleStates = {}
	self._pages = {}
	self._navItems = {}
	self._conns = {}
	self._navCount = 0
	self._hidden = false
	self._startTime = os.time()
	self._status = { text = "Not saved yet", kind = "dim" }
	self._configName = opts.configName or opts.title or "default"
	self:_resolveTheme()
	self:_updateKey()

	local player = Players.LocalPlayer
	local guiParent = opts.parent or player:WaitForChild("PlayerGui")
	local guiName = "GlassUI_" .. (opts.title or "Window")
	local previous = guiParent:FindFirstChild(guiName)
	if previous then
		previous:Destroy() -- re-running the script replaces the old window instead of stacking
	end

	local baseSize = opts.size or UDim2.fromOffset(720, 480)
	self._baseSize = baseSize
	self._basePos = UDim2.fromScale(0.5, 0.5)

	local screenGui = new("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	-- Anchored at its centre so UI scale and open/close animations stay centred.
	local window = new("Frame", {
		Name = "Window",
		Size = baseSize,
		Position = self._basePos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = self.theme.windowBg,
		BackgroundTransparency = 1 - self.settings.opacity, -- <- the "glass"
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, {
		corner(14),
	})
	self:_bind(window, "BackgroundColor3", "windowBg")
	self:_stroke(window, 0.85, 1)

	local uiScale = new("UIScale", { Scale = self.settings.scale })
	uiScale.Parent = window
	self._uiScale = uiScale

	-- Tint layer: a white frame whose gradient carries the theme colours.
	-- (White base so the gradient shows its exact colours.)
	local tint = new("Frame", {
		Name = "Tint",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLOR.white,
		BorderSizePixel = 0,
		ZIndex = 0,
	}, { corner(14) })
	local tintGradient = new("UIGradient", {
		Rotation = 160,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(1, 0.85),
		}),
	})
	tintGradient.Parent = tint
	tint.Parent = window
	self:_themed(function(theme)
		tintGradient.Color = ColorSequence.new(theme.tintA, theme.tintB)
	end)

	local titlebar = new("Frame", {
		Name = "Titlebar",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 0.94,
		BorderSizePixel = 0,
	})
	self:_bind(titlebar, "BackgroundColor3", "surface")
	self:_stroke(titlebar, 0.93, 1)
	titlebar.Parent = window

	-- traffic light dots: red = close, amber = minimize, green = maximize
	local dotsHolder = new("Frame", {
		Size = UDim2.fromOffset(56, 12),
		Position = UDim2.new(0, 14, 0.5, -6),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
	})
	local dots = {}
	for i, c in ipairs({ COLOR.red, COLOR.amber, COLOR.green }) do
		local dot = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = c,
			BorderSizePixel = 0,
		}, { corner(6), gradient(lighten(c, 0.35), darken(c, 0.1), 135) })
		dot.MouseEnter:Connect(function() tween(dot, { Size = UDim2.fromOffset(14, 14) }, 0.1) end)
		dot.MouseLeave:Connect(function() tween(dot, { Size = UDim2.fromOffset(12, 12) }, 0.1) end)
		dot.Parent = dotsHolder
		dots[i] = dot
	end
	dotsHolder.Parent = titlebar

	local titleLabel = new("TextLabel", {
		Text = opts.title or "Window",
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0, 200, 0, 16),
		Position = UDim2.new(0, 82, 0, 6),
		BackgroundTransparency = 1,
	})
	self:_bind(titleLabel, "TextColor3", "text")
	titleLabel.Parent = titlebar

	if opts.subtitle then
		local subtitleLabel = new("TextLabel", {
			Text = opts.subtitle,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0, 200, 0, 14),
			Position = UDim2.new(0, 82, 0, 20),
			BackgroundTransparency = 1,
		})
		self:_bind(subtitleLabel, "TextColor3", "textFaint")
		subtitleLabel.Parent = titlebar
	end

	makeDraggable(window, titlebar, function(pos)
		if not self._maximized then
			self._basePos = pos
		end
	end)

	local body = new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 1, -40),
		Position = UDim2.new(0, 0, 0, 40),
		BackgroundTransparency = 1,
	})
	body.Parent = window

	-- sidebar
	local sidebar = new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 190, 1, 0),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
	}, {
		new("UIPadding", {
			PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
		}),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	self:_bind(sidebar, "BackgroundColor3", "sidebarBg")
	self:_stroke(sidebar, 0.93, 1)
	sidebar.Parent = body

	screenGui.Destroying:Connect(function()
		self._destroyed = true
		for _, conn in ipairs(self._conns) do
			conn:Disconnect()
		end
	end)

	self.screenGui = screenGui
	self.window = window
	self.sidebar = sidebar
	self._body = body
	self._minimized = false
	self._maximized = false

	window.Parent = screenGui
	screenGui.Parent = guiParent

	self:_updateBlur()

	-- opening "pop in" animation: scales up from the window's centre
	window.Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset * 0.85, baseSize.Y.Scale, baseSize.Y.Offset * 0.85)
	window.BackgroundTransparency = 1
	local openTween = tween(window, { Size = baseSize, BackgroundTransparency = 1 - self.settings.opacity }, 0.35, Enum.EasingStyle.Back)
	openTween.Completed:Connect(function()
		self:_applyOpacity() -- settings may have been loaded while the animation ran
	end)

	-- a small pill shown after closing, to bring the window back
	local reopen = new("TextButton", {
		Name = "Reopen",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(160, 36),
		Position = UDim2.new(0.5, -80, 1, -60),
		BackgroundColor3 = COLOR.white,
		Visible = false,
		BorderSizePixel = 0,
	}, { corner(18) })
	local pillGradient = new("UIGradient", { Rotation = 135 })
	pillGradient.Parent = reopen
	local pillLabel = new("TextLabel", {
		Text = "Reopen " .. (opts.title or "Window"),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	})
	pillLabel.Parent = reopen
	self:_themed(function(theme)
		pillGradient.Color = ColorSequence.new(lighten(theme.accent, 0.15), darken(theme.accent, 0.2))
		pillLabel.TextColor3 = theme.accentOn
	end)
	reopen.Parent = screenGui
	self.reopenButton = reopen

	dots[1].MouseButton1Click:Connect(function() -- red: close
		self:Hide(true)
	end)

	reopen.MouseButton1Click:Connect(function()
		self:Show()
	end)

	dots[2].MouseButton1Click:Connect(function() -- amber: minimize
		self._maximized = false
		self._minimized = not self._minimized
		if self._minimized then
			tween(window, { Size = UDim2.new(0, self._baseSize.X.Offset, 0, 40), Position = self._basePos }, 0.3, Enum.EasingStyle.Back)
			task.delay(0.15, function()
				if self._minimized then
					body.Visible = false
				end
			end)
		else
			body.Visible = true
			tween(window, { Size = self._baseSize }, 0.3, Enum.EasingStyle.Back)
		end
	end)

	dots[3].MouseButton1Click:Connect(function() -- green: maximize / restore
		self._minimized = false
		body.Visible = true
		self._maximized = not self._maximized
		if self._maximized then
			local size, pos = self:_maximizedLayout()
			tween(window, { Size = size, Position = pos }, 0.32, Enum.EasingStyle.Back)
		else
			tween(window, { Size = self._baseSize, Position = self._basePos }, 0.32, Enum.EasingStyle.Back)
		end
	end)

	-- one input listener: key capture for rebinding + the show/hide hotkey
	table.insert(self._conns, UserInputService.InputBegan:Connect(function(input, processed)
		if self._capturing then
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
				self._capturing = false
				if input.KeyCode ~= Enum.KeyCode.Escape then
					self:SetToggleKey(input.KeyCode.Name)
				end
				self:_syncControls()
			end
			return
		end
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self._toggleKeyCode then
			self:Toggle()
		end
	end))

	if opts.autoLoad ~= false then
		task.spawn(function()
			self:LoadSettings()
		end)
	end

	return self
end

function GlassUI:Hide(showPill)
	if self._hidden then
		return
	end
	self._hidden = true
	self._hideToken = (self._hideToken or 0) + 1
	local token = self._hideToken
	local base = self._baseSize
	local t = tween(self.window, {
		Size = UDim2.new(base.X.Scale, 0, base.Y.Scale, 0),
		BackgroundTransparency = 1,
	}, 0.22)
	self:_updateBlur()
	t.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and self._hidden and token == self._hideToken then
			self.window.Visible = false
			if showPill then
				self.reopenButton.Visible = true
			end
		end
	end)
end

function GlassUI:Show()
	if not self._hidden then
		return
	end
	self._hidden = false
	self._hideToken = (self._hideToken or 0) + 1
	self._minimized = false
	self._maximized = false
	self.reopenButton.Visible = false
	self._body.Visible = true

	local base = self._baseSize
	local window = self.window
	window.Visible = true
	window.Position = self._basePos
	window.Size = UDim2.new(base.X.Scale, 0, base.Y.Scale, 0)
	window.BackgroundTransparency = 1
	local t = tween(window, { Size = base, BackgroundTransparency = 1 - self.settings.opacity }, 0.3, Enum.EasingStyle.Back)
	t.Completed:Connect(function()
		self:_applyOpacity()
	end)
	self:_updateBlur()
end

function GlassUI:Toggle()
	if self._hidden then
		self:Show()
	else
		self:Hide(false)
	end
end

-- Puts the window back in the middle of the screen (handy if it got dragged off).
function GlassUI:Recenter()
	self._basePos = UDim2.fromScale(0.5, 0.5)
	if not self._maximized then
		tween(self.window, { Position = self._basePos }, 0.25, Enum.EasingStyle.Back)
	end
end

function GlassUI:Destroy()
	self._destroyed = true
	for _, conn in ipairs(self._conns) do
		conn:Disconnect()
	end
	setWorldBlur(false, 0)
	if self.reopenButton then
		self.reopenButton:Destroy()
	end
	self.screenGui:Destroy()
end

-- ===================== pages =====================

-- Every nav item owns one page (a scrolling area). Add stats/panels to the page.
function GlassUI:AddPage(id)
	if self._pages[id] then
		return self._pages[id]
	end
	local frame = new("ScrollingFrame", {
		Name = "Page_" .. tostring(id),
		Size = UDim2.new(1, -190, 1, 0),
		Position = UDim2.new(0, 190, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Visible = false,
	}, {
		new("UIPadding", {
			PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, 18),
			PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20),
		}),
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	self:_bind(frame, "ScrollBarImageColor3", "textFaint")
	frame.Parent = self._body

	local page = setmetatable({ window = self, id = id, content = frame, _order = 0 }, Page)

	local hint = new("TextLabel", {
		Name = "EmptyHint",
		Text = "Nothing here yet",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = 1000000,
	})
	self:_bind(hint, "TextColor3", "textFaint")
	hint.Parent = frame
	page._hint = hint

	self._pages[id] = page
	return page
end

function GlassUI:GetPage(id)
	return self._pages[id]
end

function GlassUI:_getDefaultPage()
	if not self._defaultPage then
		self._defaultPage = self:AddPage("main")
		self._defaultPage.content.Visible = true
		self.content = self._defaultPage.content
	end
	return self._defaultPage
end

-- Window-level shortcuts: add to the default (first / active) page.
function GlassUI:AddStatGrid()
	return self:_getDefaultPage():AddStatGrid()
end
function GlassUI:AddStat(opts)
	return self:_getDefaultPage():AddStat(opts)
end
function GlassUI:AddPanel(opts)
	return self:_getDefaultPage():AddPanel(opts)
end

function Page:_touch()
	if self._hint then
		self._hint:Destroy()
		self._hint = nil
	end
end

-- ===================== sidebar nav items =====================

-- Returns (button, page). The page is created for you unless you pass `page`.
function GlassUI:AddNavItem(opts)
	self._navCount += 1
	local id = opts.id or opts.label or tostring(self._navCount)
	local iconColor = NAV_ICON_COLOR[opts.color] or COLOR.blue

	local page
	if type(opts.page) == "table" then
		page = opts.page
	else
		page = self:AddPage(opts.page or id)
	end

	local btn = new("TextButton", {
		Text = "",
		Size = UDim2.new(1, 0, 0, 32),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		LayoutOrder = self._navCount,
	}, { corner(7) })
	local activeGradient = gradient(lighten(iconColor, 0.1), self.theme.windowBg, 115)
	activeGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0.92),
	})
	activeGradient.Parent = btn

	local icon = new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(0, 6, 0.5, -11),
		BackgroundColor3 = iconColor,
		BorderSizePixel = 0,
	}, { corner(6), gradient(lighten(iconColor, 0.3), darken(iconColor, 0.12), 135) })
	if opts.icon then
		new("TextLabel", {
			Text = opts.icon,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
		}).Parent = icon
	end
	icon.Parent = btn

	local label = new("TextLabel", {
		Text = opts.label or "Item",
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.new(0, 36, 0, 0),
		BackgroundTransparency = 1,
	})
	label.Parent = btn

	local item = { id = id, button = btn, page = page, active = false, hover = false }

	function item.refresh(animate)
		local theme = self.theme
		local bgColor = item.active and iconColor or theme.surface
		local bgTrans = item.active and 0.85 or (item.hover and 0.95 or 1)
		local textColor = item.active and theme.text or theme.textDim
		activeGradient.Color = ColorSequence.new(lighten(iconColor, 0.1), theme.windowBg)
		activeGradient.Enabled = item.active
		if animate then
			tween(btn, { BackgroundColor3 = bgColor, BackgroundTransparency = bgTrans }, 0.12)
			tween(label, { TextColor3 = textColor }, 0.12)
		else
			btn.BackgroundColor3 = bgColor
			btn.BackgroundTransparency = bgTrans
			label.TextColor3 = textColor
		end
	end
	self:_themed(function(_, animate)
		item.refresh(animate)
	end)

	btn.MouseEnter:Connect(function()
		item.hover = true
		tween(icon, { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 5, 0.5, -12) }, 0.15, Enum.EasingStyle.Back)
		item.refresh(true)
	end)
	btn.MouseLeave:Connect(function()
		item.hover = false
		tween(icon, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0, 6, 0.5, -11) }, 0.15)
		item.refresh(true)
	end)
	btn.MouseButton1Click:Connect(function()
		self:SelectNav(id)
		if opts.onClick then
			opts.onClick()
		end
	end)

	btn.Parent = self.sidebar
	self._navItems[id] = item

	-- the active item's page is where window:AddStat / window:AddPanel go
	if opts.active or not self._defaultPage then
		self._defaultPage = page
		self.content = page.content
	end
	if opts.active or not self._activeNavId then
		self:SelectNav(id)
	end

	return btn, page
end

function GlassUI:SelectNav(id)
	local target = self._navItems[id]
	if not target then
		return
	end
	self._activeNavId = id
	for _, page in pairs(self._pages) do
		page.content.Visible = false
	end
	target.page.content.Visible = true
	for _, item in pairs(self._navItems) do
		item.active = item == target
		item.refresh(true)
	end
end

