function GlassUI:AddNavItem(opts)
	self._navCount += 1
	local iconColor = NAV_ICON_COLOR[opts.color] or COLOR.blue

	local btn = new("TextButton", {
		Text = "",
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = opts.active and iconColor or Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = opts.active and 0.85 or 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		LayoutOrder = self._navCount,
	}, { corner(7) })
	local activeGradient = gradient(lighten(iconColor, 0.1), Color3.fromRGB(18, 18, 20), 115)
	activeGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0.92),
	})
	activeGradient.Enabled = opts.active == true
	activeGradient.Parent = btn

	local icon = new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(0, 6, 0.5, -11),
		BackgroundColor3 = iconColor,
		BorderSizePixel = 0,
	}, { corner(6), gradient(lighten(iconColor, 0.3), darken(iconColor, 0.12), 135) })
	icon.Parent = btn

	new("TextLabel", {
		Text = opts.label or "Item",
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = opts.active and COLOR.text or COLOR.textDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.new(0, 36, 0, 0),
		BackgroundTransparency = 1,
	}).Parent = btn

	btn.MouseEnter:Connect(function()
		tween(icon, { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 5, 0.5, -12) }, 0.15, Enum.EasingStyle.Back)
		if not opts.active then
			tween(btn, { BackgroundTransparency = 0.95 }, 0.12)
		end
	end)
	btn.MouseLeave:Connect(function()
		tween(icon, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0, 6, 0.5, -11) }, 0.15)
		if not opts.active then
			tween(btn, { BackgroundTransparency = 1 }, 0.12)
		end
	end)
	if opts.onClick then
		btn.MouseButton1Click:Connect(opts.onClick)
	end

	btn.Parent = self.sidebar
	return btn
end

