	if not self._statGrid then
		self:AddStatGrid()
	end
	local card = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.95,
		BorderSizePixel = 0,
	}, {
		corner(9),
		stroke(0.93, 1),
		new("UIPadding", {
			PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
		}),
	})

	new("TextLabel", {
		Text = opts.label or "Label",
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = COLOR.textFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
	}).Parent = card

	new("TextLabel", {
		Text = opts.value or "0",
		Font = Enum.Font.GothamBold,
		TextSize = 19,
		TextColor3 = opts.accent and COLOR.green or COLOR.text,
