-- PET MANAGEMENT
--========================================================--
-- IMPORTANT:
-- Titanium Hydra is NEVER unequipped.
--
-- This allows the new 12-slot setup to keep
-- Titanium Hydra equipped while the script manages
-- Swift Samurai / Tribal Overlord.
--========================================================--

local function getUniquePetsFolder()

    local petsFolder =
        Player:FindFirstChild("petsFolder")

    if not petsFolder then
        return nil
    end

    return petsFolder:FindFirstChild("Unique")
end

local function isProtectedPet(pet)

    return pet
        and pet.Name ==
        "Titanium Hydra"
end

local function unequipAllExceptProtected()

    local petsFolder =
        Player:FindFirstChild("petsFolder")

    if not petsFolder then
        return
    end

    for _, folder in ipairs(
        petsFolder:GetChildren()
    ) do

        if folder:IsA("Folder") then

            for _, pet in ipairs(
                folder:GetChildren()
            ) do

                if not isProtectedPet(pet) then

                    pcall(function()
                        equipPetEvent:FireServer(
                            "unequipPet",
                            pet
                        )
                    end)

                end
            end
        end
    end
end

local function equipPetByName(petName)

    local uniquePets =
        getUniquePetsFolder()

    if not uniquePets then
        return
    end

    for _, pet in ipairs(
        uniquePets:GetChildren()
    ) do

        if pet.Name == petName then

            pcall(function()
                equipPetEvent:FireServer(
                    "equipPet",
                    pet
                )
            end)

        end
    end
end

local function managePets(petName)

    -- Titanium Hydra stays equipped.
    unequipAllExceptProtected()

    task.wait(0.05)

    -- Equip the requested pet.
    equipPetByName(petName)

end

