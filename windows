        function()

            if _G.JohnnyScriptDestroyed then
                return
            end

            virtualUser:
                CaptureController()

            virtualUser:
                ClickButton2(
                    Vector2.new()
                )

            antiAfkStatus.Text =
                "Roblox tried kicking you but I didnt let them!"

            task.wait(2)

            if antiAfkStatus then

                antiAfkStatus.Text =
                    "Status : Active"

            end
        end
    )

