function UI:Restore()
    if not self.IsMinimized then return end

    self.IsMinimized = false

    if self.MinimizedButton then
        local pill = self.MinimizedButton
        local pillScale = pill:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
        pillScale.Scale = 1
        pillScale.Parent = pill

        local pillTween = TweenService:Create(
            pillScale,
            TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Scale = 0.82}
        )
        pillTween:Play()
        pillTween.Completed:Wait()
        pill:Destroy()
        self.MinimizedButton = nil
    end

    local root = self.Root
    local rootScale = self.RootScale

    root.Visible = true
    root.ZIndex = 1
    root.Position = UDim2.fromScale(0.5, 0.045)
    rootScale.Scale = 0.085

    local move = TweenService:Create(
        root,
        TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
        {Position = self.SavedPosition or UDim2.fromScale(0.5, 0.5)}
    )
    local expand = TweenService:Create(
        rootScale,
        TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
        {Scale = 1}
    )

    move:Play()
    expand:Play()
end

function UI:ToggleMaximize()
    if self.IsMinimized then
        self:Restore()
    end

    if not self.IsMaximized then
        self.SavedPosition = self.Root.Position
        self.SavedSize = self.Root.Size

        tween(self.Root, 0.20, {
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(0.90, 0.88),
        })

        self.IsMaximized = true
    else
        tween(self.Root, 0.20, {
            Position = self.SavedPosition or UDim2.fromScale(0.5, 0.5),
            Size = self.SavedSize or UDim2.fromScale(0.70, 0.76),
        })

        self.IsMaximized = false
    end
end

