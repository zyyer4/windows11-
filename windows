    if performance then

        table.insert(
            candidates,
            performance:FindFirstChild(
                "Ping"
            )
        )
    end

    for _, stat in ipairs(candidates) do

        local value =
            readPingStat(stat)

        if value then

            lastKnownPing =
                value

            return value
        end
    end

    return lastKnownPing
end

local function updatePingStatus(status)

    local ping =
        getPing()

    pingStatusLabel.Text =
        string.format(
            "Ping: %d ms | Status: %s",
            math.floor(
                ping + 0.5
            ),
            status
        )
end

local function waitForPingRecovery()

    if pauseDuration > 0 then

        local finish =
            tick() +
            pauseDuration

        while
            fastRepRunning
            and
            pingAdjusterEnabled
            and
            tick() < finish
        do

            updatePingStatus(
                "Paused - cooldown"
            )

            task.wait(0.1)
        end
    end

    while
        fastRepRunning
        and
        pingAdjusterEnabled
    do

        local ping =
            getPing()

        if ping < resumePing then
            break
        end

        updatePingStatus(
            "Paused - waiting for recovery"
        )

        task.wait(0.15)
    end

    pingPaused = false

    if fastRepRunning then

        updatePingStatus(
            pingAdjusterEnabled
            and "Running"
            or "Disabled"
        )
    end
end

