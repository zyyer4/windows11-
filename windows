        local parts = {}
        local preferred = {"Strength", "Durability", "Rebirths"}
        local used = {}
        for _, key in ipairs(preferred) do
            if stats[key] ~= nil then
                local value = stats[key]
                if key == "Strength" or key == "Durability" then
                    value = abbreviateNumber(value)
                end
                table.insert(parts, key .. ": " .. tostring(value))
                used[key] = true
            end
        end
        local extra = {}
        for key, value in pairs(stats) do
            if not used[key] then
                table.insert(extra, tostring(key) .. ": " .. tostring(value))
            end
        end
        table.sort(extra)
        for _, line in ipairs(extra) do table.insert(parts, line) end
        return #parts > 0 and table.concat(parts, "  -  ") or "No public stats supplied"
    end

