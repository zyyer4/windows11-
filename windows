	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = COLOR.stroke,
		BackgroundTransparency = 0.93,
		BorderSizePixel = 0,
	}).Parent = row

	row.Parent = self.body
	return row
end

