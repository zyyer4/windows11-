--========================================================--
-- WINDOW CONTROLLER
-- Object-based window state modeled after GlassUI. The live Window Frame
-- is kept on self.window, so the source-compatible `window` table below
-- cannot shadow the actual GUI object.
--========================================================--
local WindowController = {}
WindowController.__index = WindowController

function WindowController.new(opts)
    local self = setmetatable({}, WindowController)
    self.gui = opts.gui
    self.window = opts.window
    self.windowScale = opts.window:FindFirstChildOfClass("UIScale")
    self.pill = opts.pill
    self._normalPosition = UDim2.fromScale(.5,.5)
    self._normalSize = UDim2.new(.86,0,.82,0)
    self._maximizedSize = UDim2.new(.96,0,.92,0)
    self._minimized = false
    self._maximized = false
    self._closed = false
    self._conns = {}
    return self
end

function WindowController:_track(connection)
    table.insert(self._conns,connection)
    return connection
end

function WindowController:SetMaximized(value)
    if self._closed or self._minimized then
        return
    end
    self._maximized = value == true
    self.window.Visible = true
    self.window.Position = self._normalPosition
    local targetSize = self._maximized and self._maximizedSize or self._normalSize
    tween(self.window, TweenInfo.new(.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = targetSize, BackgroundTransparency = .24})
end

function WindowController:ToggleMaximized()
    if self._closed or self._minimized then
        return
    end
    self:SetMaximized(not self._maximized)
end

function WindowController:SetMinimized(value)
    if self._closed then
        return
    end

    local nextState = value == true
    if nextState == self._minimized then
        return
    end

    if nextState then
        self._maximized = false
        self._minimized = true

        tween(self.windowScale, TweenInfo.new(.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Scale = .86})
        local fadeOut = tween(self.window, TweenInfo.new(.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {BackgroundTransparency = 1})
        fadeOut.Completed:Connect(function()
            if self._minimized then
                self.window.Visible = false
                self.windowScale.Scale = 1
                self.window.BackgroundTransparency = .24
            end
        end)

        self.pill.Visible = true
        self.pill.Position = UDim2.new(.5,0,0,-30)
        self.pill.BackgroundTransparency = 1
        self.pill.TextTransparency = 1
        tween(self.pill, TweenInfo.new(.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(.5,0,0,14), BackgroundTransparency = .08, TextTransparency = 0})
        return
    end

    self._minimized = false
    self.window.Visible = true
    self.window.Position = self._normalPosition
    self.window.Size = self._normalSize
    self.windowScale.Scale = .86
    self.window.BackgroundTransparency = 1
    tween(self.windowScale, TweenInfo.new(.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
    tween(self.window, TweenInfo.new(.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = .24})

    tween(self.pill, TweenInfo.new(.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Position = UDim2.new(.5,0,0,-30), BackgroundTransparency = 1, TextTransparency = 1})
    task.delay(.18, function()
        if self._minimized == false then
            self.pill.Visible = false
        end
    end)
end

function WindowController:ToggleMinimized()
    self:SetMinimized(not self._minimized)
end

function WindowController:Close()
    if self._closed then
        return
    end
    self._closed = true
    for _,connection in ipairs(self._conns) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(self._conns)

    if self.window and self.window.Parent then
        tween(self.windowScale, TweenInfo.new(.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Scale = .9})
        tween(self.window, TweenInfo.new(.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {BackgroundTransparency = 1})
    end

    task.delay(.16, function()
        if self.gui and self.gui.Parent then
            self.gui:Destroy()
        end
    end)
end

