        imgui:FindFirstChild(
            "Windows"
        )

    local uiWindow =
        windows
        and
        windows:FindFirstChild(
            "Window"
        )

    if uiWindow then

        uiWindow.Size =
            UDim2.fromOffset(
                900,
                900
            )

        uiWindow.ClipsDescendants =
            true

    end
end)

