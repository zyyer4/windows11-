local function formatStatNumber(v)
    v=tonumber(v) or 0
    local sign=v<0 and "-" or ""
    local n=math.abs(v)
    local suffixes={
        {1e30,"No"},{1e27,"Oc"},{1e24,"Sp"},{1e21,"Sx"},
        {1e18,"Qi"},{1e15,"Qa"},{1e12,"T"},{1e9,"B"},
        {1e6,"M"},{1e3,"K"}
    }
    for _,item in ipairs(suffixes) do
        if n>=item[1] then
            local scaled=n/item[1]
            local text=scaled>=100 and string.format("%.0f",scaled)
                or scaled>=10 and string.format("%.1f",scaled)
                or string.format("%.2f",scaled)
            text=text:gsub("(%..-)0+$","%1"):gsub("%.0+$","")
            return sign..text..item[2]
        end
    end
    return sign..tostring(math.floor(n))
end
